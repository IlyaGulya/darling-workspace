{
  "schema_version": 1,
  "kind": "lifecycle-state-model",
  "stable_states": ["UNINITIALIZED", "READY", "RUNNING", "DRAINING", "STOPPED", "CORRUPT"],
  "journal_phases": ["NONE", "PREPARE", "PUBLISH", "CLEANUP", "COMMIT", "ABORT"],
  "intent_kinds": ["NONE", "CREATE_PREFIX", "START_SESSION", "REQUEST_SHUTDOWN", "RELEASE_SESSION", "RECREATE_PREFIX", "RECOVER"],
  "decision_kinds": ["ACQUIRE_CAPABILITY", "DECLARE_INTENT", "ENTER_BARRIER", "SNAPSHOT_MEMBERS", "REVALIDATE_IDENTITY", "SIGNAL_MEMBER", "REMOVE_ENDPOINT", "INJECT_FAULT", "RECOVER", "TERMINATE"],
  "capability_kinds": ["PREFIX_DIRECTORY", "SESSION_ROOT_PIDFD", "SESSION_MEMBER_PIDFD", "SHARED_SESSION_LEASE", "RUNTIME_ENDPOINT", "JOURNAL_RECORD"],
  "budgets": {"max_events": 128, "max_virtual_time_ns": 1000000, "max_live_capabilities": 64, "max_recovery_steps": 16},
  "recovery_targets": [
    {"action": "INITIALIZE", "stable_state": "READY", "journal_phase": "COMMIT", "intent": "CREATE_PREFIX"},
    {"action": "NOOP", "stable_state": "READY", "journal_phase": "NONE", "intent": "NONE"},
    {"action": "ROLLBACK_UNINITIALIZED", "stable_state": "UNINITIALIZED", "journal_phase": "ABORT", "intent": "RECOVER"},
    {"action": "ROLLBACK_READY", "stable_state": "READY", "journal_phase": "ABORT", "intent": "RECOVER"},
    {"action": "ROLLBACK_RUNNING", "stable_state": "RUNNING", "journal_phase": "ABORT", "intent": "RECOVER"},
    {"action": "ROLLBACK_STOPPED", "stable_state": "STOPPED", "journal_phase": "ABORT", "intent": "RECOVER"},
    {"action": "COMPLETE_PUBLISH", "stable_state": "READY", "journal_phase": "COMMIT", "intent": "CREATE_PREFIX"},
    {"action": "COMPLETE_CLEANUP", "stable_state": "STOPPED", "journal_phase": "COMMIT", "intent": "RELEASE_SESSION"},
    {"action": "DRAIN_TO_READY", "stable_state": "READY", "journal_phase": "COMMIT", "intent": "RELEASE_SESSION"},
    {"action": "CONTINUE_DRAIN", "stable_state": "DRAINING", "journal_phase": "CLEANUP", "intent": "REQUEST_SHUTDOWN"},
    {"action": "FAIL_CLOSED", "stable_state": "CORRUPT", "journal_phase": "ABORT", "intent": "RECOVER"},
    {"action": "QUARANTINE", "stable_state": "CORRUPT", "journal_phase": "ABORT", "intent": "RECOVER"}
  ],
  "recovery_matrix": [
    {"stable_state": "UNINITIALIZED", "journal_phase": "NONE", "action": "INITIALIZE"},
    {"stable_state": "UNINITIALIZED", "journal_phase": "PREPARE", "action": "ROLLBACK_UNINITIALIZED"},
    {"stable_state": "UNINITIALIZED", "journal_phase": "PUBLISH", "action": "ROLLBACK_UNINITIALIZED"},
    {"stable_state": "UNINITIALIZED", "journal_phase": "CLEANUP", "action": "ROLLBACK_UNINITIALIZED"},
    {"stable_state": "UNINITIALIZED", "journal_phase": "COMMIT", "action": "FAIL_CLOSED"},
    {"stable_state": "UNINITIALIZED", "journal_phase": "ABORT", "action": "ROLLBACK_UNINITIALIZED"},
    {"stable_state": "READY", "journal_phase": "NONE", "action": "NOOP"},
    {"stable_state": "READY", "journal_phase": "PREPARE", "action": "ROLLBACK_READY"},
    {"stable_state": "READY", "journal_phase": "PUBLISH", "action": "COMPLETE_PUBLISH"},
    {"stable_state": "READY", "journal_phase": "CLEANUP", "action": "COMPLETE_CLEANUP"},
    {"stable_state": "READY", "journal_phase": "COMMIT", "action": "NOOP"},
    {"stable_state": "READY", "journal_phase": "ABORT", "action": "ROLLBACK_READY"},
    {"stable_state": "RUNNING", "journal_phase": "NONE", "action": "NOOP"},
    {"stable_state": "RUNNING", "journal_phase": "PREPARE", "action": "ROLLBACK_RUNNING"},
    {"stable_state": "RUNNING", "journal_phase": "PUBLISH", "action": "COMPLETE_PUBLISH"},
    {"stable_state": "RUNNING", "journal_phase": "CLEANUP", "action": "DRAIN_TO_READY"},
    {"stable_state": "RUNNING", "journal_phase": "COMMIT", "action": "NOOP"},
    {"stable_state": "RUNNING", "journal_phase": "ABORT", "action": "ROLLBACK_RUNNING"},
    {"stable_state": "DRAINING", "journal_phase": "NONE", "action": "CONTINUE_DRAIN"},
    {"stable_state": "DRAINING", "journal_phase": "PREPARE", "action": "ROLLBACK_RUNNING"},
    {"stable_state": "DRAINING", "journal_phase": "PUBLISH", "action": "COMPLETE_PUBLISH"},
    {"stable_state": "DRAINING", "journal_phase": "CLEANUP", "action": "CONTINUE_DRAIN"},
    {"stable_state": "DRAINING", "journal_phase": "COMMIT", "action": "DRAIN_TO_READY"},
    {"stable_state": "DRAINING", "journal_phase": "ABORT", "action": "ROLLBACK_RUNNING"},
    {"stable_state": "STOPPED", "journal_phase": "NONE", "action": "NOOP"},
    {"stable_state": "STOPPED", "journal_phase": "PREPARE", "action": "ROLLBACK_STOPPED"},
    {"stable_state": "STOPPED", "journal_phase": "PUBLISH", "action": "COMPLETE_PUBLISH"},
    {"stable_state": "STOPPED", "journal_phase": "CLEANUP", "action": "COMPLETE_CLEANUP"},
    {"stable_state": "STOPPED", "journal_phase": "COMMIT", "action": "NOOP"},
    {"stable_state": "STOPPED", "journal_phase": "ABORT", "action": "ROLLBACK_STOPPED"},
    {"stable_state": "CORRUPT", "journal_phase": "NONE", "action": "FAIL_CLOSED"},
    {"stable_state": "CORRUPT", "journal_phase": "PREPARE", "action": "FAIL_CLOSED"},
    {"stable_state": "CORRUPT", "journal_phase": "PUBLISH", "action": "FAIL_CLOSED"},
    {"stable_state": "CORRUPT", "journal_phase": "CLEANUP", "action": "FAIL_CLOSED"},
    {"stable_state": "CORRUPT", "journal_phase": "COMMIT", "action": "FAIL_CLOSED"},
    {"stable_state": "CORRUPT", "journal_phase": "ABORT", "action": "QUARANTINE"}
  ],
  "invariants": [
    "no-raw-path-authority",
    "no-unvalidated-fd",
    "stable-journal-independent",
    "total-recovery-matrix",
    "identity-before-signal",
    "no-children-after-gone",
    "shared-lease-bound",
    "pidfd-identity-before-signal",
    "late-fork-closes-snapshot",
    "bounded-replay",
    "terminal-trace"
  ]
}
