{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darling.dev/schemas/lifecycle-replay-trace-v1.schema.json",
  "title": "Darling lifecycle replay trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "model_version", "trace_id", "scenario", "provenance", "budget", "initial", "events", "expected", "recovery_observations"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "lifecycle-replay-trace"},
    "model_version": {"const": 1},
    "trace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "scenario": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "budget": {"$ref": "#/$defs/budget"},
    "initial": {"$ref": "#/$defs/initial"},
    "events": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/event"}},
    "expected": {"$ref": "#/$defs/expected"},
    "recovery_observations": {"type": "array", "minItems": 0, "items": {"$ref": "#/$defs/recovery_observation"}}
  },
  "$defs": {
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_label", "evidence_id", "source_identity"],
      "properties": {
        "kind": {"enum": ["historical-observation", "golden-scenario"]},
        "source_label": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "pattern": "^[a-z0-9./_-]+$"},
        "source_identity": {"$ref": "#/$defs/source_identity"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "historical-observation"}}}, "then": {"required": ["artifact_sha256"]}},
        {"if": {"properties": {"kind": {"const": "golden-scenario"}}}, "then": {"not": {"required": ["artifact_sha256"]}}}
      ]
    },
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree", "profile", "module"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "module": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_events", "max_virtual_time_ns", "max_live_capabilities", "max_recovery_steps"],
      "properties": {
        "max_events": {"type": "integer", "minimum": 1},
        "max_virtual_time_ns": {"type": "integer", "minimum": 1},
        "max_live_capabilities": {"type": "integer", "minimum": 1},
        "max_recovery_steps": {"type": "integer", "minimum": 1}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["stable_state", "journal_phase", "intent"],
      "properties": {
        "stable_state": {"enum": ["UNINITIALIZED", "READY", "RUNNING", "DRAINING", "STOPPED", "CORRUPT"]},
        "journal_phase": {"enum": ["NONE", "PREPARE", "PUBLISH", "CLEANUP", "COMMIT", "ABORT"]},
        "intent": {"enum": ["NONE", "CREATE_PREFIX", "START_SESSION", "REQUEST_SHUTDOWN", "RELEASE_SESSION", "RECREATE_PREFIX", "RECOVER"]}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["token", "generation"],
      "properties": {"token": {"type": "string", "pattern": "^[a-z0-9@._-]+$"}, "generation": {"type": "integer", "minimum": 1}}
    },
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["capability_id", "kind", "identity"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"},
        "kind": {"enum": ["PREFIX_DIRECTORY", "SESSION_ROOT_PIDFD", "SESSION_MEMBER_PIDFD", "SHARED_SESSION_LEASE", "RUNTIME_ENDPOINT", "JOURNAL_RECORD"]},
        "identity": {"$ref": "#/$defs/identity"}
      }
    },
    "ownership": {
      "type": "object", "additionalProperties": false, "required": ["capability", "owner"],
      "properties": {
        "capability": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"},
        "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
      }
    },
    "initial": {
      "type": "object", "additionalProperties": false, "required": ["snapshot", "capability_catalog", "live_capabilities"],
      "properties": {
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "capability_catalog": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
        "live_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ownership"}}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "time_ns", "actor", "kind", "data", "state_after"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0}, "time_ns": {"type": "integer", "minimum": 0},
        "actor": {"enum": ["launcher", "controller", "launchd", "member", "observer", "recovery"]},
        "kind": {"enum": ["capability_acquired", "capability_moved", "capability_released", "intent_declared", "barrier_entered", "membership_snapshot", "identity_revalidated", "signal_sent", "endpoint_transition", "member_observed", "fault_injected", "recovery", "terminal"]},
        "data": {"type": "object"}, "state_after": {"$ref": "#/$defs/snapshot"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "capability_acquired"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/capability_acquired"}}}},
        {"if": {"properties": {"kind": {"const": "capability_moved"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/capability_moved"}}}},
        {"if": {"properties": {"kind": {"const": "capability_released"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/capability_released"}}}},
        {"if": {"properties": {"kind": {"const": "intent_declared"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/intent_declared"}}}},
        {"if": {"properties": {"kind": {"const": "barrier_entered"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/barrier_entered"}}}},
        {"if": {"properties": {"kind": {"const": "membership_snapshot"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/membership_snapshot"}}}},
        {"if": {"properties": {"kind": {"const": "identity_revalidated"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/identity_revalidated"}}}},
        {"if": {"properties": {"kind": {"const": "signal_sent"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/signal_sent"}}}},
        {"if": {"properties": {"kind": {"const": "endpoint_transition"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/endpoint_transition"}}}},
        {"if": {"properties": {"kind": {"const": "member_observed"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/member_observed"}}}},
        {"if": {"properties": {"kind": {"const": "fault_injected"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/fault_injected"}}}},
        {"if": {"properties": {"kind": {"const": "recovery"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/recovery"}}}},
        {"if": {"properties": {"kind": {"const": "terminal"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/terminal"}}}}
      ]
    },
    "capability_acquired": {"type": "object", "additionalProperties": false, "required": ["capability", "owner"], "properties": {"capability": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"}, "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}}},
    "capability_moved": {"type": "object", "additionalProperties": false, "required": ["capability", "from", "to"], "properties": {"capability": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"}, "from": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "to": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}}},
    "capability_released": {"type": "object", "additionalProperties": false, "required": ["capability", "owner", "reason"], "properties": {"capability": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"}, "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "reason": {"type": "string", "pattern": "^[a-z0-9._-]+$"}}},
    "intent_declared": {"type": "object", "additionalProperties": false, "required": ["intent", "transaction_id"], "properties": {"intent": {"enum": ["CREATE_PREFIX", "START_SESSION", "REQUEST_SHUTDOWN", "RELEASE_SESSION", "RECREATE_PREFIX", "RECOVER"]}, "transaction_id": {"type": "string", "pattern": "^txn\\.[a-z0-9._-]+$"}}},
    "barrier_entered": {"type": "object", "additionalProperties": false, "required": ["barrier", "result"], "properties": {"barrier": {"enum": ["THREADS_STOPPED", "SESSION_QUIESCED", "MEMBERSHIP_SNAPSHOT"]}, "result": {"enum": ["ENTERED", "GONE", "TIMEOUT", "REJECTED"]}}},
    "membership_snapshot": {"type": "object", "additionalProperties": false, "required": ["authority", "members", "completeness"], "properties": {"authority": {"enum": ["SESSION_LEDGER", "DELEGATED_CGROUP", "PROC_TASK_CHILDREN"]}, "members": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"}}, "completeness": {"enum": ["COMPLETE", "CLOSED", "ABORTED_GONE", "OVERFLOW", "TIMEOUT"]}}},
    "identity_revalidated": {"type": "object", "additionalProperties": false, "required": ["capability", "result"], "properties": {"capability": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"}, "result": {"enum": ["MATCH", "MISMATCH", "GONE"]}}},
    "signal_sent": {"type": "object", "additionalProperties": false, "required": ["capability", "signal", "result"], "properties": {"capability": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"}, "signal": {"enum": ["TERM", "KILL", "STOP", "CONT"]}, "result": {"enum": ["SENT", "GONE", "REJECTED", "DEADLINE"]}}},
    "endpoint_transition": {"type": "object", "additionalProperties": false, "required": ["endpoint", "operation", "result"], "properties": {"endpoint": {"type": "string", "pattern": "^endpoint\\.[a-z0-9._-]+$"}, "operation": {"enum": ["CLOSE", "UNLINK", "REVALIDATE"]}, "result": {"enum": ["REMOVED", "ALREADY_GONE", "MISMATCH", "REJECTED"]}}},
    "member_observed": {"type": "object", "additionalProperties": false, "required": ["capability", "origin"], "properties": {"capability": {"type": "string", "pattern": "^cap\\.[a-z0-9._-]+$"}, "origin": {"enum": ["STARTUP_LEDGER", "SNAPSHOT", "LATE_FORK", "REPLACEMENT"]}}},
    "fault_injected": {"type": "object", "additionalProperties": false, "required": ["phase", "fault"], "properties": {"phase": {"enum": ["PREPARE", "PUBLISH", "CLEANUP", "COMMIT", "BARRIER", "SIGNAL"]}, "fault": {"enum": ["SIGINT", "TIMEOUT", "ROOT_EXIT", "PID_REUSE", "LATE_FORK", "LEASE_HOLDER", "CLOSE_RANGE"]}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["action", "reason"], "properties": {"action": {"enum": ["INITIALIZE", "NOOP", "ROLLBACK_UNINITIALIZED", "ROLLBACK_READY", "ROLLBACK_RUNNING", "ROLLBACK_STOPPED", "COMPLETE_PUBLISH", "COMPLETE_CLEANUP", "DRAIN_TO_READY", "CONTINUE_DRAIN", "FAIL_CLOSED", "QUARANTINE"]}, "reason": {"type": "string", "pattern": "^[a-z0-9._-]+$"}}},
    "terminal": {"type": "object", "additionalProperties": false, "required": ["outcome"], "properties": {"outcome": {"enum": ["SUCCESS", "FAIL_CLOSED", "TIMEOUT", "RECOVERED"]}}},
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "stable_state", "journal_phase", "intent", "terminal_event_kind", "invariants", "live_capabilities"],
      "properties": {
        "outcome": {"enum": ["SUCCESS", "FAIL_CLOSED", "TIMEOUT", "RECOVERED"]}, "stable_state": {"enum": ["UNINITIALIZED", "READY", "RUNNING", "DRAINING", "STOPPED", "CORRUPT"]}, "journal_phase": {"enum": ["NONE", "PREPARE", "PUBLISH", "CLEANUP", "COMMIT", "ABORT"]}, "intent": {"enum": ["NONE", "CREATE_PREFIX", "START_SESSION", "REQUEST_SHUTDOWN", "RELEASE_SESSION", "RECREATE_PREFIX", "RECOVER"]}, "terminal_event_kind": {"const": "terminal"}, "invariants": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}, "live_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ownership"}}
      }
    },
    "recovery_observation": {"type": "object", "additionalProperties": false, "required": ["stable_state", "journal_phase", "action"], "properties": {"stable_state": {"enum": ["UNINITIALIZED", "READY", "RUNNING", "DRAINING", "STOPPED", "CORRUPT"]}, "journal_phase": {"enum": ["NONE", "PREPARE", "PUBLISH", "CLEANUP", "COMMIT", "ABORT"]}, "action": {"enum": ["INITIALIZE", "NOOP", "ROLLBACK_UNINITIALIZED", "ROLLBACK_READY", "ROLLBACK_RUNNING", "ROLLBACK_STOPPED", "COMPLETE_PUBLISH", "COMPLETE_CLEANUP", "DRAIN_TO_READY", "CONTINUE_DRAIN", "FAIL_CLOSED", "QUARANTINE"]}}}
  }
}
