{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darling.dev/schemas/rootless-lifecycle-controller-response-v1.schema.json",
  "title": "Rust Rootless lifecycle controller response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transaction_id", "controller_closure_sha256", "runtime_identity_digest", "request_nonce", "verdict", "obligations", "signals", "journal"],
  "properties": {
    "schema_version": {"const": 1},
    "transaction_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "controller_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["SUCCESS", "FAIL_CLOSED", "UNSUPPORTED"]},
    "obligations": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["MARKER_IDENTITY", "MEMBERSHIP_CHANGED", "LATE_FORK", "PID_REUSE", "ENDPOINT_REPLACEMENT", "LAUNCHER_IDENTITY", "SIGNAL_EVIDENCE", "QUIESCENCE_REQUIRED", "BUDGET_EXCEEDED", "CONTROLLER_INTERRUPTED"]}},
    "signals": {"type": "array", "maxItems": 65, "items": {"$ref": "#/$defs/signal"}},
    "journal": {"type": "array", "minItems": 2, "maxItems": 128, "items": {"$ref": "#/$defs/journal"}}
  },
  "oneOf": [
    {"properties": {"verdict": {"const": "SUCCESS"}, "obligations": {"const": []}, "journal": {"minItems": 8, "maxItems": 8, "prefixItems": [{"required": ["kind"], "properties": {"kind": {"const": "PREPARED"}}}, {"required": ["kind"], "properties": {"kind": {"const": "CAPABILITIES_ACQUIRED"}}}, {"required": ["kind"], "properties": {"kind": {"const": "MEMBERSHIP_BOUND"}}}, {"required": ["kind"], "properties": {"kind": {"const": "SHUTDOWN_REQUESTED"}}}, {"required": ["kind"], "properties": {"kind": {"const": "DRAINED"}}}, {"required": ["kind"], "properties": {"kind": {"const": "QUIESCENT"}}}, {"required": ["kind"], "properties": {"kind": {"const": "CLEANED"}}}, {"required": ["kind", "verdict"], "properties": {"kind": {"const": "FINALIZED"}, "verdict": {"const": "SUCCESS"}}}], "items": false}}, "required": ["verdict", "obligations", "journal"], "not": {"properties": {"journal": {"contains": {"required": ["kind"], "properties": {"kind": {"const": "RECOVERY"}}}}}}},
    {"properties": {"verdict": {"const": "FAIL_CLOSED"}, "obligations": {"minItems": 1}, "journal": {"allOf": [{"contains": {"required": ["kind"], "properties": {"kind": {"const": "RECOVERY"}}}}, {"contains": {"required": ["kind", "verdict"], "properties": {"kind": {"const": "FINALIZED"}, "verdict": {"const": "FAIL_CLOSED"}}}}]}}, "required": ["verdict", "obligations", "journal"]},
    {"properties": {"verdict": {"const": "UNSUPPORTED"}, "obligations": {"minItems": 1}, "journal": {"contains": {"required": ["kind", "verdict"], "properties": {"kind": {"const": "FINALIZED"}, "verdict": {"const": "UNSUPPORTED"}}}}}, "required": ["verdict", "obligations", "journal"]}
  ],
  "$defs": {
    "signal": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "target", "signal", "result"], "properties": {"kind": {"const": "RUST_PIDFD"}, "target": {"enum": ["SESSION_ROOT", "SESSION_MEMBER"]}, "signal": {"const": "KILL"}, "result": {"enum": ["SENT", "GONE", "REJECTED", "DEADLINE"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "target", "signal", "result", "protocol", "proof_digest"], "properties": {"kind": {"const": "PRODUCT_PROTOCOL"}, "target": {"enum": ["SESSION_ROOT", "SESSION_MEMBER"]}, "signal": {"const": "KILL"}, "result": {"enum": ["SENT", "GONE", "REJECTED", "DEADLINE"]}, "protocol": {"const": "DARLING_SHUTDOWN_V1"}, "proof_digest": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"type": "integer", "minimum": 0, "maximum": 255}}}}
      ]
    },
    "journal": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "PREPARED"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "CAPABILITIES_ACQUIRED"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "member_count"], "properties": {"kind": {"const": "MEMBERSHIP_BOUND"}, "member_count": {"type": "integer", "minimum": 0, "maximum": 64}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "signals"], "properties": {"kind": {"const": "SHUTDOWN_REQUESTED"}, "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "DRAINED"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "QUIESCENT"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "endpoint_count"], "properties": {"kind": {"const": "CLEANED"}, "endpoint_count": {"type": "integer", "minimum": 0, "maximum": 16}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "verdict"], "properties": {"kind": {"const": "FINALIZED"}, "verdict": {"enum": ["SUCCESS", "FAIL_CLOSED", "UNSUPPORTED"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "obligation", "completed"], "properties": {"kind": {"const": "RECOVERY"}, "obligation": {"enum": ["MARKER_IDENTITY", "MEMBERSHIP_CHANGED", "LATE_FORK", "PID_REUSE", "ENDPOINT_REPLACEMENT", "LAUNCHER_IDENTITY", "SIGNAL_EVIDENCE", "QUIESCENCE_REQUIRED", "BUDGET_EXCEEDED", "CONTROLLER_INTERRUPTED"]}, "completed": {"type": "integer", "minimum": 0, "maximum": 65}}}
      ]
    }
  }
}
