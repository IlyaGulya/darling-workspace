#!/bin/sh
# dwdiag -- the ONE entry point for the workspace diagnostics that used to be four separate scripts.
#
# It is a build-and-exec shim, not an implementation: the tool itself is the Rust crate in the sibling
# `darling-debug-runner` repository, whose `diag` subcommands own the verdict rule, the symbolization, the crash
# resolution and the suite table. Keeping the shim means a stable path for callers and for muscle memory, while the
# behaviour (and its tests) live in one place with the runner's own machinery.
#
# Usage: dwdiag <symbolize|crash|verdict|suite> [OPTIONS]
#        dwdiag --help
set -eu

# The tool is VENDORED into this workspace so that its source, its README and the instructions that call it live in one
# tree. The sibling repository it came from stays as a fallback for a checkout that predates the move; which one answered
# is printed, because "the tool ran" and "the tool you documented ran" are not the same claim.
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VENDORED="$(dirname "$SELF_DIR")/tools/darling-debug-runner"
LEGACY=${DWDIAG_TOOL_REPO:-/home/ilyagulya/work/darling-debug-runner}
if [ -d "$VENDORED/src" ]; then TOOL_REPO="$VENDORED"; elif [ -d "$LEGACY/src" ]; then TOOL_REPO="$LEGACY"; else
	echo "dwdiag: no tool source found (looked in $VENDORED and $LEGACY)" >&2; exit 3; fi
BIN="$TOOL_REPO/target/release/darling-debug-runner"

if [ ! -x "$BIN" ]; then
	echo "dwdiag: building $BIN (first use or after a clean)" >&2
	( cd "$TOOL_REPO" && cargo build --release >&2 )
fi
[ -x "$BIN" ] || { echo "dwdiag: cannot build $BIN" >&2; exit 3; }

case "${1:-}" in
	--build-only) exit 0 ;;
esac
exec "$BIN" diag "$@"
