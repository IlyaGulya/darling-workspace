#!/bin/sh
# dwdiag -- the ONE entry point for the workspace diagnostics that used to be four separate scripts.
#
# This build-and-exec shim runs the reviewed vendored Rust source, whose `diag`
# subcommands own verdicts, symbolization and crash analysis. The standalone
# repository owns the source; this workspace records its revision and vendors it
# so the executable and its callers cannot silently select an older checkout.
#
# Usage: dwdiag <symbolize|crash|verdict|suite|progress|courier|witness|prefix|core|identity|build|cycle|mappings|env|attach-less capture> [OPTIONS]
#        dwdiag <run|capture|darling> [OPTIONS]   # spawn-and-capture modes of the same tool, passed through
#        dwdiag --help
set -eu

# Resolve only the source shipped by this workspace; do not revive retired copies.
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
TOOL_REPO="$(dirname "$SELF_DIR")/tools/darling-debug-runner"
if [ ! -d "$TOOL_REPO/src" ]; then
	echo "dwdiag: vendored tool source is missing: $TOOL_REPO" >&2
	exit 3
fi
BIN="$TOOL_REPO/target/release/darling-debug-runner"

# REBUILD when the SOURCE is newer than the binary. MEASURED (2026-09-27): the shim only built a missing binary, so
# after a source change it kept answering from the stale one -- a new `--repeat` flag was absent from `--help` while
# the same command worked from the sibling repository, i.e. "the tool ran" was a different tool than the edited one.
# A stale oracle is the defect class this whole diagnostic set exists to make impossible, so the check is the
# boring mtime one, not a version constant.
needs_build=0
[ -x "$BIN" ] || needs_build=1
if [ "$needs_build" -eq 0 ]; then
	if [ -n "$(find "$TOOL_REPO/src" "$TOOL_REPO/Cargo.toml" "$TOOL_REPO/Cargo.lock" -newer "$BIN" -print -quit 2>/dev/null)" ]; then
		needs_build=1
	fi
fi
if [ "$needs_build" -ne 0 ]; then
	echo "dwdiag: building $BIN (missing or stale relative to $TOOL_REPO)" >&2
	( cd "$TOOL_REPO" && cargo build --release >&2 )
fi
[ -x "$BIN" ] || { echo "dwdiag: cannot build $BIN" >&2; exit 3; }
# Say WHICH copy answered: "the tool ran" and "the tool you edited ran" are not the same claim.
echo "dwdiag: tool=$TOOL_REPO binary=$BIN" >&2

# The `diag` subcommands are the diagnostics; the tool ALSO has top-level `run`, `capture` and `darling` modes,
# which spawn a command and collect a gdb/strace bundle around it. MEASURED (2026-09-29): the shim used to force
# `diag` in front of every argument, so those modes were unreachable through the documented entry point -- and a
# session then hand-rolled five shell scripts around `gdb`, `nsenter` and `/proc` polling to attach to a guest
# process, one of which attached to the wrong process entirely. A facility that exists but cannot be reached from
# the documented path is friction, not a missing tool.
top_command() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--runtime-root) shift; [ "$#" -gt 0 ] || return 0; shift ;;
			--runtime-root=*) shift ;;
			*) printf '%s\n' "$1"; return 0 ;;
		esac
	done
}
case "$(top_command "$@")" in
	--build-only) exit 0 ;;
	run|capture|darling|help) exec "$BIN" "$@" ;;
esac
exec "$BIN" diag "$@"
