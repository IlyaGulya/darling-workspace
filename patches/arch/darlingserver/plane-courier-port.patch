+static int parseInheritedFD(const char* value, const char* description) {
+	char* end = nullptr;
+	errno = 0;
+	const long parsed = strtol(value, &end, 10);
+	if (
+		errno != 0 ||
+		end == value ||
+		*end != '\0' ||
+		parsed < 0 ||
+		parsed > INT_MAX
+	) {
+		fprintf(stderr, "Invalid inherited %s descriptor\n", description);
+		exit(1);
+	}
+	return static_cast<int>(parsed);
