+		} else if (dtape_test_trace_streq(event, "kmsg_send_dest")) {
+			tag = 3;
+		} else if (dtape_test_trace_streq(event, "post_wake")) {
+			tag = 4;
+		} else if (dtape_test_trace_streq(event, "trap_recv_object")) {
+			tag = 5;
+		} else if (dtape_test_trace_streq(event, "recv_woken")) {
+			tag = 6;
+		}
