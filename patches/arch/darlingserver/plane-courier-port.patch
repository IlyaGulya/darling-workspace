+#ifndef _DARLINGSERVER_DEBUG_SERIALIZE_HPP_
+#define _DARLINGSERVER_DEBUG_SERIALIZE_HPP_
+
+#include <darlingserver/debug-abi.hpp>
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace DarlingServer::Debug {
+
+	struct SerializeResult {
+		std::string json;
+		bool truncated = false;
+		// Names of sections that did not fit the byte budget, in drop order.
+		std::vector<std::string> dropped;
+	};
+
+	// Serializes a snapshot to JSON, never exceeding `maxBytes` bytes.
+	//
+	// The core block (ABI version, sequence, op, the three identity spaces, and
+	// the per-section availability map) is always emitted: those are what let a
+	// debugger tell "absent state" from "state the server cannot describe".
+	// Remaining sections are appended in priority order while the budget allows.
+	// Any section that does not fit is named in `dropped` and the result is
+	// marked truncated, so truncation is always observable and never silent.
+	SerializeResult serializeSnapshotJSON(const TargetSnapshot& snapshot, size_t maxBytes);
+
+	// Minimal always-emitted ABI banner, used by `hello`/version probes and as
+	// the last-resort response when even the core block cannot fit a budget.
+	std::string serializeAbiBanner(size_t maxBytes);
+
+	// The hard upper bound a server places on a single response, so a debug query
+	// can never turn into an unbounded allocation or write.
+	static constexpr size_t kDefaultMaxResponseBytes = 64 * 1024;
+
+};
+
+#endif // _DARLINGSERVER_DEBUG_SERIALIZE_HPP_
diff --git a/internal-include/darlingserver/exec-completion.hpp b/internal-include/darlingserver/exec-completion.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..691af0b805223a722a320b341673d3484755d39e
--- /dev/null
+++ b/internal-include/darlingserver/exec-completion.hpp
@@ -0,0 +1,63 @@
+#ifndef _DARLINGSERVER_EXEC_COMPLETION_HPP_
+#define _DARLINGSERVER_EXEC_COMPLETION_HPP_
+
+#include <cerrno>
+#include <memory>
+#include <system_error>
+#include <utility>
+#include <unistd.h>
+
+#include <darlingserver/utility.hpp>
+
+namespace DarlingServer {
+	// Serialized by Process::_rwlock. The pipe, not delivery of its epoll
+	// notification, determines whether exec completed before a new Checkin.
+	class ExecCompletion {
+	public:
+		enum class Result {
+			None,
+			Failed,
+			Darling,
+			Native,
+		};
+
+		void begin(std::shared_ptr<FD> listener, bool executingMachO) {
+			_listener = std::move(listener);
+			_executingMachO = executingMachO;
+		}
+
+		Result poll() {
+			if (!_listener) {
+				return Result::None;
+			}
+
+			char failure;
+			ssize_t count;
+			do {
+				count = read(_listener->fd(), &failure, sizeof(failure));
+			} while (count < 0 && errno == EINTR);
+			if (count < 0) {
+				if (errno == EAGAIN || errno == EWOULDBLOCK) {
+					return Result::None;
+				}
+				throw std::system_error(errno, std::generic_category(), "Failed to read from exec listener pipe");
+			}
+
+			auto result = count != 0 ? Result::Failed : (_executingMachO ? Result::Darling : Result::Native);
+			_listener.reset();
+			return result;
+		}
+
+		Result poll(const std::shared_ptr<FD>& listener) {
+			// A Checkin may already have consumed this completion, or another
+			// exec attempt may have started before an old monitor was serviced.
+			return listener == _listener ? poll() : Result::None;
+		}
+
+	private:
+		std::shared_ptr<FD> _listener;
+		bool _executingMachO = false;
+	};
+}
+
+#endif
