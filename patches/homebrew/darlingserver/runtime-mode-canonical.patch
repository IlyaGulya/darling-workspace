+	int prefixFD,
+	int parentFD,
+	const char* leaf,
+	int workdirFD,
+	RuntimeMode mode
+);
+std::string runtimePrefixProcPath(int prefixFD);
+void validateRootlessProcessCredentials(uid_t expectedUID, gid_t expectedGID);
+
+}
