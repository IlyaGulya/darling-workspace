From 590f0f1754b376fe090392de4cc47ad588011b10 Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 13 Oct 2026 13:27:34 +0000
Subject: [PATCH] perf#30: give thread_get_special_reply_port its ring lane

thread_get_special_reply_port had NO ROUTE. It was absent from all three places that
decide a callnum's transport: DSERVER_RING_C2S_OPCODES (the server's will-service
allowlist), DSERVER_RING_OP_CLASS (SimpleRingC2SEligible), and RING_GENERATED_SIMPLE (the
generated wrapper's may-take-the-ring set) -- so the guest wrapper asked the RETIRED
per-thread RPC socket for a transport up front. MEASURED on prefix-verify14, BOTH xcodebuild
workloads of the ladder:

  [rpc-socket-DENIED] pid=797268 tid=797268 call=thread_get_special_reply_port image=kernel delta=0x33D2D denied=1
  [sigexc-fault-map ... /usr/lib/system/libdispatch.dylib]
  [sigexc-fatal sig=4 code=2 addr=0x7ACA9AC35977 pid=797268 tid=797268]
  XCB_RC=132

delta=0x33D2D resolves against the DEPLOYED libsystem_kernel (not the server binary --
mach_driver_get_fd does not exist there) to dserver_rpc_thread_get_special_reply_port + 0x1d,
the wrapper's up-front dserver_rpc_hooks_get_socket(); the refusal is therefore guest-side
and the server never saw the call. The guest core (scripts/dwdiag core) names the death and
the caller: the fault is `ud2` (bytes 0f 0b) at _dispatch_get_thread_reply_port + 0x107 in the
deployed libdispatch.dylib, reached from _dispatch_mach_send_and_wait_for_reply <-
dispatch_mach_send_with_result_and_wait_for_reply <- xpc_connection_send_message_with_reply_sync
<- CoreSymbolicationDT's CSCppDaemonConnection <- DVTStackBacktrace <- IDEInitialize. libdispatch
mints the thread's special reply port there ONCE per thread (which is why the run carries
exactly one denial line) and traps natively on a NULL/dead port, killing xcodebuild's main
thread before it builds anything.

THIS IS A ROUTE, NOT AN IMPLEMENTATION. Call::ThreadGetSpecialReplyPort and duct-tape's
thread_get_special_reply_port already exist in this tree and are what the datagram path used;
only the TRANSPORT was absent. The trap is mach_reply_port's SPECIAL half and has the identical
wire shape (EMPTY request, single-uint32 port reply), so its home is the same lane, under the
same five-rule membership canon (no caller-S2C upcall, no destroy-capable side effect, safety
decidable from the args before mutation, membership in this macro of record, and the ordinary
Call supplying the semantics -- directive section 15). Odd-looking but deliberate: the wire
shape is what makes this a one-line lane entry rather than a new plane op; the trap is reached
by the main thread long after its lane is attached ([dring-adopt] gate=1 for the same tid), so
"reached too early" -- the reason mach_port_move_member/pthread_canceled belong on the
management plane instead -- does not apply here.

REUSE CHECK (before writing anything), the same three places the last two rungs looked.
  1. THIS TREE already carries the implementation: duct-tape xnu/osfmk/kern/ipc_tt.c:1319
     (Apple's own routine: unbind the previous special reply port, mint a new one with a SEND
     and a RECEIVE right) and the generated Call::ThreadGetSpecialReplyPort ->
     dtape_thread_get_special_reply_port. Nothing is invented here.
  2. No newer upstream release of this component has such a route: the ring lane is this hard
     fork's own perf#30 architecture and does not exist upstream.
  3. FORKS (checked 2026-10-13 against the read-only VibeDarling checkout
     /home/ilyagulya/work/wr-fresh/vibedarling): VibeDarling/darling-xnu 5506422 carries the
     SAME gap -- its thread_get_special_reply_port_impl is the pre-fix two-line shape with no
     ring helper and no plane op -- and VibeDarling/darlingserver b87d01e has neither
     DSERVER_RING_C2S_OPCODES nor dserver_ring_op_class nor any ring helper anywhere
     (dserver_ring_op_class, DSERVER_RING_C2S_OPCODES, dserver_ring_op_class occur 0 times in
     the fork). It also cannot hit this wall: its mach_driver_get_fd() still returns
     __dserver_per_thread_socket(), i.e. the per-thread socket is alive there. So there is
     nothing to reuse and nothing to copy: the transport this patch plugs into does not exist
     in the fork.
---
 include/darlingserver/rpc-supplement.h | 10 ++++++++++
 scripts/generate-rpc-wrappers.py       |  6 ++++++
 2 files changed, 16 insertions(+)

diff --git a/include/darlingserver/rpc-supplement.h b/include/darlingserver/rpc-supplement.h
index c908bc733d55788d00cba29266e41e296ba5dcc7..0ee898be2ac61a4bc42cb7269ab25c334db83373 100644
--- a/include/darlingserver/rpc-supplement.h
+++ b/include/darlingserver/rpc-supplement.h
@@ -476,6 +476,15 @@ static inline void dserver_ring_consumer_advance(dserver_ring_t* ring) {
 	X(thread_self_trap) \
 	X(host_self_trap) \
 	X(mach_reply_port) \
+	/* perf#30 (dar-liaq): thread_get_special_reply_port -- mach_reply_port's SPECIAL half, same empty
+	   request / single-uint32-port reply shape, same lane class. It had NO route: the generated guest
+	   wrapper asked the retired per-thread RPC socket, mach_driver_get_fd declined and printed
+	   `[rpc-socket-DENIED call=thread_get_special_reply_port image=kernel delta=0x33D2D]`, and the trap's
+	   impl swallowed that into MACH_PORT_NULL -- which libdispatch's _dispatch_get_thread_reply_port
+	   turns into a native ud2 (SIGILL), killing xcodebuild's main thread. It passes all five canon rules
+	   (no caller-S2C, no destroy, decidable from args, in this set, and the ordinary Call's
+	   ThreadGetSpecialReplyPort is what the datagram path used). */ \
+	X(thread_get_special_reply_port) \
 	X(mach_port_allocate) \
 	X(mach_port_insert_right) \
 	/* perf #18 D11 (dar-1il.6): bulk closed-fast Lane-1 batch, generic-fiber Tier-1 (NOT no-fiber). */ \
@@ -925,6 +934,7 @@ struct dserver_fd_courier_message {
 	X(thread_self_trap,       DSERVER_RING_CLASS_SIMPLE_C2S) \
 	X(host_self_trap,         DSERVER_RING_CLASS_SIMPLE_C2S) \
 	X(mach_reply_port,        DSERVER_RING_CLASS_SIMPLE_C2S) \
+	X(thread_get_special_reply_port, DSERVER_RING_CLASS_SIMPLE_C2S) \
 	/* Create/ref bookkeeping, no teardown, no caller S2C. */ \
 	X(mach_port_allocate,     DSERVER_RING_CLASS_SIMPLE_C2S) \
 	X(mach_port_insert_right, DSERVER_RING_CLASS_SIMPLE_C2S) \
diff --git a/scripts/generate-rpc-wrappers.py b/scripts/generate-rpc-wrappers.py
index 783e6005f82636f8deddd67ad4e7ca47b52a56fa..a6c8d8dca3e7fdd5ba046fa37294b7f7e5c5bd29 100755
--- a/scripts/generate-rpc-wrappers.py
+++ b/scripts/generate-rpc-wrappers.py
@@ -829,6 +829,12 @@ RING_GENERATED_SIMPLE = {
 	'thread_self_trap': 0,
 	'host_self_trap': 0,
 	'mach_reply_port': 0,
+	# perf#30 (dar-liaq): mach_reply_port's SPECIAL half. Same empty request / single-uint32-port
+	# reply shape as mach_reply_port -- the hand-written helper it shares is gr_port_trap -- and it
+	# is classified SIMPLE_C2S in DSERVER_RING_OP_CLASS and listed in DSERVER_RING_C2S_OPCODES.
+	# MEASURED before this entry: [rpc-socket-DENIED call=thread_get_special_reply_port image=kernel
+	# delta=0x33D2D] at the wrapper's up-front socket request, and then libdispatch's native ud2.
+	'thread_get_special_reply_port': 0,
 	'set_dyld_info': 0,
 	'set_executable_path': 0,
 	# perf#30 FD-COURIER: the lifecycle semantics ride the lane; the descriptor half rides the process
