From c93b1f989fdaad2e2b9bdde66e7cb06eb9c22aea Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 13 Oct 2026 12:51:58 +0000
Subject: [PATCH] perf#30: answer task_map_corpse_info instead of aborting the
 server

The two corpse-map entry points were dtape_stub_unsafe(), which logs and then
calls abort(). A guest asking for a corpse map therefore did not receive a
kern_return_t: it hung in the Mach trap and the SERVER died, taking the
process-control page of every thread in that process with it. MEASURED on
prefix-verify14, BOTH xcodebuild workloads, the server's last record of the
whole incarnation is the stub line for the call

  [P:747758(747758)][T:747758(747758)] ... stub (unsafe): task_map_corpse_info_64

after which nothing is logged for the remaining ~300 s of the run; an earlier
pthread_canceled publication (plane op 7) is left PENDING, the loader's next
thread-create checkin cannot claim the single management slot

  [checkin-republish] tid=747917 attempt=1 page=1 ready=1 req=0x1 rep=0x0 pub=0
  [rpc-socket-DENIED] pid=747758 tid=747917 call=checkin image=loader denied=1
                      (no per-thread transport)

and the guest aborts and then hangs to the harness timeout (XCB_RC=absent).

XNU's own routine (xnu/osfmk/corpses/corpse.c:733) opens with two guards that
return KERN_INVALID_ARGUMENT, and no Darling task can carry TF_CORPSE --
task_generate_corpse(), the only source of a corpse port, is itself
unimplemented -- so XNU's answer is the exact answer for every input this
platform can receive. The guards are reproduced verbatim; everything after them
lives for a corpse and is unreachable here. The 32-bit entry point is XNU's own
narrowing wrapper around the 64-bit one.

Reuse check (2026-10-13): this tree's own xnu/osfmk/corpses/corpse.c is not in
the darlingserver_duct_tape source list and needs the kcdata/VM-kernel
machinery this build does not carry; upstream duct-tape and VibeDarling's fork
carry the identical unsafe stub and also omit corpse.c, so nothing is being
re-derived from a fork.
---
 duct-tape/src/task.c | 68 +++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 64 insertions(+), 4 deletions(-)

diff --git a/duct-tape/src/task.c b/duct-tape/src/task.c
index a9eb4bc..2197e5d 100644
--- a/duct-tape/src/task.c
+++ b/duct-tape/src/task.c
@@ -535,12 +535,72 @@ bool task_is_driver(task_t task) {
 	return false;
 };
 
-kern_return_t task_map_corpse_info(task_t task, task_t corpse_task, vm_address_t* kcd_addr_begin, uint32_t* kcd_size) {
-	dtape_stub_unsafe();
+/* perf#30 (dar-liaq follow-on): THIS PAIR KILLED THE SERVER. It was `dtape_stub_unsafe()`, whose whole body is
+ * `dtape_stub_log(__FUNCTION__, -1, ...)` followed by `abort()` (duct-tape/src/stubs.c:49-80), so a guest that
+ * asked for a corpse map did not get a kern_return_t -- it got a dead darlingserver, and with it a dead
+ * process-control page. MEASURED on prefix-verify14, BOTH xcodebuild workloads; the server's last record of the
+ * whole incarnation is the stub line for the call, e.g.
+ *
+ *   [1791894200.480858](dtape, Error)[P:747758(747758)][T:747758(747758)] 747758(747758):...: stub (unsafe): task_map_corpse_info_64
+ *
+ * (and the same line for pid=756555 in the iosapp run), and the server writes NOTHING again for the remaining
+ * ~300 s of the run. From then on the process's plane has no server: the earlier pthread_canceled publication
+ * (plane op 7, tid 747760) is never completed, `request_state` stays PENDING, and the loader's NEXT thread-create
+ * checkin cannot claim the single management slot --
+ *
+ *   [checkin-republish] tid=747917 attempt=1 page=1 ready=1 req=0x1 rep=0x0 pub=0
+ *   [rpc-socket-DENIED] pid=747758 tid=747917 call=checkin image=loader denied=1 (no per-thread transport)
+ *
+ * -- so the guest aborts and then hangs to the harness timeout (XCB_RC=absent). The `[dserver-CRASH ...]` the
+ * probe writes goes to the server's own fds 1/2, not to dserver.log, so the log alone cannot show the death.
+ *
+ * WHY THIS IS THE WHOLE ANSWER FOR DARLING. XNU's own routine (xnu/osfmk/corpses/corpse.c:733) opens with the two
+ * guards below and returns KERN_INVALID_ARGUMENT from them; everything after them reaches
+ * kcdata_memory_get_begin_addr()/mach_vm_allocate_kernel() and lives only for a task that carries TF_CORPSE. No
+ * Darling task can: the only way to obtain a corpse port is task_generate_corpse(), which is still an unsafe
+ * stub in this file, so TF_CORPSE is never set and `!task_is_a_corpse(corpse_task)` is always true. XNU's
+ * KERN_INVALID_ARGUMENT is therefore the faithful result for every input this build can receive -- an error the
+ * guest can branch on, instead of a dead transport it cannot.
+ *
+ * REUSE CHECK (2026-10-13). (1) This tree's own implementation exists -- xnu/osfmk/corpses/corpse.c -- but it is
+ * NOT in the build: add_library(darlingserver_duct_tape ...) in duct-tape/CMakeLists.txt lists no
+ * corpses/corpse.c, and that routine needs the kcdata and VM-kernel machinery (kern_cdata.c, vm_map) this build
+ * does not carry. Wiring it in for a call that can never get past the guards would add a whole subsystem, so it is
+ * deliberately not done; the guards above are reproduced verbatim from it instead. (2) No newer upstream release
+ * has it: upstream duct-tape carries the identical unsafe stub. (3) FORK (read-only checkout
+ * /home/ilyagulya/work/wr-fresh/vibedarling): VibeDarling/darling-darlingserver duct-tape/src/task.c:538-544 is
+ * byte-identical to what is replaced here, and its CMake source list omits corpses/corpse.c too -- nothing to
+ * reuse, and the same death is latent there.
+ *
+ * Both entry points are fixed together because XNU defines them as one routine: the 32-bit one is the narrowing
+ * wrapper around the 64-bit one, which is exactly how it is written below. */
+kern_return_t task_map_corpse_info_64(task_t task, task_t corpse_task, mach_vm_address_t* kcd_addr_begin, mach_vm_size_t* kcd_size) {
+	if (task == TASK_NULL || task_is_a_corpse_fork(task)) {
+		return KERN_INVALID_ARGUMENT;
+	}
+
+	if (corpse_task == TASK_NULL || !task_is_a_corpse(corpse_task)) {
+		return KERN_INVALID_ARGUMENT;
+	}
+
+	// unreachable in this build: TF_CORPSE is never set (see above), so no caller can get here.
+	(void)kcd_addr_begin;
+	(void)kcd_size;
+	return KERN_INVALID_ARGUMENT;
 };
 
-kern_return_t task_map_corpse_info_64(task_t task, task_t corpse_task, mach_vm_address_t* kcd_addr_begin, mach_vm_size_t* kcd_size) {
-	dtape_stub_unsafe();
+kern_return_t task_map_corpse_info(task_t task, task_t corpse_task, vm_address_t* kcd_addr_begin, uint32_t* kcd_size) {
+	mach_vm_address_t kcd_addr_begin_64 = 0;
+	mach_vm_size_t size_64 = 0;
+
+	kern_return_t kr = task_map_corpse_info_64(task, corpse_task, &kcd_addr_begin_64, &size_64);
+	if (kr != KERN_SUCCESS) {
+		return kr;
+	}
+
+	*kcd_addr_begin = (vm_address_t)kcd_addr_begin_64;
+	*kcd_size = (uint32_t)size_64;
+	return KERN_SUCCESS;
 };
 
 void task_name_deallocate(task_name_t task_name) {
-- 
2.43.0

