From c0dc8bb5abf6e0dd12f32da4f9d85f40e3867dc6 Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 13 Oct 2026 12:18:52 +0000
Subject: [PATCH] perf#30: publish pid_for_task on the process management plane

pid_for_task had NO ring route and NO plane op, so the generated guest wrapper
asked the RETIRED per-thread RPC socket for a transport. MEASURED on
prefix-verify14, both xcodebuild workloads:

  [rpc-socket-DENIED] pid=670051 tid=670051 call=pid_for_task image=kernel delta=0x3B0A0 denied=1
  pid_for_task failed (internally): -32
  XCB_RC=134

The delta resolves against the DEPLOYED libsystem_kernel to
`dserver_rpc_pid_for_task + 0x20`, i.e. the wrapper's up-front
`dserver_rpc_hooks_get_socket()` (mach_driver_get_fd, which declines
unconditionally since the per-thread socket was retired); that symbol does not
exist in the server binary at all, so the denial is a guest-side transport
refusal and the server never sees the call. The core names the caller:
__simple_abort <- pid_for_task_impl <- _darling_mach_syscall <-
CSCppMachTask::CSCppMachTask <- CSSymbolicatorCreateWithTaskFlagsAndNotification
<- +[DVTStackBacktraceSymbolicator ...] <- IDEInitialize.

NOTHING IS BEING IMPLEMENTED HERE. Call::PidForTask and duct-tape's
pid_for_task already exist and are generated for the datagram path; the server
runs the ORDINARY Call so the semantics exist once (directive section 15), and
this is only the transport adapter, exactly like mach_port_get_attributes
(32u) and the mk_timer family (33u-36u). The task name travels in payload word
0 and the OUT pid as the GUEST ADDRESS the ordinary Call writes through
writeMemory, so an invalid task port keeps its own kern_return_t
(KERN_FAILURE) instead of the caller being killed for it.

Op 37u is appended; unknown ops already answer -ENOSYS, and the page-layout
version is unaffected.

REUSE CHECK (before writing anything). The implementation is NOT missing and is
NOT being invented here, which is why this is a route and not a new call:
  1. THIS TREE's own sources already carry the whole semantics -- duct-tape's
     pid_for_task (duct-tape/src/task.c) and the generated
     Call::PidForTask::processCall -> dtape_pid_for_task(...) (built
     internal-include/darlingserver/rpc.internal.h), reached from the same
     generated dserver_rpc_pid_for_task wrapper the datagram path used. Only the
     TRANSPORT was absent, and 15 siblings of the same class
     (mach_port_type 22u, mach_port_get_attributes 32u, the mk_timer family
     33u-36u, ...) were already moved to this plane the same way.
  2. No other upstream release of this component has such a route to reuse: the
     ring lane plus process-management plane is this hard fork's own perf#30
     architecture, not upstream Darling's.
  3. FORKS (checked 2026-10-13, read-only checkout
     /home/ilyagulya/work/wr-fresh/vibedarling): VibeDarling/darling-xnu
     5506422 (origin git@github.com:VibeDarling/darling-xnu.git) still has
     `mach_driver_get_fd() { return __dserver_per_thread_socket(); }` -- the
     per-thread socket is ALIVE there, so that tree never hits this wall -- and
     `pid_for_task_impl` is the pre-fix shape; `DSERVER_PROCESS_CONTROL_OP`,
     `__dserver_plane_request` and `dserver_ring_op_class` occur NOWHERE in the
     fork (darling-xnu, darlingserver b87d01e, darling 4fbfb1d9). Nothing to
     reuse; the transport it would plug into does not exist there.
---
 include/darlingserver/rpc-supplement.h | 12 +++++++++
 src/server.cpp                         | 36 ++++++++++++++++++++++++++
 2 files changed, 48 insertions(+)

diff --git a/include/darlingserver/rpc-supplement.h b/include/darlingserver/rpc-supplement.h
index 30ea4ac..c908bc7 100644
--- a/include/darlingserver/rpc-supplement.h
+++ b/include/darlingserver/rpc-supplement.h
@@ -761,6 +761,18 @@ static inline void dserver_ring_consumer_advance(dserver_ring_t* ring) {
 #define DSERVER_PROCESS_CONTROL_OP_MK_TIMER_ARM 35u
 #define DSERVER_PROCESS_CONTROL_OP_MK_TIMER_CANCEL 36u
 
+// perf#30 (directive section 2, dar-liaq): pid_for_task is the SAME class as the mk_timer family above -- no
+// ring route and no plane op, so the generated guest wrapper asked the retired per-thread socket for a
+// transport, mach_driver_get_fd declined, and the wrapper returned -EPIPE. MEASURED: the guest's
+// pid_for_task_impl turned that into __simple_abort() while CoreSymbolicationDT's CSCppMachTask asked for its
+// task's pid, from DVTFoundation's -[DVTStackBacktrace ...] during IDEInitialize, so both xcodebuild workloads
+// died at XCB_RC=134. The implementation is NOT missing (this is a route, not a missing call): the server's
+// Call::PidForTask and duct-tape's pid_for_task already exist and are generated for the datagram path -- the
+// plane is only a transport adapter in front of the ORDINARY Call (directive section 15: one semantic core).
+// The task NAME travels in payload word 0 and the OUT pid as the GUEST ADDRESS the ordinary Call writes
+// through writeMemory, exactly the shape mach_port_get_attributes uses for its OUT parameters. APPENDED.
+#define DSERVER_PROCESS_CONTROL_OP_PID_FOR_TASK 37u
+
 // perf#30 (directive sections 19-21): the URGENT channel. interrupt_enter/interrupt_exit are published from
 // SIGNAL CONTEXT, so they may not park, may not wait, and may not touch lazily-initialised state -- and they may
 // not use the thread's own lane either, because the handler can interrupt the thread that holds it. They are
diff --git a/src/server.cpp b/src/server.cpp
index 881c802..61e0ff0 100644
--- a/src/server.cpp
+++ b/src/server.cpp
@@ -2649,6 +2649,42 @@ break;
 				}
 				break;
 			}
+			case DSERVER_PROCESS_CONTROL_OP_PID_FOR_TASK: {
+				// perf#30 (directive section 2, dar-liaq): pid_for_task had NO ring route and NO plane op, so the
+				// generated guest wrapper asked the retired per-thread socket for a transport, mach_driver_get_fd
+				// declined, the wrapper returned -EPIPE and the guest's pid_for_task_impl called __simple_abort().
+				// MEASURED: the aborting frames were CoreSymbolicationDT's CSCppMachTask asking for its task's pid,
+				// from DVTFoundation's -[DVTStackBacktrace ...] during IDEInitialize, so every xcodebuild workload
+				// died at XCB_RC=134. NOTHING IS BEING IMPLEMENTED HERE: Call::PidForTask and duct-tape's
+				// pid_for_task already exist and are what the datagram path used -- this is the transport adapter,
+				// and the server runs the ORDINARY Call so the semantics exist once (directive section 15).
+				// `pid` is an OUT parameter and travels as the GUEST ADDRESS the ordinary Call writes through
+				// writeMemory, exactly as the datagram path returned it, so a bogus task name keeps its own
+				// kern_return_t (KERN_FAILURE) instead of the caller being killed for it.
+				Message message(sizeof(dserver_rpc_call_pid_for_task_t), 0);
+				auto* call = reinterpret_cast<dserver_rpc_call_pid_for_task_t*>(message.data().data());
+				*call = {};
+				call->header.pid = static_cast<int32_t>(pid);
+				call->header.tid = static_cast<int32_t>(pid);  // PROCESS_SCOPED: the process's own thread executes it
+				call->header.number = dserver_callnum_pid_for_task;
+				call->body.t = static_cast<uint32_t>(page->request_payload[0] & 0xffffffffu);
+				call->body.pid = page->request_payload[1];
+				message.setPID(pid);
+				auto created = Call::callFromMessage(std::move(message));
+				if (created) {
+					created->suppressReplyDelivery();
+					if (auto t = created->thread()) {
+						t->noteServicedFromProcessControl();
+						t->doWork();
+						status = created->suppressedReplyCode();
+					} else {
+						status = -ESRCH;
+					}
+				} else {
+					status = -ESRCH;
+				}
+				break;
+			}
 			case DSERVER_PROCESS_CONTROL_OP_MACH_PORT_REQUEST_NOTIFICATION: {
 				// perf#30 (directive section 1, doc section 206): the hard oracle named this call as the first
 				// per-thread-socket dependency, reached from the main thread before a lane can be relied on. It is
-- 
2.43.0

