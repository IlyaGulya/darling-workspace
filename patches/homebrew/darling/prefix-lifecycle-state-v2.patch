+static int parse_uintmax_value(const char* value, uintmax_t* parsed)
+{
+	if (value == NULL || *value == '\0' || parsed == NULL)
+		return -1;
+	char* end = NULL;
+	errno = 0;
+	uintmax_t result = strtoumax(value, &end, 10);
+	if (errno != 0 || end == value || *end != '\0')
+		return -1;
+	*parsed = result;
+	return 0;
+}
