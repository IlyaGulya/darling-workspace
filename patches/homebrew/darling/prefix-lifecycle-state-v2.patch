+			DARLING_RUNTIME_MODE_MARKER_NAME, &legacy,
+			AT_SYMLINK_NOFOLLOW) != 0 && errno == ENOENT,
+		"legacy marker survived v1 to v2 upgrade");
+	require_no_temporary_entries(directory);
+	delete_prefix_fixture(recovered);
