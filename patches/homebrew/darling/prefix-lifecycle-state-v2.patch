+	if (lock_fd < 0)
+		return -1;
+	enum lifecycle_recovery_status recovered =
+		LIFECYCLE_NOT_RECOVERED;
+	if (recover_interrupted_transaction(handle, &names, mode,
+			owner_uid, owner_gid, &recovered,
+			error, error_size) != 0) {
+		close(lock_fd);
+		return -1;
