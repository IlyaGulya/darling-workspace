+	LIFECYCLE_TRANSACTION_INVALID,
+	LIFECYCLE_TRANSACTION_CREATE,
+	LIFECYCLE_TRANSACTION_UPGRADE,
+	LIFECYCLE_TRANSACTION_RECREATE,
+	LIFECYCLE_TRANSACTION_DELETE,
+};
