+static int split_exact_lines(
+	char* content,
+	char** lines,
+	size_t line_count
+)
+{
+	size_t observed = 0;
+	char* cursor = content;
+	while (*cursor != '\0') {
+		if (observed == line_count)
+			return -1;
+		lines[observed++] = cursor;
+		char* newline = strchr(cursor, '\n');
+		if (newline == NULL)
+			return -1;
+		*newline = '\0';
+		cursor = newline + 1;
+	}
+	return observed == line_count ? 0 : -1;
+}
