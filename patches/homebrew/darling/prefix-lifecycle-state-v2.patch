+static int fsync_directory(
+	int fd,
+	const char* detail,
+	char* error,
+	size_t error_size
+)
+{
+	if (fsync(fd) != 0)
+		return prefix_error(error, error_size,
+			"cannot persist runtime prefix directory: %s", detail);
+	return 0;
+}
