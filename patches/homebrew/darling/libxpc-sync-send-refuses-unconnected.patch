From d62a6b26040aa9e88f0d256359f83968e6e67c6a Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 13 Oct 2026 16:44:06 +0000
Subject: [PATCH] libxpc: a synchronous send activates, and refuses an
 unconnected channel

-sendMessageWithSynchronousReply: went straight to
dispatch_mach_send_with_result_and_wait_for_reply without ever ensuring the
connection was activated, and that turned a connection whose activation FAILED
into an infinite park instead of a failed send.

libdispatch keeps DISPATCH_MACH_NEVER_CONNECTED in dmsr_disconnect_cnt until
dispatch_mach_connect clears it (event_kevent.c:3077 sets it at creation,
mach.c:286 clears it), and dispatch_mach_connect is reachable only from
activateLocked (connection.m:803) <- activate <- resume. While that bit is set,
_dispatch_mach_send_push_and_trydrain (mach.c:1623-1634) queues the message and
returns WITHOUT draining: the request is never sent, no reply waiter is ever
registered, and the receive that follows cannot be woken -- it is issued with
MACH_MSG_TIMEOUT_NONE and, because dmsr_send is MACH_PORT_NULL, without
MACH_RCV_SYNC_WAIT (mach.c:801-803, gated on MACH_PORT_VALID(send)).

MEASURED 2026-10-13 on prefix-verify14, both xcodebuild workloads of the ladder:
the workload's main thread sat in exactly that receive for the whole run
(option=0x0700020E = MACH_RCV_MSG|MACH_RCV_LARGE|MACH_RCV_LARGE_IDENTITY|
MACH_MSG_STRICT_REPLY|MACH_RCV_TRAILER_ELEMENTS(7), timeout=0,
MACH_RCV_SYNC_WAIT absent) with NO request published on the ring for it, reached
from xpc_connection_send_message_with_reply_sync <- CoreSymbolicationDT <-
DVTStackBacktrace <- IDEInitialize. The caller is not the divergence: Xcode
26.3's CoreSymbolicationDT (Contents/SharedFrameworks/CoreSymbolicationDT.
framework) creates the connection for com.apple.coresymbolicationd and calls
xpc_connection_resume in CSCppDaemonConnection's constructor (0xfcac5/0xfcad4
create_mach_service, 0xfcaf9 resume, 0xfccd4/0xfcce0 the synchronous send), so
activation was attempted, its bootstrap_look_up found no receiver for that
service, and the failure became a park.

Apple connects a mach-service connection at creation (resume/suspend then gate
delivery, not connect), and Apple's own libdispatch marks this pre-connect phase
incomplete (mach.c:1952, rdar://31823384); the fix is therefore not a timeout on
the receive -- that would convert a correctness bug into flakiness -- but the
Apple-shaped end state: activate first (so the connected case keeps its bounded
receive, MACH_RCV_SYNC_WAIT armed, and a peer that dies fails the receive), and
return the connection error instead of entering the unbounded receive when the
channel was never connected.

Covered by tests/xpc_sync_send_unconnected_guest.c in the workspace: the
never-resumed sync send and the resumed-but-no-receiver sync send must both
return an error object rather than park.

Not covered here: the asynchronous send paths (-sendMessage:queue:withReply:,
-sendMessage:) still queue silently on a never-connected channel, and a failed
activation still does not invalidate the connection or deliver
XPC_ERROR_CONNECTION_INVALID to the event handler the way Apple's does.
---
 src/connection.m | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/src/connection.m b/src/connection.m
index 69d265bf6d372f8a96dbca69a9cba751e3a59adf..be64209b65b887b88d7fcac7a18977199cfabd77 100644
--- a/src/connection.m
+++ b/src/connection.m
@@ -980,6 +980,50 @@ error_out:
 	dispatch_mach_msg_t reply = NULL;
 	XPC_CLASS(dictionary)* result = nil;
 	mach_msg_header_t* header = NULL;
+	bool connected = false;
+
+	// A synchronous send must never reach libdispatch's sync reply receive on a channel that
+	// was never connected. While libdispatch still carries DISPATCH_MACH_NEVER_CONNECTED in
+	// dmsr_disconnect_cnt (event_kevent.c:3077 sets it at creation; dispatch_mach_connect,
+	// mach.c:286, is the only thing that clears it), _dispatch_mach_send_push_and_trydrain
+	// returns without draining (mach.c:1623-1634), so the message is parked in the send queue,
+	// no reply waiter is ever registered, and the receive that follows cannot be woken: it is
+	// issued with MACH_MSG_TIMEOUT_NONE and -- because dmsr_send is MACH_PORT_NULL -- without
+	// MACH_RCV_SYNC_WAIT (mach.c:801-803, gated on MACH_PORT_VALID(send)). That is an infinite
+	// park, not a failed send.
+	//
+	// MEASURED 2026-10-13 (prefix-verify14, both xcodebuild workloads): the workload's main
+	// thread sat in exactly that receive for the whole run --
+	//   option=0x0700020E = MACH_RCV_MSG|MACH_RCV_LARGE|MACH_RCV_LARGE_IDENTITY|
+	//                      MACH_MSG_STRICT_REPLY|MACH_RCV_TRAILER_ELEMENTS(7), timeout=0,
+	//                      no MACH_RCV_SYNC_WAIT
+	// -- with NO request published on the ring for it (the thread's ring ops are
+	// thread_get_special_reply_port then the receive), reached from
+	// xpc_connection_send_message_with_reply_sync <- CoreSymbolicationDT <- DVTStackBacktrace
+	// <- IDEInitialize. The caller is not the divergence: CoreSymbolicationDT's
+	// CSCppDaemonConnection constructor creates the connection for com.apple.coresymbolicationd
+	// and calls xpc_connection_resume (Xcode 26.3 CoreSymbolicationDT.framework, 0xfcac5/0xfcad4
+	// create_mach_service, 0xfccd4/0xfcce0 the sync send, 0xfcaf9 resume), so activation WAS
+	// attempted and its failure was silently converted into an infinite park instead of a
+	// failed send.
+	//
+	// Apple's libxpc connects a mach-service connection at creation (resume/suspend then gate
+	// delivery, not connect), and Apple's own libdispatch marks this pre-connect phase
+	// incomplete (mach.c:1952, rdar://31823384) -- so this state is a Darling divergence, and
+	// the honest end state is a bounded failure rather than a timeout added to the receive.
+	// Activating here gives the good case a bounded receive (dispatch_mach_connect sets
+	// dmsr_send, MACH_RCV_SYNC_WAIT arms, and a peer that dies fails the receive), and the
+	// activated check gives the bad case the failure Apple would deliver.
+	[self activate];
+	pthread_rwlock_rdlock(&this->activated_lock);
+	connected = this->activated;
+	pthread_rwlock_unlock(&this->activated_lock);
+	if (!connected) {
+		xpc_log_error(connection, "refusing a synchronous send on a connection that was never "
+				"connected (service \"%s\")",
+				this->service_name ? this->service_name : "(anonymous)");
+		return this->service_name ? XPC_ERROR_CONNECTION_INTERRUPTED : XPC_ERROR_CONNECTION_INVALID;
+	}
 
 	@autoreleasepool {
 		XPC_CLASS(serializer)* serializer = [XPC_CLASS(serializer) serializer];
