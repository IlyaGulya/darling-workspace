+#ifdef TEST
+int eunion_sidecar_test_transaction_guards(
+	const struct eunion_sidecar_runtime* runtime)
+{
+	eunion_sidecar_transaction transaction = {{0}};
+	union eunion_sidecar_transaction_intent intent = {
