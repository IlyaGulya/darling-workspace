index 0000000..350003e
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/linux_premigration/eunion_remove_runtime.c
@@ -0,0 +1,1153 @@
+#ifdef TEST
+#	define _GNU_SOURCE
+#endif
+
+#include <linux_premigration/eunion_remove_runtime.h>
+
+#ifdef TEST
+#	include <errno.h>
+#	include <fcntl.h>
+#	include <stdint.h>
+#	include <string.h>
+#	include <sys/file.h>
