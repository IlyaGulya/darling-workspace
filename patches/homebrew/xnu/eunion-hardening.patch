+	join_path(upper_child, sizeof(upper_child),
+		upper_tree, "/upper-child");
+	join_path(lower_child, sizeof(lower_child),
+		lower_tree, "/lower-child");
+	join_path(copied_child, sizeof(copied_child),
+		upper_tree, "/lower-child");
+	require(mkdir(upper, 0700) == 0 &&
+		mkdir(lower, 0700) == 0 &&
+		mkdir(sidecar, 0700) == 0 &&
+		mkdir(upper_tree, 0700) == 0 &&
+		mkdir(lower_tree, 0700) == 0,
+		"create merged recovery directories");
+	write_file(upper_child);
+	write_file(lower_child);
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0,
+		"write merged sidecar-v1 prefix state");
+	require(eunion_sidecar_initialize(&runtime) == 0,
+		"initialize merged recovery sidecar");
+
+	pid_t child = fork();
+	require(child >= 0, "fork merged copyup boundary child");
+	if (child == 0) {
+		kill_path = "/merged";
+		kill_checkpoint = checkpoint;
+		eunion_test_sidecar_checkpoint_hook = kill_at_boundary;
+		(void)eunion_sidecar_copy_up_tree(&runtime, "/merged");
+		_exit(90);
+	}
+	int child_status;
+	require(waitpid(child, &child_status, 0) == child,
+		"wait merged copyup boundary child");
+	require(WIFSIGNALED(child_status) &&
+		WTERMSIG(child_status) == termination_signal,
+		"merged child is killed at durable boundary");
+	struct stat status;
+	require(lstat(journal, &status) == 0,
+		"merged materialization journal survives interruption");
+
+	eunion_sidecar_view recovery = {{0}};
+	int recovery_result = eunion_sidecar_view_open(recovery, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE);
+	if (recovery_result < 0)
+		fprintf(stderr,
+			"merged recovery checkpoint=%d result=%d\n",
+			(int)checkpoint, recovery_result);
+	require(recovery_result == 0,
+		"exclusive open recovers merged materialization");
+	require(eunion_sidecar_view_close(recovery) == 0,
+		"close merged recovery");
+	require(lstat(journal, &status) == -1 && errno == ENOENT,
+		"merged recovery consumes journal");
+	require(lstat(upper_child, &status) == 0 &&
+		lstat(copied_child, &status) == 0,
+		"merged recovery preserves upper child and materializes lower child");
+	eunion_sidecar_view repeated = {{0}};
+	require(eunion_sidecar_view_open(repeated, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0 &&
+		eunion_sidecar_view_close(repeated) == 0,
+		"merged recovery is idempotent");
+
+	char command[640];
+	int length = snprintf(command, sizeof(command), "rm -rf -- '%s'", root);
+	require(length > 0 && (size_t)length < sizeof(command),
+		"construct merged cleanup command");
+	require(system(command) == 0, "remove merged recovery root");
+}
+
+static void run_all_boundaries(void)
+{
+	run_boundary(EUNION_SIDECAR_TEST_JOURNAL_PREPARED, 0);
+	run_boundary(EUNION_SIDECAR_TEST_LOGICALLY_PUBLISHED, 0);
+	run_boundary(EUNION_SIDECAR_TEST_BACKING_COMMITTED, 1);
+	run_boundary(EUNION_SIDECAR_TEST_DURABLE, 1);
+	run_create_boundary(EUNION_SIDECAR_TEST_JOURNAL_PREPARED, 0);
+	run_create_boundary(EUNION_SIDECAR_TEST_PRE_BACKING, 0);
+	run_create_boundary(EUNION_SIDECAR_TEST_POST_BACKING_PRE_JOURNAL, 1);
+	run_create_boundary(EUNION_SIDECAR_TEST_BACKING_COMMITTED, 1);
+	run_create_boundary(EUNION_SIDECAR_TEST_DURABLE, 1);
+	run_copyup_boundary(EUNION_SIDECAR_TEST_JOURNAL_PREPARED, 0);
+	run_copyup_boundary(EUNION_SIDECAR_TEST_PRE_BACKING, 0);
+	run_copyup_boundary(EUNION_SIDECAR_TEST_POST_BACKING_PRE_JOURNAL, 1);
+	run_copyup_boundary(EUNION_SIDECAR_TEST_BACKING_COMMITTED, 1);
+	run_copyup_boundary(EUNION_SIDECAR_TEST_DURABLE, 1);
+	run_rename_boundary(EUNION_SIDECAR_TEST_JOURNAL_PREPARED, 0);
+	run_rename_boundary(EUNION_SIDECAR_TEST_PRE_BACKING, 0);
+	run_rename_boundary(EUNION_SIDECAR_TEST_POST_BACKING_PRE_JOURNAL, 1);
+	run_rename_boundary(EUNION_SIDECAR_TEST_BACKING_COMMITTED, 1);
+	run_rename_boundary(EUNION_SIDECAR_TEST_DURABLE, 1);
+	run_merged_copyup_boundary(EUNION_SIDECAR_TEST_JOURNAL_PREPARED);
+	run_merged_copyup_boundary(EUNION_SIDECAR_TEST_PRE_BACKING);
+	run_merged_copyup_boundary(
+		EUNION_SIDECAR_TEST_POST_BACKING_PRE_JOURNAL);
+	run_merged_copyup_boundary(EUNION_SIDECAR_TEST_BACKING_COMMITTED);
+	run_merged_copyup_boundary(EUNION_SIDECAR_TEST_DURABLE);
+}
+
+int main(void)
+{
+	termination_signal = SIGKILL;
+	run_all_boundaries();
+	termination_signal = SIGINT;
+	run_all_boundaries();
+	run_remove_fault(EUNION_SIDECAR_TEST_RESOLVED, __NR_openat, 0);
+	run_remove_fault(
+		EUNION_SIDECAR_TEST_RESOLVED, __NR_renameat, 0);
+	run_remove_fault(
+		EUNION_SIDECAR_TEST_JOURNAL_PREPARED, __NR_fsync, 0);
+	run_remove_fault(
+		EUNION_SIDECAR_TEST_PRE_BACKING, __NR_unlinkat, 0);
+	run_remove_fault(
+		EUNION_SIDECAR_TEST_LOGICALLY_PUBLISHED, __NR_fsync, 1);
+	run_remove_fault(
+		EUNION_SIDECAR_TEST_PRE_BACKING, __NR_fsync, 1);
+	run_remove_fault(
+		EUNION_SIDECAR_TEST_BACKING_COMMITTED, __NR_fsync, 1);
+	run_remove_fault(
+		EUNION_SIDECAR_TEST_DURABLE, __NR_unlinkat, 1);
+	printf("EUNION_SIDECAR_RECOVERY_OK checks=%d boundaries=48"
+		" sigkill=24 sigint=24 faults=8\n", checks);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_state_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_state_test.c
new file mode 100644
index 0000000..8c79730
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_state_test.c
@@ -0,0 +1,213 @@
+#include <linux_premigration/eunion_sidecar.h>
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	++checks;
+	if (!condition) {
+		fprintf(stderr, "eunion_sidecar_state_test: %s\n", message);
+		exit(1);
+	}
+}
+
+static void test_transitions(void)
+{
+	static const struct {
+		enum eunion_sidecar_phase from;
+		enum eunion_sidecar_phase to;
+	} allowed[] = {
+		{EUNION_SIDECAR_PHASE_EMPTY, EUNION_SIDECAR_PHASE_RESOLVED},
+		{EUNION_SIDECAR_PHASE_RESOLVED, EUNION_SIDECAR_PHASE_LOCKED},
+		{EUNION_SIDECAR_PHASE_RESOLVED, EUNION_SIDECAR_PHASE_RELEASED},
+		{EUNION_SIDECAR_PHASE_LOCKED, EUNION_SIDECAR_PHASE_PREPARED},
+		{EUNION_SIDECAR_PHASE_LOCKED, EUNION_SIDECAR_PHASE_RELEASED},
+		{EUNION_SIDECAR_PHASE_PREPARED,
+			EUNION_SIDECAR_PHASE_LOGICALLY_PUBLISHED},
+		{EUNION_SIDECAR_PHASE_PREPARED, EUNION_SIDECAR_PHASE_RELEASED},
+		{EUNION_SIDECAR_PHASE_LOGICALLY_PUBLISHED,
+			EUNION_SIDECAR_PHASE_BACKING_COMMITTED},
+		{EUNION_SIDECAR_PHASE_LOGICALLY_PUBLISHED,
+			EUNION_SIDECAR_PHASE_ROLLED_BACK},
+		{EUNION_SIDECAR_PHASE_LOGICALLY_PUBLISHED,
+			EUNION_SIDECAR_PHASE_RECOVERY_DELEGATED},
+		{EUNION_SIDECAR_PHASE_BACKING_COMMITTED,
+			EUNION_SIDECAR_PHASE_DURABLE},
+		{EUNION_SIDECAR_PHASE_BACKING_COMMITTED,
+			EUNION_SIDECAR_PHASE_FORWARD_RECOVERY},
+		{EUNION_SIDECAR_PHASE_BACKING_COMMITTED,
+			EUNION_SIDECAR_PHASE_RECOVERY_DELEGATED},
+		{EUNION_SIDECAR_PHASE_ROLLED_BACK,
+			EUNION_SIDECAR_PHASE_DURABLE},
+		{EUNION_SIDECAR_PHASE_FORWARD_RECOVERY,
+			EUNION_SIDECAR_PHASE_DURABLE},
+		{EUNION_SIDECAR_PHASE_RECOVERY_DELEGATED,
+			EUNION_SIDECAR_PHASE_RELEASED},
+		{EUNION_SIDECAR_PHASE_DURABLE, EUNION_SIDECAR_PHASE_RELEASED},
+	};
+
+	for (int from = EUNION_SIDECAR_PHASE_EMPTY;
+		from < EUNION_SIDECAR_PHASE_INVALID; ++from) {
+		for (int to = EUNION_SIDECAR_PHASE_EMPTY;
+			to < EUNION_SIDECAR_PHASE_INVALID; ++to) {
+			int expected = 0;
+			for (unsigned int index = 0;
+				index < sizeof(allowed) / sizeof(allowed[0]); ++index)
+				if ((int)allowed[index].from == from &&
+					(int)allowed[index].to == to)
+					expected = 1;
+			int result = eunion_sidecar_transition_allowed(
+				(enum eunion_sidecar_phase)from,
+				(enum eunion_sidecar_phase)to);
+			require((result == 0) == expected,
+				"transition table is exact and fail-closed");
+		}
+	}
+	require(eunion_sidecar_transition_allowed(
+		EUNION_SIDECAR_PHASE_INVALID,
+		EUNION_SIDECAR_PHASE_RELEASED) == -EINVAL,
+		"invalid source phase rejected");
+}
+
+static int backing_first_operation(enum eunion_sidecar_operation operation)
+{
+	return operation == EUNION_SIDECAR_OPERATION_CREATE ||
+		operation == EUNION_SIDECAR_OPERATION_COPY_UP ||
+		operation == EUNION_SIDECAR_OPERATION_RENAME ||
+		operation == EUNION_SIDECAR_OPERATION_PREFIX_RECREATE;
+}
+
+static int expected_operation_transition(
+	enum eunion_sidecar_operation operation,
+	enum eunion_sidecar_phase from, enum eunion_sidecar_phase to)
+{
+	if (!backing_first_operation(operation))
+		return eunion_sidecar_transition_allowed(from, to) == 0;
+	switch (from) {
+		case EUNION_SIDECAR_PHASE_PREPARED:
+			return to == EUNION_SIDECAR_PHASE_BACKING_COMMITTED ||
+				to == EUNION_SIDECAR_PHASE_RECOVERY_DELEGATED ||
+				to == EUNION_SIDECAR_PHASE_RELEASED;
+		case EUNION_SIDECAR_PHASE_BACKING_COMMITTED:
+			return to == EUNION_SIDECAR_PHASE_LOGICALLY_PUBLISHED ||
+				to == EUNION_SIDECAR_PHASE_FORWARD_RECOVERY ||
+				to == EUNION_SIDECAR_PHASE_RECOVERY_DELEGATED;
+		case EUNION_SIDECAR_PHASE_LOGICALLY_PUBLISHED:
+			return to == EUNION_SIDECAR_PHASE_DURABLE ||
+				to == EUNION_SIDECAR_PHASE_FORWARD_RECOVERY ||
+				to == EUNION_SIDECAR_PHASE_RECOVERY_DELEGATED;
+		default:
+			return eunion_sidecar_transition_allowed(from, to) == 0;
+	}
+}
+
+static void test_operation_transitions(void)
+{
+	for (int operation = EUNION_SIDECAR_OPERATION_REMOVE;
+			operation < EUNION_SIDECAR_OPERATION_INVALID; ++operation) {
+		for (int from = EUNION_SIDECAR_PHASE_EMPTY;
+				from < EUNION_SIDECAR_PHASE_INVALID; ++from) {
+			for (int to = EUNION_SIDECAR_PHASE_EMPTY;
+					to < EUNION_SIDECAR_PHASE_INVALID; ++to) {
+				int expected = expected_operation_transition(
+					(enum eunion_sidecar_operation)operation,
+					(enum eunion_sidecar_phase)from,
+					(enum eunion_sidecar_phase)to);
+				int result = eunion_sidecar_operation_transition_allowed(
+					(enum eunion_sidecar_operation)operation,
+					(enum eunion_sidecar_phase)from,
+					(enum eunion_sidecar_phase)to);
+				require((result == 0) == expected,
+					"operation-specific transition table is exhaustive");
+			}
+		}
+	}
+	require(eunion_sidecar_operation_transition_allowed(
+			EUNION_SIDECAR_OPERATION_INVALID,
+			EUNION_SIDECAR_PHASE_EMPTY,
+			EUNION_SIDECAR_PHASE_RESOLVED) == -EINVAL,
+		"invalid operation transition is rejected");
+}
+
+static void test_recovery_matrix(void)
+{
+	int matrix = 0;
+	for (int operation = EUNION_SIDECAR_OPERATION_REMOVE;
+		operation < EUNION_SIDECAR_OPERATION_INVALID; ++operation) {
+		for (int journal = EUNION_SIDECAR_JOURNAL_ABSENT;
+			journal < EUNION_SIDECAR_JOURNAL_INVALID; ++journal) {
+			for (int stable = EUNION_SIDECAR_STABLE_OLD;
+				stable < EUNION_SIDECAR_STABLE_INVALID; ++stable) {
+				for (int backing = EUNION_SIDECAR_BACKING_OLD;
+					backing < EUNION_SIDECAR_BACKING_INVALID;
+					++backing) {
+					enum eunion_sidecar_recovery_action action =
+						eunion_sidecar_plan_operation_recovery(
+							(enum eunion_sidecar_operation)
+								operation,
+							(enum eunion_sidecar_journal_phase)
+								journal,
+							(enum eunion_sidecar_stable_state)
+								stable,
+							(enum eunion_sidecar_backing_state)
+								backing);
+					require(action >=
+							EUNION_SIDECAR_RECOVERY_QUIESCENT &&
+						action <
+							EUNION_SIDECAR_RECOVERY_INVALID,
+						"every operation x persistent combination"
+						" has an explicit decision");
+					++matrix;
+				}
+			}
+		}
+	}
+	require(matrix == 560,
+		"complete 7 x 5 x 4 x 4 operation recovery matrix");
+	require(eunion_sidecar_plan_recovery(
+		EUNION_SIDECAR_JOURNAL_LOGICALLY_PUBLISHED,
+		EUNION_SIDECAR_STABLE_NEW,
+		EUNION_SIDECAR_BACKING_OLD) ==
+			EUNION_SIDECAR_RECOVERY_ROLL_BACK,
+		"logical publication before backing commit rolls back");
+	require(eunion_sidecar_plan_recovery(
+		EUNION_SIDECAR_JOURNAL_BACKING_COMMITTED,
+		EUNION_SIDECAR_STABLE_OLD,
+		EUNION_SIDECAR_BACKING_NEW) ==
+			EUNION_SIDECAR_RECOVERY_REPUBLISH_FORWARD,
+		"irreversible backing commit forward-recovers sidecar");
+	require(eunion_sidecar_plan_recovery(
+		EUNION_SIDECAR_JOURNAL_ABSENT,
+		EUNION_SIDECAR_STABLE_MIXED,
+		EUNION_SIDECAR_BACKING_OLD) ==
+			EUNION_SIDECAR_RECOVERY_CORRUPTION,
+		"mixed quiescent state fails closed");
+	require(eunion_sidecar_plan_operation_recovery(
+		EUNION_SIDECAR_OPERATION_CREATE,
+		EUNION_SIDECAR_JOURNAL_PREPARED,
+		EUNION_SIDECAR_STABLE_OLD,
+		EUNION_SIDECAR_BACKING_NEW) ==
+			EUNION_SIDECAR_RECOVERY_REPUBLISH_FORWARD,
+		"backing-first create recovers an inode committed before journal"
+		" advancement");
+	require(eunion_sidecar_plan_operation_recovery(
+		EUNION_SIDECAR_OPERATION_RENAME,
+		EUNION_SIDECAR_JOURNAL_LOGICALLY_PUBLISHED,
+		EUNION_SIDECAR_STABLE_NEW,
+		EUNION_SIDECAR_BACKING_OLD) ==
+			EUNION_SIDECAR_RECOVERY_CORRUPTION,
+		"backing-first rename rejects impossible logical-first phase");
+}
+
+int main(void)
+{
+	test_transitions();
+	test_operation_transitions();
+	test_recovery_matrix();
+	printf("EUNION_SIDECAR_STATE_OK checks=%d matrix=560\n", checks);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_storage_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_storage_test.c
new file mode 100644
index 0000000..4f3be8c
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_storage_test.c
@@ -0,0 +1,507 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+#include "eunion_sidecar_test_support.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/xattr.h>
+#include <unistd.h>
+
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	++checks;
+	if (!condition) {
+		fprintf(stderr, "eunion_sidecar_storage_test: %s (errno=%d)\n",
+			message, errno);
+		exit(1);
+	}
+}
+
+static void join_path(char* output, size_t capacity, const char* root,
+	const char* suffix)
+{
+	int length = snprintf(output, capacity, "%s%s", root, suffix);
+	require(length > 0 && (size_t)length < capacity, "path overflow");
+}
+
+static void remove_tree(const char* root)
+{
+	char command[640];
+	int length = snprintf(command, sizeof(command), "rm -rf -- '%s'", root);
+	require(length > 0 && (size_t)length < sizeof(command),
+		"cleanup command size");
+	require(system(command) == 0, "cleanup");
+}
+
+int main(void)
+{
+	char root[] = "/tmp/eunion-sidecar-storage.XXXXXX";
+	require(mkdtemp(root) != NULL, "mkdtemp");
+	char upper[512];
+	char lower[512];
+	char sidecar[512];
+	char link[512];
+	char intermediate_link[512];
+	char intermediate_sidecar[512];
+	char lock[512];
+	char format[512];
+	char lower_deleted[512];
+	char upper_deleted[512];
+	char upper_opaque[512];
+	char lower_opaque[512];
+	char upper_recreated[512];
+	char lower_recreated[512];
+	char lower_recreated_child[512];
+	char lower_tree[512];
+	char lower_tree_child[512];
+	char upper_tree[512];
+	char upper_tree_child[512];
+	char upper_moved[512];
+	char upper_moved_child[512];
+	char lower_merged_tree[512];
+	char lower_merged_child[512];
+	char upper_merged_tree[512];
+	char upper_merged_child[512];
+	char upper_merged_lower_child[512];
+	char upper_merged_moved[512];
+	char upper_merged_moved_upper_child[512];
+	char upper_merged_moved_lower_child[512];
+	char upper_created[512];
+	char upper_link[512];
+	char upper_hardlink[512];
+	char upper_fifo[512];
+	char upper_socket[512];
+	char lower_locked_tree[512];
+	char lower_locked_child[512];
+	char upper_locked_tree[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(link, sizeof(link), root, "/sidecar-link");
+	join_path(intermediate_link, sizeof(intermediate_link),
+		root, "/intermediate-link");
+	join_path(intermediate_sidecar, sizeof(intermediate_sidecar),
+		intermediate_link, "/sidecar");
+	join_path(lock, sizeof(lock), sidecar, "/lock-v1");
+	join_path(format, sizeof(format), sidecar, "/format-v1");
+	join_path(lower_deleted, sizeof(lower_deleted), lower, "/deleted");
+	join_path(upper_deleted, sizeof(upper_deleted), upper, "/deleted");
+	join_path(upper_opaque, sizeof(upper_opaque), upper, "/opaque");
+	join_path(lower_opaque, sizeof(lower_opaque), lower, "/opaque");
+	join_path(upper_recreated, sizeof(upper_recreated),
+		upper, "/recreated");
+	join_path(lower_recreated, sizeof(lower_recreated),
+		lower, "/recreated");
+	join_path(lower_recreated_child, sizeof(lower_recreated_child),
+		lower, "/recreated/child");
+	join_path(lower_tree, sizeof(lower_tree), lower, "/tree");
+	join_path(lower_tree_child, sizeof(lower_tree_child),
+		lower, "/tree/child");
+	join_path(upper_tree, sizeof(upper_tree), upper, "/tree");
+	join_path(upper_tree_child, sizeof(upper_tree_child),
+		upper, "/tree/child");
+	join_path(upper_moved, sizeof(upper_moved), upper, "/moved");
+	join_path(upper_moved_child, sizeof(upper_moved_child),
+		upper, "/moved/child");
+	join_path(lower_merged_tree, sizeof(lower_merged_tree),
+		lower, "/merged-tree");
+	join_path(lower_merged_child, sizeof(lower_merged_child),
+		lower, "/merged-tree/lower-child");
+	join_path(upper_merged_tree, sizeof(upper_merged_tree),
+		upper, "/merged-tree");
+	join_path(upper_merged_child, sizeof(upper_merged_child),
+		upper, "/merged-tree/upper-child");
+	join_path(upper_merged_lower_child, sizeof(upper_merged_lower_child),
+		upper, "/merged-tree/lower-child");
+	join_path(upper_merged_moved, sizeof(upper_merged_moved),
+		upper, "/merged-moved");
+	join_path(upper_merged_moved_upper_child,
+		sizeof(upper_merged_moved_upper_child),
+		upper, "/merged-moved/upper-child");
+	join_path(upper_merged_moved_lower_child,
+		sizeof(upper_merged_moved_lower_child),
+		upper, "/merged-moved/lower-child");
+	join_path(upper_created, sizeof(upper_created), upper, "/created");
+	join_path(upper_link, sizeof(upper_link), upper, "/link");
+	join_path(upper_hardlink, sizeof(upper_hardlink),
+		upper, "/hardlink");
+	join_path(upper_fifo, sizeof(upper_fifo), upper, "/fifo");
+	join_path(upper_socket, sizeof(upper_socket), upper, "/socket");
+	join_path(lower_locked_tree, sizeof(lower_locked_tree),
+		lower, "/locked-tree");
+	join_path(lower_locked_child, sizeof(lower_locked_child),
+		lower, "/locked-tree/child");
+	join_path(upper_locked_tree, sizeof(upper_locked_tree),
+		upper, "/locked-tree");
+	require(mkdir(upper, 0700) == 0, "mkdir upper");
+	require(mkdir(lower, 0700) == 0, "mkdir lower");
+	require(mkdir(sidecar, 0700) == 0, "mkdir sidecar");
+	require(mkdir(lower_tree, 0700) == 0, "mkdir lower rename tree");
+	struct timespec tree_times[2] = {
+		{ .tv_sec = 1700000000, .tv_nsec = 123456789 },
+		{ .tv_sec = 1700000001, .tv_nsec = 987654321 },
+	};
+	require(chmod(lower_tree, 0777) == 0 &&
+		setxattr(lower_tree, "user.review", "preserved", 9, 0) == 0 &&
+		utimensat(AT_FDCWD, lower_tree, tree_times, 0) == 0,
+		"set lower directory metadata");
+	int tree_child = open(lower_tree_child,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(tree_child >= 0 &&
+		write(tree_child, "tree", 4) == 4 &&
+		fsync(tree_child) == 0 && close(tree_child) == 0,
+		"create lower rename child");
+	require(mkdir(lower_merged_tree, 0700) == 0 &&
+		mkdir(upper_merged_tree, 0700) == 0,
+		"create merged rename tree");
+	int merged_lower_child = open(lower_merged_child,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	int merged_upper_child = open(upper_merged_child,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(merged_lower_child >= 0 && merged_upper_child >= 0 &&
+		write(merged_lower_child, "lower", 5) == 5 &&
+		write(merged_upper_child, "upper", 5) == 5 &&
+		fsync(merged_lower_child) == 0 &&
+		fsync(merged_upper_child) == 0 &&
+		close(merged_lower_child) == 0 &&
+		close(merged_upper_child) == 0,
+		"create disjoint merged rename children");
+
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0,
+		"write sidecar-v1 prefix state");
+	require(eunion_sidecar_initialize(&runtime) == 0,
+		"initialize sidecar");
+	require(eunion_sidecar_test_transaction_guards(&runtime) == 0,
+		"transaction capability rejects direct copy and reopen");
+
+	struct stat status;
+	require(lstat(lock, &status) == 0 && S_ISREG(status.st_mode) &&
+		!S_ISLNK(status.st_mode) && (status.st_mode & 0777) == 0600,
+		"persistent lock is exact regular mode 0600");
+	require(lstat(format, &status) == 0 && S_ISREG(status.st_mode) &&
+		!S_ISLNK(status.st_mode) && (status.st_mode & 0777) == 0600,
+		"format is exact regular mode 0600");
+
+	eunion_sidecar_view view = {{0}};
+	require(eunion_sidecar_view_open(view, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0, "open shared view");
+	struct eunion_sidecar_lookup lookup;
+	require(eunion_sidecar_lookup_path(view, "/", &lookup) == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_INDEX &&
+		lookup.generation == 1, "root index is identity-bound");
+	require(eunion_sidecar_lookup_path(view, "/missing", &lookup) == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_NONE,
+		"missing component has no record");
+
+	eunion_sidecar_view copied;
+	memcpy(copied, view, sizeof(copied));
+	require(eunion_sidecar_lookup_path(copied, "/missing", &lookup) == -EINVAL,
+		"copied view fails owner-address validation");
+	require(eunion_sidecar_view_close(view) == 0, "close shared view");
+	require(eunion_sidecar_view_open(view, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == -EINVAL,
+		"released view cannot be reopened");
+
+	int lower_file = open(lower_deleted,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(lower_file >= 0 && write(lower_file, "lower", 5) == 5 &&
+		fsync(lower_file) == 0 && close(lower_file) == 0,
+		"create lower whiteout target");
+	eunion_sidecar_view writer = {{0}};
+	require(eunion_sidecar_view_open(writer, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"open exclusive mutation view");
+	require(eunion_sidecar_publish_whiteout(writer, "/deleted") == 0,
+		"publish typed whiteout");
+	require(eunion_sidecar_view_close(writer) == 0,
+		"close whiteout writer");
+	require(lstat(upper_deleted, &status) == -1 && errno == ENOENT,
+		"whiteout publishes no upper placeholder");
+	eunion_sidecar_view whiteout_reader = {{0}};
+	require(eunion_sidecar_view_open(whiteout_reader, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open whiteout reader");
+	require(eunion_sidecar_lookup_path(whiteout_reader,
+		"/deleted", &lookup) == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_WHITEOUT,
+		"lookup observes exact whiteout record");
+	require(eunion_sidecar_publish_whiteout(whiteout_reader,
+		"/deleted") == -EBUSY,
+		"shared view cannot mutate records");
+	require(eunion_sidecar_view_close(whiteout_reader) == 0,
+		"close whiteout reader");
+
+	eunion_sidecar_view clearer = {{0}};
+	require(eunion_sidecar_view_open(clearer, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"open clear writer");
+	require(eunion_sidecar_clear_whiteout(clearer, "/deleted") == 0,
+		"clear exact whiteout record");
+	require(eunion_sidecar_view_close(clearer) == 0,
+		"close clear writer");
+	eunion_sidecar_view cleared_reader = {{0}};
+	require(eunion_sidecar_view_open(cleared_reader, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open cleared reader");
+	require(eunion_sidecar_lookup_path(cleared_reader,
+		"/deleted", &lookup) == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_NONE,
+		"cleared record exposes no semantic sidecar state");
+	require(eunion_sidecar_view_close(cleared_reader) == 0,
+		"close cleared reader");
+
+	require(mkdir(upper_recreated, 0700) == 0 &&
+		mkdir(lower_recreated, 0700) == 0,
+		"create recreated directory pair");
+	int recreated_child = open(lower_recreated_child,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(recreated_child >= 0 &&
+		write(recreated_child, "lower", 5) == 5 &&
+		fsync(recreated_child) == 0 && close(recreated_child) == 0,
+		"create recreated lower child");
+	eunion_sidecar_view subtree_writer = {{0}};
+	require(eunion_sidecar_view_open(subtree_writer, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"open subtree writer");
+	require(eunion_sidecar_publish_whiteout(
+		subtree_writer, "/recreated/child") == 0,
+		"publish nested whiteout");
+	require(eunion_sidecar_publish_whiteout(
+		subtree_writer, "/recreated") == 0,
+		"publish parent whiteout");
+	require(eunion_sidecar_clear_whiteout(
+		subtree_writer, "/recreated") == 0,
+		"recreate parent record");
+	require(eunion_sidecar_view_close(subtree_writer) == 0,
+		"close subtree writer");
+	eunion_sidecar_view subtree_reader = {{0}};
+	require(eunion_sidecar_view_open(subtree_reader, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open subtree reader");
+	require(eunion_sidecar_lookup_path(
+		subtree_reader, "/recreated/child", &lookup) == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_NONE,
+		"recreate cannot inherit stale descendant whiteouts");
+	require(eunion_sidecar_view_close(subtree_reader) == 0,
+		"close subtree reader");
+
+	require(mkdir(upper_opaque, 0700) == 0 &&
+		mkdir(lower_opaque, 0700) == 0,
+		"create opaque directory pair");
+	eunion_sidecar_view opaque_writer = {{0}};
+	require(eunion_sidecar_view_open(opaque_writer, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"open opaque writer");
+	require(eunion_sidecar_publish_opaque(opaque_writer, "/opaque") == 0,
+		"publish typed opaque record");
+	require(eunion_sidecar_view_close(opaque_writer) == 0,
+		"close opaque writer");
+	eunion_sidecar_view opaque_reader = {{0}};
+	require(eunion_sidecar_view_open(opaque_reader, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open opaque reader");
+	require(eunion_sidecar_lookup_path(opaque_reader,
+		"/opaque", &lookup) == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_OPAQUE,
+		"lookup observes identity-bound opaque record");
+	require(eunion_sidecar_view_close(opaque_reader) == 0,
+		"close opaque reader");
+
+	mode_t old_umask = umask(0777);
+	int created = eunion_sidecar_open_create(&runtime, "/created",
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(created >= 0 && write(created, "create", 6) == 6 &&
+		fsync(created) == 0 && close(created) == 0,
+		"hostile umask cannot break transactional create");
+	require(umask(old_umask) == 0777, "restore umask");
+	int symlink_create_result = eunion_sidecar_symlink_create(
+		&runtime, "created", "/link");
+	if (symlink_create_result < 0)
+		fprintf(stderr, "symlink create result=%d\n",
+			symlink_create_result);
+	require(symlink_create_result == 0,
+		"transactional symlink create");
+	char target[64];
+	ssize_t target_length = readlink(
+		upper_link, target, sizeof(target) - 1);
+	require(target_length == 7, "read created symlink");
+	target[target_length] = '\0';
+	require(strcmp(target, "created") == 0,
+		"symlink target preserved");
+	require(eunion_sidecar_link_create(
+		&runtime, "/created", "/hardlink", 0) == 0,
+		"transactional hardlink create");
+	struct stat created_status;
+	struct stat hardlink_status;
+	require(lstat(upper_created, &created_status) == 0 &&
+		lstat(upper_hardlink, &hardlink_status) == 0 &&
+		created_status.st_dev == hardlink_status.st_dev &&
+		created_status.st_ino == hardlink_status.st_ino,
+		"hardlink identity preserved");
+	require(eunion_sidecar_mknod_create(
+		&runtime, "/fifo", S_IFIFO | 0600, 0) == 0 &&
+		lstat(upper_fifo, &status) == 0 && S_ISFIFO(status.st_mode),
+		"transactional fifo create");
+	int socket_descriptor = socket(AF_UNIX,
+		SOCK_STREAM | SOCK_CLOEXEC, 0);
+	require(socket_descriptor >= 0,
+		"create transactional unix socket");
+	require(eunion_sidecar_socket_bind_create(
+		&runtime, "/socket", socket_descriptor) == 0 &&
+		lstat(upper_socket, &status) == 0 && S_ISSOCK(status.st_mode),
+		"transactional unix socket bind");
+	require(close(socket_descriptor) == 0,
+		"close transactional unix socket");
+
+	mode_t tree_umask = umask(0777);
+	require(eunion_sidecar_copy_up_tree(&runtime, "/tree") == 0,
+		"copy up complete rename tree");
+	require(umask(tree_umask) == 0777,
+		"restore hostile tree-copy umask");
+	require(lstat(upper_tree, &status) == 0 && S_ISDIR(status.st_mode),
+		"rename tree exists in upper");
+	char metadata_value[16] = {0};
+	struct stat lower_tree_status;
+	require(lstat(lower_tree, &lower_tree_status) == 0 &&
+		(status.st_mode & 07777) == 0777 &&
+		status.st_uid == lower_tree_status.st_uid &&
+		status.st_gid == lower_tree_status.st_gid &&
+		status.st_mtim.tv_sec == lower_tree_status.st_mtim.tv_sec &&
+		status.st_mtim.tv_nsec == lower_tree_status.st_mtim.tv_nsec &&
+		getxattr(upper_tree, "user.review", metadata_value,
+			sizeof(metadata_value)) == 9 &&
+		memcmp(metadata_value, "preserved", 9) == 0,
+		"copy-up preserves directory mode, ownership, timestamps and xattrs");
+	require(lstat(upper_tree, &status) == 0 &&
+			lstat(upper_tree_child, &status) == 0 &&
+			S_ISREG(status.st_mode),
+		"tree copy-up materializes descendants at the source");
+	require(eunion_sidecar_rename_path(
+		&runtime, "/tree", "/moved") == 0,
+		"transactional subtree rename");
+	require(lstat(upper_tree, &status) == -1 && errno == ENOENT,
+		"rename removes old upper name");
+	require(lstat(upper_moved, &status) == 0 && S_ISDIR(status.st_mode) &&
+		lstat(upper_moved_child, &status) == 0 &&
+		S_ISREG(status.st_mode),
+		"rename moves full backing subtree");
+	eunion_sidecar_view rename_reader = {{0}};
+	require(eunion_sidecar_view_open(rename_reader, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open rename result reader");
+	require(eunion_sidecar_lookup_path(rename_reader,
+		"/tree", &lookup) == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_WHITEOUT,
+		"rename masks lower source");
+	require(eunion_sidecar_lookup_path(rename_reader,
+		"/moved", &lookup) == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_NONE,
+		"renamed destination is visible index");
+	int moved_child_lookup = eunion_sidecar_lookup_path(rename_reader,
+		"/moved/child", &lookup);
+	if (moved_child_lookup < 0 ||
+		lookup.kind != EUNION_SIDECAR_RECORD_NONE)
+		fprintf(stderr, "moved child lookup=%d kind=%d\n",
+			moved_child_lookup, (int)lookup.kind);
+	require(moved_child_lookup == 0 &&
+		lookup.kind == EUNION_SIDECAR_RECORD_NONE,
+		"renamed sidecar subtree follows destination");
+	require(eunion_sidecar_view_close(rename_reader) == 0,
+		"close rename result reader");
+
+	require(eunion_sidecar_copy_up_tree(
+		&runtime, "/merged-tree") == 0,
+		"materialize complete pre-existing merged tree");
+	require(lstat(upper_merged_child, &status) == 0 &&
+		lstat(upper_merged_lower_child, &status) == 0,
+		"merged tree materialization preserves upper and lower children");
+	require(eunion_sidecar_rename_path(
+		&runtime, "/merged-tree", "/merged-moved") == 0,
+		"rename pre-existing merged tree");
+	require(lstat(upper_merged_tree, &status) == -1 && errno == ENOENT &&
+		lstat(upper_merged_moved, &status) == 0 &&
+		lstat(upper_merged_moved_upper_child, &status) == 0 &&
+		lstat(upper_merged_moved_lower_child, &status) == 0,
+		"renamed merged tree retains every visible child");
+
+	require(mkdir(lower_locked_tree, 0700) == 0,
+		"create locked lower tree");
+	int locked_child = open(lower_locked_child,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(locked_child >= 0 &&
+		write(locked_child, "locked", 6) == 6 &&
+		fsync(locked_child) == 0 && close(locked_child) == 0,
+		"create locked lower child");
+	require(chmod(lower_locked_tree, 0000) == 0,
+		"protect lower tree without live permission lift");
+	struct stat locked_before;
+	struct stat locked_after;
+	require(lstat(lower_locked_tree, &locked_before) == 0,
+		"snapshot locked lower tree");
+	require(eunion_sidecar_copy_up_tree(
+		&runtime, "/locked-tree") == -EACCES,
+		"unreadable lower tree did not fail closed");
+	require(lstat(lower_locked_tree, &locked_after) == 0 &&
+			(locked_after.st_mode & 07777) == 0000 &&
+			locked_before.st_ctim.tv_sec ==
+				locked_after.st_ctim.tv_sec &&
+			locked_before.st_ctim.tv_nsec ==
+				locked_after.st_ctim.tv_nsec,
+		"failed tree copy-up changed lower permissions or ctime");
+	require(lstat(upper_locked_tree, &status) == -1 && errno == ENOENT,
+		"failed tree copy-up published a partial upper tree");
+	require(chmod(lower_locked_tree, 0700) == 0,
+		"restore locked lower fixture for cleanup");
+
+	require(symlink(sidecar, link) == 0, "create sidecar symlink");
+	struct eunion_sidecar_runtime symlink_runtime = runtime;
+	symlink_runtime.sidecar_root = link;
+	eunion_sidecar_view symlink_view = {{0}};
+	int symlink_result = eunion_sidecar_view_open(symlink_view,
+		&symlink_runtime, EUNION_SIDECAR_ACCESS_SHARED);
+	require(symlink_result == -ELOOP || symlink_result == -ENOTDIR,
+		"sidecar leaf symlink rejected");
+	require(symlink(root, intermediate_link) == 0,
+		"create intermediate sidecar symlink");
+	struct eunion_sidecar_runtime intermediate_runtime = runtime;
+	intermediate_runtime.sidecar_root = intermediate_sidecar;
+	eunion_sidecar_view intermediate_view = {{0}};
+	int intermediate_result = eunion_sidecar_view_open(
+		intermediate_view, &intermediate_runtime,
+		EUNION_SIDECAR_ACCESS_SHARED);
+	require(intermediate_result == -ELOOP ||
+			intermediate_result == -ENOTDIR,
+		"sidecar intermediate symlink rejected");
+
+	int descriptor = open(format, O_RDWR | O_CLOEXEC);
+	require(descriptor >= 0, "open format for corruption fixture");
+	unsigned char byte;
+	require(pread(descriptor, &byte, 1, 8) == 1,
+		"read format version byte");
+	byte ^= 0x80;
+	require(pwrite(descriptor, &byte, 1, 8) == 1 && fsync(descriptor) == 0,
+		"corrupt format durably");
+	require(close(descriptor) == 0, "close corrupt format");
+	eunion_sidecar_view corrupt = {{0}};
+	require(eunion_sidecar_view_open(corrupt, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == -EIO,
+		"corrupt format fails closed");
+
+	printf("EUNION_SIDECAR_STORAGE_OK checks=%d\n", checks);
+	remove_tree(root);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_swap_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_swap_test.c
new file mode 100644
index 0000000..39969f2
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_swap_test.c
@@ -0,0 +1,232 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+#include "eunion_sidecar_test_support.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static int checks;
+static char upper_remove[512];
+static char remove_parked[512];
+static char remove_replacement[512];
+static char upper_create[512];
+static char upper_copyup[512];
+static char upper_rename[512];
+static char rename_parked[512];
+static char rename_replacement[512];
+
+enum swap_case {
+	SWAP_NONE,
+	SWAP_REMOVE,
+	SWAP_CREATE,
+	SWAP_COPYUP,
+	SWAP_RENAME,
+};
+
+static enum swap_case active_case;
+
+static void require(int condition, const char* message)
+{
+	++checks;
+	if (!condition) {
+		fprintf(stderr, "eunion_sidecar_swap_test: %s (errno=%d)\n",
+			message, errno);
+		exit(1);
+	}
+}
+
+static void join_path(char* output, size_t capacity, const char* root,
+	const char* suffix)
+{
+	int length = snprintf(output, capacity, "%s%s", root, suffix);
+	require(length > 0 && (size_t)length < capacity, "path overflow");
+}
+
+static void make_file(const char* path, const char* content)
+{
+	int descriptor = open(path,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(descriptor >= 0, "create swap fixture");
+	size_t length = strlen(content);
+	require(write(descriptor, content, length) == (ssize_t)length &&
+		fsync(descriptor) == 0 && close(descriptor) == 0,
+		"persist swap fixture");
+}
+
+static void require_file(const char* path, const char* content)
+{
+	int descriptor = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	require(descriptor >= 0, "open swap result");
+	char observed[64] = {0};
+	ssize_t length = read(descriptor, observed, sizeof(observed));
+	require(close(descriptor) == 0, "close swap result");
+	require(length == (ssize_t)strlen(content) &&
+		memcmp(observed, content, (size_t)length) == 0,
+		"swap result content mismatch");
+}
+
+static void swap_hook(enum eunion_sidecar_test_checkpoint checkpoint,
+	const char* guest_path)
+{
+	if (checkpoint != EUNION_SIDECAR_TEST_PRE_BACKING)
+		return;
+	switch (active_case) {
+	case SWAP_REMOVE:
+		require(strcmp(guest_path, "/remove") == 0,
+			"remove hook path mismatch");
+		require(rename(upper_remove, remove_parked) == 0 &&
+			rename(remove_replacement, upper_remove) == 0,
+			"replace remove leaf before backing mutation");
+		break;
+	case SWAP_CREATE:
+		require(strcmp(guest_path, "/create") == 0,
+			"create hook path mismatch");
+		make_file(upper_create, "attacker-create");
+		break;
+	case SWAP_COPYUP:
+		require(strcmp(guest_path, "/copyup") == 0,
+			"copy-up hook path mismatch");
+		make_file(upper_copyup, "attacker-copyup");
+		break;
+	case SWAP_RENAME:
+		require(strcmp(guest_path, "/rename") == 0,
+			"rename hook path mismatch");
+		require(rename(upper_rename, rename_parked) == 0 &&
+			rename(rename_replacement, upper_rename) == 0,
+			"replace rename source before backing mutation");
+		break;
+	default:
+		return;
+	}
+	active_case = SWAP_NONE;
+}
+
+static enum eunion_sidecar_record_kind lookup_kind(
+	const struct eunion_sidecar_runtime* runtime, const char* guest_path)
+{
+	eunion_sidecar_view view = {{0}};
+	require(eunion_sidecar_view_open(view, runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open swap evidence view");
+	struct eunion_sidecar_lookup lookup;
+	require(eunion_sidecar_lookup_path(view, guest_path, &lookup) == 0,
+		"lookup swap evidence");
+	require(eunion_sidecar_view_close(view) == 0,
+		"close swap evidence view");
+	return lookup.kind;
+}
+
+int main(void)
+{
+	char root[] = "/tmp/eunion-sidecar-swap.XXXXXX";
+	require(mkdtemp(root) != NULL, "mkdtemp");
+	char upper[512], lower[512], sidecar[512], journal[512];
+	char lower_copyup[512], upper_rename_destination[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(journal, sizeof(journal), sidecar, "/journal-v1");
+	join_path(upper_remove, sizeof(upper_remove), upper, "/remove");
+	join_path(remove_parked, sizeof(remove_parked), upper,
+		"/remove-parked");
+	join_path(remove_replacement, sizeof(remove_replacement), upper,
+		"/remove-replacement");
+	join_path(upper_create, sizeof(upper_create), upper, "/create");
+	join_path(upper_copyup, sizeof(upper_copyup), upper, "/copyup");
+	join_path(lower_copyup, sizeof(lower_copyup), lower, "/copyup");
+	join_path(upper_rename, sizeof(upper_rename), upper, "/rename");
+	join_path(rename_parked, sizeof(rename_parked), upper,
+		"/rename-parked");
+	join_path(rename_replacement, sizeof(rename_replacement), upper,
+		"/rename-replacement");
+	join_path(upper_rename_destination,
+		sizeof(upper_rename_destination), upper, "/renamed");
+	require(mkdir(upper, 0700) == 0 &&
+		mkdir(lower, 0700) == 0 &&
+		mkdir(sidecar, 0700) == 0,
+		"create swap roots");
+
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0 &&
+		eunion_sidecar_initialize(&runtime) == 0,
+		"initialize swap sidecar");
+	eunion_test_sidecar_checkpoint_hook = swap_hook;
+
+	make_file(upper_remove, "original-remove");
+	make_file(remove_replacement, "replacement-remove");
+	active_case = SWAP_REMOVE;
+	require(eunion_sidecar_remove_path(&runtime, "/remove", 0) ==
+		-EAGAIN, "remove accepted replaced leaf");
+	require_file(upper_remove, "replacement-remove");
+	require_file(remove_parked, "original-remove");
+	require(access(journal, F_OK) == -1 && errno == ENOENT,
+		"remove replacement left a transaction journal");
+	require(rename(upper_remove, remove_replacement) == 0 &&
+		rename(remove_parked, upper_remove) == 0,
+		"restore remove fixture");
+
+	active_case = SWAP_CREATE;
+	require(eunion_sidecar_open_create(&runtime, "/create",
+		O_WRONLY | O_CREAT | O_CLOEXEC, 0600) == -EAGAIN,
+		"create accepted an inserted destination");
+	require_file(upper_create, "attacker-create");
+	require(lookup_kind(&runtime, "/create") ==
+		EUNION_SIDECAR_RECORD_NONE,
+		"failed create published sidecar state");
+
+	make_file(lower_copyup, "lower-copyup");
+	active_case = SWAP_COPYUP;
+	require(eunion_sidecar_copy_up(&runtime, "/copyup") == -EAGAIN,
+		"copy-up accepted an inserted destination");
+	require_file(upper_copyup, "attacker-copyup");
+	require(lookup_kind(&runtime, "/copyup") ==
+		EUNION_SIDECAR_RECORD_NONE,
+		"failed copy-up published sidecar state");
+
+	int rename_descriptor = eunion_sidecar_open_create(
+		&runtime, "/rename",
+		O_WRONLY | O_CREAT | O_CLOEXEC, 0600);
+	require(rename_descriptor >= 0 &&
+		write(rename_descriptor, "original-rename", 15) == 15 &&
+		fsync(rename_descriptor) == 0 &&
+		close(rename_descriptor) == 0,
+		"create transactional rename source");
+	make_file(rename_replacement, "replacement-rename");
+	active_case = SWAP_RENAME;
+	require(eunion_sidecar_rename_path(
+		&runtime, "/rename", "/renamed") == -EAGAIN,
+		"rename accepted a replaced source");
+	require_file(upper_rename, "replacement-rename");
+	require_file(rename_parked, "original-rename");
+	struct stat status;
+	require(lstat(upper_rename_destination, &status) == -1 &&
+		errno == ENOENT,
+		"failed rename mutated its destination");
+	require(access(journal, F_OK) == -1 && errno == ENOENT,
+		"rename replacement left a transaction journal");
+	require(rename(upper_rename, rename_replacement) == 0 &&
+		rename(rename_parked, upper_rename) == 0,
+		"restore rename fixture");
+	require(lookup_kind(&runtime, "/rename") ==
+		EUNION_SIDECAR_RECORD_NONE,
+		"failed rename damaged source sidecar state");
+
+	eunion_test_sidecar_checkpoint_hook = NULL;
+	char command[640];
+	int length = snprintf(command, sizeof(command), "rm -rf -- '%s'", root);
+	require(length > 0 && (size_t)length < sizeof(command) &&
+		system(command) == 0, "cleanup swap fixture");
+	printf("EUNION_SIDECAR_SWAP_OK checks=%d cases=4\n", checks);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_test_support.h b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_test_support.h
new file mode 100644
index 0000000..74ef499
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_test_support.h
@@ -0,0 +1,65 @@
+#ifndef EUNION_SIDECAR_TEST_SUPPORT_H
+#define EUNION_SIDECAR_TEST_SUPPORT_H
+
+#include <fcntl.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int eunion_sidecar_test_write_prefix_state(
+	const struct eunion_sidecar_runtime* runtime)
+{
+	if (!runtime || !runtime->upper_root || !runtime->sidecar_root)
+		return -1;
+	struct stat upper;
+	struct stat sidecar;
+	if (stat(runtime->upper_root, &upper) != 0 ||
+		stat(runtime->sidecar_root, &sidecar) != 0)
+		return -1;
+	char path[EUNION_SIDECAR_PATH_MAX];
+	if (snprintf(path, sizeof(path), "%s/.darling-prefix-state-v3",
+			runtime->upper_root) >= (int)sizeof(path))
+		return -1;
+	char content[1024];
+	int length = snprintf(content, sizeof(content),
+		"DARLING_PREFIX_STATE_V3\n"
+		"schema_version=3\n"
+		"runtime_mode=rootless-eunion\n"
+		"generation=1\n"
+		"prefix_device=%ju\n"
+		"prefix_inode=%ju\n"
+		"sidecar_device=%ju\n"
+		"sidecar_inode=%ju\n"
+		"owner_uid=%ju\n"
+		"owner_gid=%ju\n"
+		"provenance=darling-runtime-prefix-sidecar-v1\n",
+		(uintmax_t)upper.st_dev, (uintmax_t)upper.st_ino,
+		(uintmax_t)sidecar.st_dev, (uintmax_t)sidecar.st_ino,
+		(uintmax_t)upper.st_uid, (uintmax_t)upper.st_gid);
+	if (length <= 0 || (size_t)length >= sizeof(content))
+		return -1;
+	int descriptor = open(path,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (descriptor < 0)
+		return -1;
+	size_t offset = 0;
+	while (offset < (size_t)length) {
+		ssize_t written = write(
+			descriptor, content + offset, (size_t)length - offset);
+		if (written < 0 && errno == EINTR)
+			continue;
+		if (written <= 0) {
+			close(descriptor);
+			return -1;
+		}
+		offset += (size_t)written;
+	}
+	if (fsync(descriptor) != 0 || close(descriptor) != 0)
+		return -1;
+	return 0;
+}
+
+#endif
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_vchroot_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_vchroot_test.c
new file mode 100644
index 0000000..9f27125
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_vchroot_test.c
@@ -0,0 +1,221 @@
+#define _GNU_SOURCE
+#define TEST 1
+#define EUNION 1
+
+#define main eunion_embedded_vchroot_main
+#include "../src/linux_premigration/vchroot_userspace.c"
+#undef main
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include "eunion_sidecar_test_support.h"
+
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	if (condition) {
+		++checks;
+		return;
+	}
+	fprintf(stderr, "eunion_sidecar_vchroot_test: %s (errno=%d)\n",
+		message, errno);
+	exit(1);
+}
+
+static void make_file(const char* path, const char* contents)
+{
+	int descriptor = open(path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+	require(descriptor >= 0, "create fixture file");
+	require(write(descriptor, contents, strlen(contents)) ==
+		(ssize_t)strlen(contents), "write fixture file");
+	require(fsync(descriptor) == 0, "fsync fixture file");
+	require(close(descriptor) == 0, "close fixture file");
+}
+
+static int contains_name(const char* names, int count, const char* wanted)
+{
+	for (int index = 0; index < count; ++index) {
+		if (strcmp(names, wanted) == 0)
+			return 1;
+		names += strlen(names) + 1;
+	}
+	return 0;
+}
+
+int main(void)
+{
+	char root[] = "/tmp/eunion-sidecar-vchroot.XXXXXX";
+	require(mkdtemp(root) != NULL, "create vchroot fixture");
+	char upper[512], lower[512], sidecar[512];
+	char lower_deleted[512], lower_copy[512], upper_copy[512];
+	char upper_opaque[512], lower_opaque[512];
+	char upper_visible[512], lower_hidden[512], legacy_work[512];
+	char lower_recreate[512], upper_recreate[512];
+	require(snprintf(upper, sizeof(upper), "%s/upper", root) > 0,
+		"construct upper path");
+	require(snprintf(lower, sizeof(lower), "%s/lower", root) > 0,
+		"construct lower path");
+	require(snprintf(sidecar, sizeof(sidecar),
+		"%s/upper.eunion-sidecar-v1", root) > 0,
+		"construct external sidecar path");
+	require(snprintf(lower_deleted, sizeof(lower_deleted),
+		"%s/deleted", lower) > 0, "construct deleted path");
+	require(snprintf(lower_copy, sizeof(lower_copy),
+		"%s/copied", lower) > 0, "construct lower copy path");
+	require(snprintf(upper_copy, sizeof(upper_copy),
+		"%s/copied", upper) > 0, "construct upper copy path");
+	require(snprintf(upper_opaque, sizeof(upper_opaque),
+		"%s/opaque", upper) > 0, "construct upper opaque path");
+	require(snprintf(lower_opaque, sizeof(lower_opaque),
+		"%s/opaque", lower) > 0, "construct lower opaque path");
+	require(snprintf(upper_visible, sizeof(upper_visible),
+		"%s/opaque/visible", upper) > 0, "construct upper visible path");
+	require(snprintf(lower_hidden, sizeof(lower_hidden),
+		"%s/opaque/hidden", lower) > 0, "construct lower hidden path");
+	require(snprintf(legacy_work, sizeof(legacy_work),
+		"%s/.union-work", upper) > 0, "construct legacy work path");
+	require(snprintf(lower_recreate, sizeof(lower_recreate),
+		"%s/recreate", lower) > 0, "construct lower recreate path");
+	require(snprintf(upper_recreate, sizeof(upper_recreate),
+		"%s/recreate", upper) > 0, "construct upper recreate path");
+	require(mkdir(upper, 0700) == 0, "create upper root");
+	require(mkdir(lower, 0700) == 0, "create lower root");
+	require(mkdir(sidecar, 0700) == 0, "create sidecar root");
+	make_file(lower_deleted, "lower");
+	make_file(lower_copy, "copy");
+	require(mkdir(lower_opaque, 0700) == 0, "create lower opaque");
+	make_file(lower_hidden, "lower");
+	make_file(lower_recreate, "lower");
+
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	memcpy(prefix_path, upper, strlen(upper) + 1);
+	prefix_path_len = (int)strlen(prefix_path);
+	set_libexec_path(lower);
+	eunion_sidecar_path[0] = '\0';
+	eunion_sidecar_path_len = -1;
+	int upper_descriptor = open(
+		upper, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+	require(upper_descriptor >= 0, "open retained upper descriptor");
+	require(eunion_init_from_prefix(upper_descriptor) ==
+		-EUNION_PREFIX_RECREATE_REQUIRED_ERROR,
+		"unversioned prefix fails with typed recreate verdict");
+	struct stat status;
+	require(lstat(sidecar, &status) == 0 && S_ISDIR(status.st_mode),
+		"legacy rejection does not mutate sidecar root");
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0,
+		"write sidecar-v1 prefix state");
+	require(eunion_sidecar_initialize(&runtime) == 0,
+		"initialize external sidecar");
+	require(eunion_init_from_prefix(upper_descriptor) == 0 &&
+		eunion_anchored_runtime.anchored,
+		"versioned prefix activates exact external sidecar");
+	require(mkdir(upper_opaque, 0700) == 0, "create upper opaque");
+	make_file(upper_visible, "upper");
+
+	require(eunion_sidecar_remove_path(
+		&runtime, "/deleted", 0) == 0,
+		"publish lower deletion through canonical remove");
+	require(eunion_is_whiteout("/deleted") == 1,
+		"vchroot whiteout lookup uses sidecar");
+	char names[4096] = {0};
+	int count = vchroot_readdir_merge("/", names, sizeof(names));
+	require(count >= 0 && !contains_name(names, count, "deleted"),
+		"merged readdir suppresses sidecar whiteout");
+	struct vchroot_expand_args expanded = {
+		.dfd = AT_FDCWD,
+		.flags = 0,
+	};
+	strcpy(expanded.path, "/deleted");
+	int expand_result = vchroot_expand(&expanded);
+	if (expand_result != -ENOENT)
+		fprintf(stderr, "expand_result=%d path=%s\n",
+			expand_result, expanded.path);
+	require(expand_result == -ENOENT,
+		"component resolver suppresses sidecar whiteout");
+	struct vchroot_expand_args sidecar_escape = {
+		.dfd = AT_FDCWD,
+		.flags = 0,
+	};
+	require(snprintf(sidecar_escape.path,
+			sizeof(sidecar_escape.path),
+			"/Volumes/SystemRoot%s", sidecar) > 0,
+		"construct SystemRoot sidecar escape");
+	require(vchroot_expand(&sidecar_escape) == -ENOENT,
+		"SystemRoot escape cannot enter external sidecar");
+
+	eunion_sidecar_view opaque = {{0}};
+	require(eunion_sidecar_view_open(opaque, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"open opaque writer");
+	require(eunion_sidecar_publish_opaque(opaque, "/opaque") == 0,
+		"publish sidecar opacity");
+	require(eunion_sidecar_view_close(opaque) == 0,
+		"close opaque writer");
+	memset(names, 0, sizeof(names));
+	count = vchroot_readdir_merge("/opaque", names, sizeof(names));
+	require(count == 1 && contains_name(names, count, "visible") &&
+		!contains_name(names, count, "hidden"),
+		"opaque sidecar record suppresses lower enumeration");
+
+	require(vchroot_copyup("/copied") == 0,
+		"copy-up succeeds with external sidecar staging");
+	require(lstat(upper_copy, &status) == 0 && S_ISREG(status.st_mode),
+		"copy-up publishes upper file");
+	require(lstat(legacy_work, &status) == -1 && errno == ENOENT,
+		"sidecar copy-up creates no guest-visible work directory");
+
+	eunion_sidecar_view recreate_writer = {{0}};
+	require(eunion_sidecar_view_open(recreate_writer, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"open recreate whiteout writer");
+	require(eunion_sidecar_publish_whiteout(
+		recreate_writer, "/recreate") == 0,
+		"publish recreate whiteout");
+	require(eunion_sidecar_view_close(recreate_writer) == 0,
+		"close recreate whiteout writer");
+	int recreate_fd = vchroot_open_create(
+		"/recreate", O_WRONLY | O_CREAT | O_EXCL, 0600);
+	if (recreate_fd < 0)
+		fprintf(stderr, "recreate_fd=%d\n", recreate_fd);
+	require(recreate_fd >= 0,
+		"managed open-create commits through sidecar journal");
+	require(write(recreate_fd, "new", 3) == 3 &&
+		fsync(recreate_fd) == 0 && close(recreate_fd) == 0,
+		"write recreated upper file");
+	require(lstat(upper_recreate, &status) == 0 &&
+		S_ISREG(status.st_mode),
+		"recreate publishes upper backing");
+	eunion_sidecar_view recreate_reader = {{0}};
+	require(eunion_sidecar_view_open(recreate_reader, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open recreated reader");
+	struct eunion_sidecar_lookup recreated_lookup;
+	require(eunion_sidecar_lookup_path(recreate_reader,
+		"/recreate", &recreated_lookup) == 0 &&
+		recreated_lookup.kind == EUNION_SIDECAR_RECORD_NONE,
+		"successful create retires whiteout atomically");
+	require(eunion_sidecar_view_close(recreate_reader) == 0,
+		"close recreated reader");
+	require(eunion_sidecar_runtime_release(
+			&eunion_anchored_runtime) == 0,
+		"release anchored vchroot runtime");
+	require(close(upper_descriptor) == 0,
+		"close retained upper descriptor");
+
+	char command[640];
+	require(snprintf(command, sizeof(command), "rm -rf -- '%s'", root) > 0,
+		"construct cleanup command");
+	require(system(command) == 0, "remove vchroot fixture");
+	printf("EUNION_SIDECAR_VCHROOT_OK checks=%d\n", checks);
+	return 0;
+}
