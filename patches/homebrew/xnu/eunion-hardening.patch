+	int result = LINUX_SYSCALL(__NR_lseek, descriptor, 0, 0);
+	if (result < 0)
+		return result;
+	result = eunion_next_directory_entry(descriptor, buffer,
+		sizeof(buffer), &length, &offset, &observed);
+	if (result <= 0)
+		return result;
