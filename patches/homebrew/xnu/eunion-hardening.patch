diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_concurrency_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_concurrency_test.c
new file mode 100644
index 0000000..8aa6e35
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_concurrency_test.c
@@ -0,0 +1,338 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+#include "eunion_sidecar_test_support.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+enum primary_operation {
+	PRIMARY_REMOVE = 0,
+	PRIMARY_CREATE,
+	PRIMARY_COPY_UP,
+	PRIMARY_RENAME,
+};
+
+enum competing_operation {
+	COMPETING_LOOKUP = 0,
+	COMPETING_OPEN_CREATE,
+	COMPETING_UNLINK,
+	COMPETING_RMDIR,
+	COMPETING_RENAME,
+	COMPETING_COPY_UP,
+	COMPETING_COUNT,
+};
+
+static enum eunion_sidecar_test_checkpoint pause_checkpoint;
+static int checkpoint_ready = -1;
+static int checkpoint_release = -1;
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	if (condition) {
+		++checks;
+		return;
+	}
+	fprintf(stderr,
+		"eunion_sidecar_concurrency_test: %s (errno=%d)\n",
+		message, errno);
+	exit(1);
+}
+
+static void join_path(char* output, size_t capacity,
+	const char* root, const char* suffix)
+{
+	int length = snprintf(output, capacity, "%s%s", root, suffix);
+	require(length > 0 && (size_t)length < capacity, "construct path");
+}
+
+static void write_file(const char* path)
+{
+	int descriptor = open(path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+	require(descriptor >= 0, "create fixture file");
+	require(write(descriptor, "x", 1) == 1 &&
+			fsync(descriptor) == 0 && close(descriptor) == 0,
+		"persist fixture file");
+}
+
+static void send_byte(int descriptor)
+{
+	char byte = 'R';
+	require(write(descriptor, &byte, 1) == 1,
+		"send synchronization byte");
+}
+
+static void receive_byte(int descriptor)
+{
+	char byte;
+	require(read(descriptor, &byte, 1) == 1,
+		"receive synchronization byte");
+}
+
+static void send_result(int descriptor, int result)
+{
+	require(write(descriptor, &result, sizeof(result)) ==
+			(ssize_t)sizeof(result),
+		"send operation result");
+}
+
+static int receive_result(int descriptor)
+{
+	int result;
+	require(read(descriptor, &result, sizeof(result)) ==
+			(ssize_t)sizeof(result),
+		"receive operation result");
+	return result;
+}
+
+static void pause_at_checkpoint(
+	enum eunion_sidecar_test_checkpoint checkpoint,
+	const char* guest_path)
+{
+	(void)guest_path;
+	if (checkpoint != pause_checkpoint)
+		return;
+	send_byte(checkpoint_ready);
+	receive_byte(checkpoint_release);
+}
+
+static void require_blocked(int descriptor)
+{
+	struct pollfd event = {
+		.fd = descriptor,
+		.events = POLLIN,
+	};
+	int result;
+	do {
+		result = poll(&event, 1, 100);
+	} while (result < 0 && errno == EINTR);
+	require(result == 0,
+		"concurrent operation escaped exclusive transaction lock");
+}
+
+static void wait_success(pid_t child, const char* message)
+{
+	int status;
+	require(waitpid(child, &status, 0) == child &&
+			WIFEXITED(status) && WEXITSTATUS(status) == 0,
+		message);
+}
+
+static int run_competing(
+	enum competing_operation operation,
+	const struct eunion_sidecar_runtime* runtime)
+{
+	switch (operation) {
+		case COMPETING_LOOKUP: {
+			eunion_sidecar_view reader = {{0}};
+			int result = eunion_sidecar_view_open(reader, runtime,
+				EUNION_SIDECAR_ACCESS_SHARED);
+			if (result < 0)
+				return result;
+			struct eunion_sidecar_lookup lookup;
+			result = eunion_sidecar_lookup_path(
+				reader, "/parallel-copy", &lookup);
+			int close_result = eunion_sidecar_view_close(reader);
+			return result < 0 ? result : close_result;
+		}
+		case COMPETING_OPEN_CREATE: {
+			int descriptor = eunion_sidecar_open_create(runtime,
+				"/parallel-create",
+				O_WRONLY | O_CREAT | O_EXCL, 0600);
+			if (descriptor < 0)
+				return descriptor;
+			return close(descriptor) == 0 ? 0 : -errno;
+		}
+		case COMPETING_UNLINK:
+			return eunion_sidecar_remove_path(
+				runtime, "/parallel-remove", 0);
+		case COMPETING_RMDIR:
+			return eunion_sidecar_remove_path(
+				runtime, "/parallel-dir", 1);
+		case COMPETING_RENAME:
+			return eunion_sidecar_rename_path(
+				runtime, "/parallel-old", "/parallel-new");
+		case COMPETING_COPY_UP:
+			return eunion_sidecar_copy_up(
+				runtime, "/parallel-copy");
+		case COMPETING_COUNT:
+		default:
+			return -EINVAL;
+	}
+}
+
+static int run_primary(enum primary_operation operation,
+	const struct eunion_sidecar_runtime* runtime)
+{
+	switch (operation) {
+		case PRIMARY_REMOVE:
+			return eunion_sidecar_remove_path(runtime, "/victim", 0);
+		case PRIMARY_CREATE:
+			return eunion_sidecar_mkdir_create(runtime, "/victim", 0700);
+		case PRIMARY_COPY_UP:
+			return eunion_sidecar_copy_up(runtime, "/victim");
+		case PRIMARY_RENAME:
+			return eunion_sidecar_rename_path(
+				runtime, "/victim", "/renamed");
+		default:
+			return -EINVAL;
+	}
+}
+
+static void run_case(enum primary_operation operation,
+	enum eunion_sidecar_test_checkpoint checkpoint)
+{
+	char root[] = "/tmp/eunion-sidecar-concurrency.XXXXXX";
+	require(mkdtemp(root) != NULL, "create concurrency fixture");
+	char upper[512], lower[512], sidecar[512];
+	char upper_victim[512], lower_victim[512];
+	char parallel_remove[512], parallel_dir[512];
+	char parallel_old[512], parallel_copy[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(upper_victim, sizeof(upper_victim), upper, "/victim");
+	join_path(lower_victim, sizeof(lower_victim), lower, "/victim");
+	join_path(parallel_remove, sizeof(parallel_remove),
+		upper, "/parallel-remove");
+	join_path(parallel_dir, sizeof(parallel_dir), upper, "/parallel-dir");
+	join_path(parallel_old, sizeof(parallel_old), upper, "/parallel-old");
+	join_path(parallel_copy, sizeof(parallel_copy), lower, "/parallel-copy");
+	require(mkdir(upper, 0700) == 0 &&
+			mkdir(lower, 0700) == 0 &&
+			mkdir(sidecar, 0700) == 0,
+		"create concurrency roots");
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0 &&
+			eunion_sidecar_initialize(&runtime) == 0,
+		"initialize concurrency sidecar");
+	if (operation == PRIMARY_REMOVE) {
+		write_file(upper_victim);
+		write_file(lower_victim);
+	} else if (operation == PRIMARY_COPY_UP) {
+		write_file(lower_victim);
+	} else if (operation == PRIMARY_RENAME) {
+		write_file(lower_victim);
+		require(eunion_sidecar_copy_up(&runtime, "/victim") == 0,
+			"copy up primary rename source");
+	}
+	write_file(parallel_remove);
+	require(mkdir(parallel_dir, 0700) == 0,
+		"create competing empty directory");
+	int parallel_old_descriptor = eunion_sidecar_open_create(&runtime,
+		"/parallel-old", O_WRONLY | O_CREAT | O_EXCL, 0600);
+	require(parallel_old_descriptor >= 0 &&
+			close(parallel_old_descriptor) == 0,
+		"create competing rename source through sidecar");
+	write_file(parallel_copy);
+
+	int ready[2], release[2];
+	require(pipe(ready) == 0 && pipe(release) == 0,
+		"create primary checkpoint pipes");
+	pid_t primary = fork();
+	require(primary >= 0, "fork primary transaction");
+	if (primary == 0) {
+		pause_checkpoint = checkpoint;
+		checkpoint_ready = ready[1];
+		checkpoint_release = release[0];
+		eunion_test_sidecar_checkpoint_hook = pause_at_checkpoint;
+		int result = run_primary(operation, &runtime);
+		_exit(result == 0 || result >= 0 ? 0 : 20);
+	}
+	receive_byte(ready[0]);
+
+	pid_t competitors[COMPETING_COUNT];
+	int completed[COMPETING_COUNT][2];
+	for (int competitor = 0; competitor < COMPETING_COUNT; ++competitor) {
+		require(pipe(completed[competitor]) == 0,
+			"create competing completion pipe");
+		competitors[competitor] = fork();
+		require(competitors[competitor] >= 0,
+			"fork competing operation");
+		if (competitors[competitor] == 0) {
+			int result = run_competing(
+				(enum competing_operation)competitor, &runtime);
+			send_result(completed[competitor][1], result);
+			_exit(result >= 0 ? 0 : 30);
+		}
+		require_blocked(completed[competitor][0]);
+	}
+	send_byte(release[1]);
+	wait_success(primary, "primary transaction failed");
+	for (int competitor = 0; competitor < COMPETING_COUNT; ++competitor) {
+		int result = receive_result(completed[competitor][0]);
+		if (result < 0)
+			fprintf(stderr,
+				"competing operation=%d result=%d phase=%d primary=%d\n",
+				competitor, result, checkpoint, operation);
+		require(result >= 0,
+			"competing operation failed after serialization");
+		wait_success(competitors[competitor],
+			"competing operation failed after serialization");
+		close(completed[competitor][0]);
+		close(completed[competitor][1]);
+	}
+	close(ready[0]);
+	close(ready[1]);
+	close(release[0]);
+	close(release[1]);
+
+	eunion_sidecar_view quiescent = {{0}};
+	require(eunion_sidecar_view_open(quiescent, &runtime,
+			EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0 &&
+			eunion_sidecar_view_close(quiescent) == 0,
+		"concurrent fixture did not recover to quiescent state");
+	char command[640];
+	require(snprintf(command, sizeof(command), "rm -rf -- '%s'", root) > 0,
+		"construct concurrency cleanup");
+	require(system(command) == 0, "remove concurrency fixture");
+}
+
+int main(void)
+{
+	static const enum eunion_sidecar_test_checkpoint remove_phases[] = {
+		EUNION_SIDECAR_TEST_RESOLVED,
+		EUNION_SIDECAR_TEST_JOURNAL_PREPARED,
+		EUNION_SIDECAR_TEST_LOGICALLY_PUBLISHED,
+		EUNION_SIDECAR_TEST_PRE_BACKING,
+		EUNION_SIDECAR_TEST_BACKING_COMMITTED,
+		EUNION_SIDECAR_TEST_DURABLE,
+	};
+	static const enum eunion_sidecar_test_checkpoint backing_first_phases[] = {
+		EUNION_SIDECAR_TEST_RESOLVED,
+		EUNION_SIDECAR_TEST_JOURNAL_PREPARED,
+		EUNION_SIDECAR_TEST_PRE_BACKING,
+		EUNION_SIDECAR_TEST_POST_BACKING_PRE_JOURNAL,
+		EUNION_SIDECAR_TEST_BACKING_COMMITTED,
+		EUNION_SIDECAR_TEST_DURABLE,
+	};
+	for (size_t phase = 0;
+			phase < sizeof(remove_phases) / sizeof(remove_phases[0]);
+			++phase)
+		run_case(PRIMARY_REMOVE, remove_phases[phase]);
+	for (enum primary_operation operation = PRIMARY_CREATE;
+			operation <= PRIMARY_RENAME; ++operation) {
+		for (size_t phase = 0;
+				phase < sizeof(backing_first_phases) /
+					sizeof(backing_first_phases[0]);
+				++phase)
+			run_case(operation, backing_first_phases[phase]);
+	}
+	printf("EUNION_SIDECAR_CONCURRENCY_OK checks=%d phases=24"
+		" competing_operations=%d\n", checks, COMPETING_COUNT);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_contract_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_contract_test.c
new file mode 100644
index 0000000..cb45de3
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_contract_test.c
@@ -0,0 +1,326 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+#include "eunion_sidecar_test_support.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static int failures;
+static char protected_payload[512];
+static int protected_payload_read;
+static int concurrent_directory = -1;
+static int concurrent_chmod_count;
+
+static void check(int condition, const char* message)
+{
+	if (condition)
+		return;
+	++failures;
+	fprintf(stderr, "EUNION_SIDECAR_RED %s\n", message);
+}
+
+static void join_path(char* output, size_t capacity, const char* root,
+	const char* suffix)
+{
+	int length = snprintf(output, capacity, "%s%s", root, suffix);
+	if (length <= 0 || (size_t)length >= capacity) {
+		perror("path overflow");
+		exit(2);
+	}
+}
+
+static void make_file(const char* path, const char* contents)
+{
+	int descriptor = open(path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+	if (descriptor < 0 ||
+		write(descriptor, contents, strlen(contents)) !=
+			(ssize_t)strlen(contents) ||
+		fsync(descriptor) != 0 || close(descriptor) != 0) {
+		perror("make file");
+		exit(2);
+	}
+}
+
+static void cleanup(const char* root, const char* secret)
+{
+	chmod(secret, 0700);
+	char command[640];
+	int length = snprintf(command, sizeof(command), "rm -rf -- '%s'", root);
+	if (length <= 0 || (size_t)length >= sizeof(command) ||
+		system(command) != 0) {
+		perror("cleanup");
+		exit(2);
+	}
+}
+
+static void sidecar_checkpoint_hook(
+	enum eunion_sidecar_test_checkpoint checkpoint,
+	const char* guest_path)
+{
+	if (checkpoint != EUNION_SIDECAR_TEST_PRE_BACKING ||
+		strcmp(guest_path, "/chmod-race") != 0)
+		return;
+	if (fchmod(concurrent_directory, 0711) != 0) {
+		perror("concurrent chmod");
+		exit(2);
+	}
+	++concurrent_chmod_count;
+}
+
+static enum eunion_sidecar_record_kind sidecar_kind(
+	const struct eunion_sidecar_runtime* runtime, const char* guest_path)
+{
+	eunion_sidecar_view view = {{0}};
+	check(eunion_sidecar_view_open(view, runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open sidecar evidence view");
+	struct eunion_sidecar_lookup lookup;
+	check(eunion_sidecar_lookup_path(view, guest_path, &lookup) == 0,
+		"read sidecar evidence");
+	check(eunion_sidecar_view_close(view) == 0,
+		"close sidecar evidence view");
+	return lookup.kind;
+}
+
+int main(void)
+{
+	char root[] = "/tmp/eunion-sidecar-contract.XXXXXX";
+	if (!mkdtemp(root)) {
+		perror("mkdtemp");
+		return 2;
+	}
+	char upper[512];
+	char lower[512];
+	char sidecar[512];
+	char lower_file[512];
+	char upper_file[512];
+	char secret[512];
+	char chmod_race[512];
+	char chmod_payload[512];
+	char merged_upper[512];
+	char merged_lower[512];
+	char recursive_upper[512];
+	char recursive_lower[512];
+	char recursive_lower_child[512];
+	char parent0300_upper[512];
+	char parent0300_lower[512];
+	char parent0300_upper_child[512];
+	char parent0300_lower_child[512];
+	char hostile_lower[512];
+	char hostile_upper[512];
+	char opaque_upper[512];
+	char opaque_lower[512];
+	char opaque_hidden[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(lower_file, sizeof(lower_file), lower, "/deleted");
+	join_path(upper_file, sizeof(upper_file), upper, "/deleted");
+	join_path(secret, sizeof(secret), upper, "/secret");
+	join_path(protected_payload, sizeof(protected_payload), secret, "/payload");
+	join_path(chmod_race, sizeof(chmod_race), upper, "/chmod-race");
+	join_path(chmod_payload, sizeof(chmod_payload),
+		chmod_race, "/payload");
+	join_path(merged_upper, sizeof(merged_upper), upper, "/merged-empty");
+	join_path(merged_lower, sizeof(merged_lower), lower, "/merged-empty");
+	join_path(recursive_upper, sizeof(recursive_upper),
+		upper, "/recursive");
+	join_path(recursive_lower, sizeof(recursive_lower),
+		lower, "/recursive");
+	join_path(recursive_lower_child, sizeof(recursive_lower_child),
+		lower, "/recursive/child");
+	join_path(parent0300_upper, sizeof(parent0300_upper),
+		upper, "/parent0300");
+	join_path(parent0300_lower, sizeof(parent0300_lower),
+		lower, "/parent0300");
+	join_path(parent0300_upper_child, sizeof(parent0300_upper_child),
+		upper, "/parent0300/child");
+	join_path(parent0300_lower_child, sizeof(parent0300_lower_child),
+		lower, "/parent0300/child");
+	join_path(hostile_lower, sizeof(hostile_lower),
+		lower, "/hostile-umask");
+	join_path(hostile_upper, sizeof(hostile_upper),
+		upper, "/hostile-umask");
+	join_path(opaque_upper, sizeof(opaque_upper),
+		upper, "/opaque-parent");
+	join_path(opaque_lower, sizeof(opaque_lower),
+		lower, "/opaque-parent");
+	join_path(opaque_hidden, sizeof(opaque_hidden),
+		lower, "/opaque-parent/hidden");
+	if (mkdir(upper, 0700) || mkdir(lower, 0700) || mkdir(sidecar, 0700)) {
+		perror("mkdir");
+		return 2;
+	}
+
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	check(eunion_sidecar_test_write_prefix_state(&runtime) == 0,
+		"write sidecar-v1 prefix state");
+	check(eunion_sidecar_initialize(&runtime) == 0,
+		"initialize external sidecar");
+	check(mkdir(secret, 0700) == 0,
+		"create protected directory after format activation");
+
+	make_file(lower_file, "lower");
+	int result = eunion_sidecar_remove_path(&runtime, "/deleted", 0);
+	struct stat status;
+	int physical_whiteout = lstat(upper_file, &status) == 0;
+	check(result == 0, "lower-only unlink must succeed");
+	check(!physical_whiteout,
+		"new unlink must not publish a physical whiteout object");
+
+	make_file(protected_payload, "secret");
+	if (chmod(secret, 0000) != 0 || lstat(secret, &status) != 0) {
+		perror("protect secret directory");
+		return 2;
+	}
+	struct timespec before_ctime = status.st_ctim;
+	protected_payload_read = 0;
+	result = eunion_sidecar_remove_path(&runtime, "/secret", 1);
+	if (lstat(secret, &status) != 0) {
+		perror("stat protected directory");
+		return 2;
+	}
+	int ctime_preserved =
+		before_ctime.tv_sec == status.st_ctim.tv_sec &&
+		before_ctime.tv_nsec == status.st_ctim.tv_nsec;
+	check(result == -ENOTEMPTY,
+		"mode-000 nonempty rmdir must return ENOTEMPTY");
+	check(protected_payload_read == 0,
+		"concurrent code must not gain read access during failed rmdir");
+	check((status.st_mode & 0777) == 0000,
+		"failed rmdir must preserve the exact directory mode");
+	check(ctime_preserved,
+		"failed rmdir must preserve directory ctime");
+
+	check(mkdir(chmod_race, 0700) == 0,
+		"create concurrent chmod directory");
+	make_file(chmod_payload, "payload");
+	concurrent_directory = open(chmod_race,
+		O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	check(concurrent_directory >= 0,
+		"retain directory capability before chmod");
+	check(chmod(chmod_race, 0000) == 0,
+		"protect concurrent chmod directory");
+	concurrent_chmod_count = 0;
+	eunion_test_sidecar_checkpoint_hook = sidecar_checkpoint_hook;
+	result = eunion_sidecar_remove_path(&runtime, "/chmod-race", 1);
+	eunion_test_sidecar_checkpoint_hook = NULL;
+	check(lstat(chmod_race, &status) == 0,
+		"concurrent chmod directory remains after ENOTEMPTY");
+	check(result == -ENOTEMPTY,
+		"concurrent chmod rmdir returns ENOTEMPTY");
+	check(concurrent_chmod_count == 1,
+		"concurrent chmod executes at exact pre-backing boundary");
+	check((status.st_mode & 0777) == 0711,
+		"successful concurrent chmod remains authoritative");
+	int concurrent_chmod_lost = (status.st_mode & 0777) != 0711;
+	check(close(concurrent_directory) == 0,
+		"close concurrent directory capability");
+	concurrent_directory = -1;
+
+	check(mkdir(merged_upper, 0700) == 0 &&
+		mkdir(merged_lower, 0700) == 0,
+		"create merged empty directory pair");
+	check(chmod(merged_upper, 0000) == 0,
+		"protect merged empty upper");
+	result = eunion_sidecar_remove_path(&runtime, "/merged-empty", 1);
+	check(result == 0,
+		"merged mode-000 empty rmdir succeeds");
+	check(lstat(merged_upper, &status) == -1 && errno == ENOENT,
+		"merged upper directory removed");
+	check(lstat(merged_lower, &status) == 0 && S_ISDIR(status.st_mode),
+		"merged lower directory preserved");
+	check(sidecar_kind(&runtime, "/merged-empty") ==
+		EUNION_SIDECAR_RECORD_WHITEOUT,
+		"merged deletion exists only as sidecar whiteout");
+
+	check(mkdir(recursive_upper, 0700) == 0 &&
+		mkdir(recursive_lower, 0700) == 0,
+		"create recursive directory pair");
+	make_file(recursive_lower_child, "lower");
+	result = eunion_sidecar_remove_path(&runtime, "/recursive/child", 0);
+	check(result == 0, "lower child unlink succeeds");
+	check(lstat(recursive_upper, &status) == 0 &&
+		S_ISDIR(status.st_mode),
+		"recursive upper parent remains physically empty");
+	check(sidecar_kind(&runtime, "/recursive/child") ==
+		EUNION_SIDECAR_RECORD_WHITEOUT,
+		"child whiteout stored in sidecar");
+	check(chmod(recursive_upper, 0000) == 0,
+		"protect recursive upper parent");
+	result = eunion_sidecar_remove_path(&runtime, "/recursive", 1);
+	check(result == 0,
+		"mode-000 parent rmdir succeeds after lower child unlink");
+	check(sidecar_kind(&runtime, "/recursive") ==
+		EUNION_SIDECAR_RECORD_WHITEOUT,
+		"parent whiteout replaces sidecar subtree identity");
+
+	check(mkdir(parent0300_upper, 0700) == 0 &&
+		mkdir(parent0300_lower, 0700) == 0,
+		"create mode-0300 merged parents");
+	make_file(parent0300_upper_child, "upper");
+	make_file(parent0300_lower_child, "lower");
+	check(chmod(parent0300_upper, 0300) == 0 &&
+		chmod(parent0300_lower, 0300) == 0,
+		"remove read permission from merged parents");
+	result = eunion_sidecar_remove_path(&runtime,
+		"/parent0300/child", 0);
+	check(result == 0, "unlink under mode-0300 merged parent succeeds");
+	check(sidecar_kind(&runtime, "/parent0300/child") ==
+		EUNION_SIDECAR_RECORD_WHITEOUT,
+		"mode-0300 removal publishes typed whiteout");
+	check(chmod(parent0300_upper, 0700) == 0 &&
+		chmod(parent0300_lower, 0700) == 0,
+		"restore mode-0300 fixture for cleanup");
+
+	make_file(hostile_lower, "lower");
+	mode_t old_umask = umask(0777);
+	result = eunion_sidecar_remove_path(&runtime, "/hostile-umask", 0);
+	umask(old_umask);
+	check(result == 0, "hostile umask lower unlink succeeds");
+	check(lstat(hostile_upper, &status) == -1 && errno == ENOENT,
+		"hostile umask creates no physical placeholder");
+	check(sidecar_kind(&runtime, "/hostile-umask") ==
+		EUNION_SIDECAR_RECORD_WHITEOUT,
+		"hostile umask sidecar record is valid");
+
+	check(mkdir(opaque_upper, 0700) == 0 &&
+		mkdir(opaque_lower, 0700) == 0,
+		"create opaque ancestor pair");
+	make_file(opaque_hidden, "lower");
+	eunion_sidecar_view opaque_writer = {{0}};
+	check(eunion_sidecar_view_open(opaque_writer, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"open opaque writer");
+	check(eunion_sidecar_publish_opaque(
+		opaque_writer, "/opaque-parent") == 0,
+		"publish typed opaque ancestor");
+	check(eunion_sidecar_view_close(opaque_writer) == 0,
+		"close opaque writer");
+	result = eunion_sidecar_remove_path(&runtime,
+		"/opaque-parent/hidden", 0);
+	check(result == -ENOENT,
+		"opaque ancestor hides lower child from remove");
+	check(sidecar_kind(&runtime, "/opaque-parent/hidden") ==
+		EUNION_SIDECAR_RECORD_NONE,
+		"opaque hidden child creates no sidecar record");
+
+	printf("EUNION_SIDECAR_CONTRACT physical_whiteout=%d "
+		"permission_lifts=0 payload_read=%d ctime_preserved=%d "
+		"concurrent_chmod_lost=%d failures=%d\n",
+		physical_whiteout, protected_payload_read,
+		ctime_preserved, concurrent_chmod_lost, failures);
+	cleanup(root, secret);
+	return failures == 0 ? 0 : 1;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_corruption_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_corruption_test.c
new file mode 100644
index 0000000..3c597b6
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_corruption_test.c
@@ -0,0 +1,136 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+#include "eunion_sidecar_test_support.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	++checks;
+	if (!condition) {
+		fprintf(stderr,
+			"eunion_sidecar_corruption_test: %s (errno=%d)\n",
+			message, errno);
+		exit(1);
+	}
+}
+
+static void join_path(char* output, size_t capacity, const char* root,
+	const char* suffix)
+{
+	int length = snprintf(output, capacity, "%s%s", root, suffix);
+	require(length > 0 && (size_t)length < capacity, "path overflow");
+}
+
+static void make_file(const char* path)
+{
+	int descriptor = open(path,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(descriptor >= 0 &&
+		write(descriptor, "lower", 5) == 5 &&
+		fsync(descriptor) == 0 && close(descriptor) == 0,
+		"create lower corruption fixture");
+}
+
+static void require_lookup_corruption(
+	const struct eunion_sidecar_runtime* runtime)
+{
+	eunion_sidecar_view view = {{0}};
+	require(eunion_sidecar_view_open(view, runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open corruption evidence view");
+	struct eunion_sidecar_lookup lookup;
+	require(eunion_sidecar_lookup_path(view, "/victim", &lookup) == -EIO,
+		"corrupt or stale node did not fail closed");
+	require(eunion_sidecar_view_close(view) == 0,
+		"close corruption evidence view");
+}
+
+static void cleanup(const char* root)
+{
+	char command[640];
+	int length = snprintf(command, sizeof(command), "rm -rf -- '%s'", root);
+	require(length > 0 && (size_t)length < sizeof(command) &&
+		system(command) == 0, "cleanup corruption fixture");
+}
+
+static void run_corruption(enum eunion_sidecar_test_corruption corruption)
+{
+	char root[] = "/tmp/eunion-sidecar-corruption.XXXXXX";
+	require(mkdtemp(root) != NULL, "mkdtemp corruption fixture");
+	char upper[512], lower[512], sidecar[512], victim[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(victim, sizeof(victim), lower, "/victim");
+	require(mkdir(upper, 0700) == 0 &&
+		mkdir(lower, 0700) == 0 &&
+		mkdir(sidecar, 0700) == 0,
+		"create corruption roots");
+	make_file(victim);
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0 &&
+		eunion_sidecar_initialize(&runtime) == 0 &&
+		eunion_sidecar_remove_path(&runtime, "/victim", 0) == 0,
+		"publish corruption target");
+	require(eunion_sidecar_test_corrupt_record(
+		&runtime, "/victim", corruption) == 0,
+		"inject bounded record corruption");
+	require_lookup_corruption(&runtime);
+	cleanup(root);
+}
+
+static void run_stale_identity(void)
+{
+	char root[] = "/tmp/eunion-sidecar-stale.XXXXXX";
+	require(mkdtemp(root) != NULL, "mkdtemp stale fixture");
+	char upper[512], lower[512], sidecar[512], victim[512], parked[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(victim, sizeof(victim), lower, "/victim");
+	join_path(parked, sizeof(parked), lower, "/parked");
+	require(mkdir(upper, 0700) == 0 &&
+		mkdir(lower, 0700) == 0 &&
+		mkdir(sidecar, 0700) == 0,
+		"create stale roots");
+	make_file(victim);
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0 &&
+		eunion_sidecar_initialize(&runtime) == 0 &&
+		eunion_sidecar_remove_path(&runtime, "/victim", 0) == 0,
+		"publish stale identity target");
+	require(rename(victim, parked) == 0,
+		"park original lower identity");
+	make_file(victim);
+	require_lookup_corruption(&runtime);
+	cleanup(root);
+}
+
+int main(void)
+{
+	run_corruption(EUNION_SIDECAR_TEST_CORRUPT_TRUNCATE);
+	run_corruption(EUNION_SIDECAR_TEST_CORRUPT_VERSION);
+	run_corruption(EUNION_SIDECAR_TEST_CORRUPT_CHECKSUM);
+	run_stale_identity();
+	printf("EUNION_SIDECAR_CORRUPTION_OK checks=%d cases=4\n", checks);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_fault_matrix_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_fault_matrix_test.c
new file mode 100644
index 0000000..ee845b7
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_fault_matrix_test.c
@@ -0,0 +1,298 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+#include "eunion_sidecar_test_support.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+enum fault_operation {
+	FAULT_REMOVE = 0,
+	FAULT_CREATE,
+	FAULT_COPY_UP,
+	FAULT_RENAME,
+};
+
+static enum eunion_sidecar_test_checkpoint selected_checkpoint;
+static int selected_errno;
+static int fault_armed;
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	if (condition) {
+		++checks;
+		return;
+	}
+	fprintf(stderr,
+		"eunion_sidecar_fault_matrix_test: %s (errno=%d)\n",
+		message, errno);
+	exit(1);
+}
+
+static void join_path(char* output, size_t capacity,
+	const char* root, const char* suffix)
+{
+	int length = snprintf(output, capacity, "%s%s", root, suffix);
+	require(length > 0 && (size_t)length < capacity, "construct path");
+}
+
+static void write_file(const char* path)
+{
+	int descriptor = open(path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+	require(descriptor >= 0, "create fixture file");
+	require(write(descriptor, "x", 1) == 1 &&
+			fsync(descriptor) == 0 && close(descriptor) == 0,
+		"persist fixture file");
+}
+
+static void arm_fsync_fault(
+	enum eunion_sidecar_test_checkpoint checkpoint,
+	const char* guest_path)
+{
+	if (checkpoint != selected_checkpoint ||
+		strcmp(guest_path, "/victim") != 0 || fault_armed)
+		return;
+	fault_armed = 1;
+	eunion_test_sidecar_fail_syscall = __NR_fsync;
+	eunion_test_sidecar_fail_after = 1;
+	eunion_test_sidecar_fail_errno = selected_errno;
+}
+
+static int run_operation(enum fault_operation operation,
+	const struct eunion_sidecar_runtime* runtime)
+{
+	switch (operation) {
+		case FAULT_REMOVE:
+			return eunion_sidecar_remove_path(runtime, "/victim", 0);
+		case FAULT_CREATE: {
+			int descriptor = eunion_sidecar_open_create(runtime,
+				"/victim", O_WRONLY | O_CREAT | O_EXCL, 0600);
+			if (descriptor < 0)
+				return descriptor;
+			return close(descriptor) == 0 ? 0 : -errno;
+		}
+		case FAULT_COPY_UP:
+			return eunion_sidecar_copy_up(runtime, "/victim");
+		case FAULT_RENAME:
+			return eunion_sidecar_rename_path(
+				runtime, "/victim", "/renamed");
+		default:
+			return -EINVAL;
+	}
+}
+
+static void require_quiescent(
+	const struct eunion_sidecar_runtime* runtime,
+	const char* journal, enum fault_operation operation,
+	enum eunion_sidecar_test_checkpoint checkpoint, int failure_errno)
+{
+	eunion_sidecar_view recovery = {{0}};
+	int recovery_result = eunion_sidecar_view_open(recovery, runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE);
+	if (recovery_result < 0)
+		fprintf(stderr,
+			"recovery operation=%d checkpoint=%d injected=%d result=%d\n",
+			operation, checkpoint, failure_errno, recovery_result);
+	require(recovery_result == 0,
+		"exclusive open failed to recover injected fault");
+	require(eunion_sidecar_view_close(recovery) == 0,
+		"close recovered fault fixture");
+	struct stat status;
+	require(lstat(journal, &status) == -1 && errno == ENOENT,
+		"fault recovery retained transaction journal");
+	eunion_sidecar_view repeated = {{0}};
+	require(eunion_sidecar_view_open(repeated, runtime,
+			EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0 &&
+			eunion_sidecar_view_close(repeated) == 0,
+		"fault recovery was not idempotent");
+}
+
+static enum eunion_sidecar_record_kind lookup_kind(
+	const struct eunion_sidecar_runtime* runtime, const char* path)
+{
+	eunion_sidecar_view reader = {{0}};
+	require(eunion_sidecar_view_open(reader, runtime,
+			EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"open fault result reader");
+	struct eunion_sidecar_lookup lookup;
+	require(eunion_sidecar_lookup_path(reader, path, &lookup) == 0,
+		"lookup fault result");
+	require(eunion_sidecar_view_close(reader) == 0,
+		"close fault result reader");
+	return lookup.kind;
+}
+
+static void require_coherent_result(
+	enum fault_operation operation,
+	const struct eunion_sidecar_runtime* runtime,
+	const char* upper_victim, const char* upper_renamed)
+{
+	struct stat victim;
+	struct stat renamed;
+	int have_victim = lstat(upper_victim, &victim) == 0;
+	int have_renamed = lstat(upper_renamed, &renamed) == 0;
+	switch (operation) {
+		case FAULT_REMOVE:
+			require(lookup_kind(runtime, "/victim") ==
+					(have_victim ? EUNION_SIDECAR_RECORD_NONE
+						: EUNION_SIDECAR_RECORD_WHITEOUT),
+				"remove fault left backing/record split");
+			break;
+		case FAULT_CREATE:
+			require(lookup_kind(runtime, "/victim") ==
+					(have_victim ? EUNION_SIDECAR_RECORD_NONE
+						: EUNION_SIDECAR_RECORD_WHITEOUT),
+				"create fault left backing/record split");
+			break;
+		case FAULT_COPY_UP:
+			require(lookup_kind(runtime, "/victim") ==
+					EUNION_SIDECAR_RECORD_NONE,
+				"copy-up fault exposed internal record state");
+			break;
+		case FAULT_RENAME:
+			require(have_victim != have_renamed,
+				"rename fault did not converge to exactly one backing");
+			require(lookup_kind(runtime, "/victim") ==
+					(have_renamed ? EUNION_SIDECAR_RECORD_WHITEOUT
+						: EUNION_SIDECAR_RECORD_NONE),
+				"rename fault source record is incoherent");
+			require(lookup_kind(runtime, "/renamed") ==
+					EUNION_SIDECAR_RECORD_NONE,
+				"rename fault destination record is incoherent");
+			break;
+	}
+}
+
+static void run_case(enum fault_operation operation,
+	enum eunion_sidecar_test_checkpoint checkpoint, int failure_errno)
+{
+	char root[] = "/tmp/eunion-sidecar-fault-matrix.XXXXXX";
+	require(mkdtemp(root) != NULL, "create fault-matrix fixture");
+	char upper[512], lower[512], sidecar[512];
+	char upper_victim[512], lower_victim[512], upper_renamed[512];
+	char journal[512], staging[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(upper_victim, sizeof(upper_victim), upper, "/victim");
+	join_path(lower_victim, sizeof(lower_victim), lower, "/victim");
+	join_path(upper_renamed, sizeof(upper_renamed), upper, "/renamed");
+	join_path(journal, sizeof(journal), sidecar, "/journal-v1");
+	join_path(staging, sizeof(staging), sidecar, "/staging-v1/copyup-v1");
+	require(mkdir(upper, 0700) == 0 &&
+			mkdir(lower, 0700) == 0 &&
+			mkdir(sidecar, 0700) == 0,
+		"create fault-matrix roots");
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0 &&
+			eunion_sidecar_initialize(&runtime) == 0,
+		"initialize fault-matrix sidecar");
+	if (operation == FAULT_REMOVE) {
+		write_file(upper_victim);
+		write_file(lower_victim);
+	} else if (operation == FAULT_CREATE) {
+		write_file(lower_victim);
+		eunion_sidecar_view writer = {{0}};
+		require(eunion_sidecar_view_open(writer, &runtime,
+				EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0 &&
+				eunion_sidecar_publish_whiteout(
+					writer, "/victim") == 0 &&
+				eunion_sidecar_view_close(writer) == 0,
+			"publish create precondition whiteout");
+	} else if (operation == FAULT_COPY_UP) {
+		write_file(lower_victim);
+	} else {
+		write_file(lower_victim);
+		require(eunion_sidecar_copy_up(&runtime, "/victim") == 0,
+			"copy up rename source");
+	}
+
+	selected_checkpoint = checkpoint;
+	selected_errno = failure_errno;
+	fault_armed = 0;
+	eunion_test_sidecar_fail_syscall = -1;
+	eunion_test_sidecar_fail_after = 0;
+	eunion_test_sidecar_fail_errno = failure_errno;
+	eunion_test_sidecar_checkpoint_hook = arm_fsync_fault;
+	int result = run_operation(operation, &runtime);
+	eunion_test_sidecar_checkpoint_hook = NULL;
+	eunion_test_sidecar_fail_syscall = -1;
+	eunion_test_sidecar_fail_after = 0;
+	require(fault_armed,
+		"operation did not reach selected transaction phase");
+	require(result == -failure_errno,
+		"injected operation failure was not propagated exactly");
+	require_quiescent(
+		&runtime, journal, operation, checkpoint, failure_errno);
+	struct stat status;
+	require(lstat(staging, &status) == -1 && errno == ENOENT,
+		"fault recovery retained private copy-up staging");
+	require_coherent_result(
+		operation, &runtime, upper_victim, upper_renamed);
+
+	char command[640];
+	require(snprintf(command, sizeof(command), "rm -rf -- '%s'", root) > 0,
+		"construct fault-matrix cleanup");
+	require(system(command) == 0, "remove fault-matrix fixture");
+}
+
+int main(void)
+{
+	static const enum eunion_sidecar_test_checkpoint remove_phases[] = {
+		EUNION_SIDECAR_TEST_RESOLVED,
+		EUNION_SIDECAR_TEST_JOURNAL_PREPARED,
+		EUNION_SIDECAR_TEST_LOGICALLY_PUBLISHED,
+		EUNION_SIDECAR_TEST_PRE_BACKING,
+		EUNION_SIDECAR_TEST_BACKING_COMMITTED,
+		EUNION_SIDECAR_TEST_DURABLE,
+	};
+	static const enum eunion_sidecar_test_checkpoint backing_first_phases[] = {
+		EUNION_SIDECAR_TEST_RESOLVED,
+		EUNION_SIDECAR_TEST_JOURNAL_PREPARED,
+		EUNION_SIDECAR_TEST_PRE_BACKING,
+		EUNION_SIDECAR_TEST_POST_BACKING_PRE_JOURNAL,
+		EUNION_SIDECAR_TEST_BACKING_COMMITTED,
+		EUNION_SIDECAR_TEST_DURABLE,
+	};
+	static const int failure_errnos[] = {EINTR, EIO};
+	unsigned cases = 0;
+	for (size_t failure = 0;
+			failure < sizeof(failure_errnos) / sizeof(failure_errnos[0]);
+			++failure) {
+		for (size_t phase = 0;
+				phase < sizeof(remove_phases) / sizeof(remove_phases[0]);
+				++phase) {
+			run_case(FAULT_REMOVE, remove_phases[phase],
+				failure_errnos[failure]);
+			++cases;
+		}
+		for (enum fault_operation operation = FAULT_CREATE;
+				operation <= FAULT_RENAME; ++operation) {
+			for (size_t phase = 0;
+					phase < sizeof(backing_first_phases) /
+						sizeof(backing_first_phases[0]);
+					++phase) {
+				run_case(operation, backing_first_phases[phase],
+					failure_errnos[failure]);
+				++cases;
+			}
+		}
+	}
+	require(cases == 48,
+		"failure/EINTR operation-phase matrix was incomplete");
+	printf("EUNION_SIDECAR_FAULT_MATRIX_OK checks=%d cases=%u"
+		" errnos=EINTR,EIO\n", checks, cases);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_lock_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_lock_test.c
new file mode 100644
index 0000000..81e51c6
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_lock_test.c
@@ -0,0 +1,152 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+#include "eunion_sidecar_test_support.h"
+
+#include <errno.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	if (condition) {
+		++checks;
+		return;
+	}
+	fprintf(stderr, "eunion_sidecar_lock_test: %s (errno=%d)\n",
+		message, errno);
+	exit(1);
+}
+
+static void send_byte(int descriptor, char value)
+{
+	require(write(descriptor, &value, 1) == 1, "send synchronization byte");
+}
+
+static char receive_byte(int descriptor)
+{
+	char value;
+	require(read(descriptor, &value, 1) == 1,
+		"receive synchronization byte");
+	return value;
+}
+
+static void require_blocked(int descriptor, const char* message)
+{
+	struct pollfd event = {
+		.fd = descriptor,
+		.events = POLLIN,
+	};
+	int result = poll(&event, 1, 100);
+	require(result == 0, message);
+}
+
+static void child_lock(const struct eunion_sidecar_runtime* runtime,
+	int started, int acquired, int release)
+{
+	send_byte(started, 'S');
+	eunion_sidecar_view view = {{0}};
+	if (eunion_sidecar_view_open(view, runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) != 0)
+		_exit(20);
+	send_byte(acquired, 'A');
+	(void)receive_byte(release);
+	if (eunion_sidecar_view_close(view) != 0)
+		_exit(21);
+	_exit(0);
+}
+
+int main(void)
+{
+	char root[] = "/tmp/eunion-sidecar-lock.XXXXXX";
+	require(mkdtemp(root) != NULL, "create lock fixture");
+	char upper[512], lower[512], sidecar[512], lock[512];
+	require(snprintf(upper, sizeof(upper), "%s/upper", root) > 0,
+		"construct upper path");
+	require(snprintf(lower, sizeof(lower), "%s/lower", root) > 0,
+		"construct lower path");
+	require(snprintf(sidecar, sizeof(sidecar), "%s/sidecar", root) > 0,
+		"construct sidecar path");
+	require(snprintf(lock, sizeof(lock), "%s/lock-v1", sidecar) > 0,
+		"construct lock path");
+	require(mkdir(upper, 0700) == 0, "create upper root");
+	require(mkdir(lower, 0700) == 0, "create lower root");
+	require(mkdir(sidecar, 0700) == 0, "create sidecar root");
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0,
+		"write sidecar-v1 prefix state");
+	require(eunion_sidecar_initialize(&runtime) == 0,
+		"initialize lock sidecar");
+	struct stat initial;
+	require(lstat(lock, &initial) == 0, "snapshot lock inode");
+
+	int a_started[2], a_acquired[2], a_release[2];
+	int b_started[2], b_acquired[2], b_release[2];
+	int c_started[2], c_acquired[2], c_release[2];
+	require(pipe(a_started) == 0 && pipe(a_acquired) == 0 &&
+		pipe(a_release) == 0 && pipe(b_started) == 0 &&
+		pipe(b_acquired) == 0 && pipe(b_release) == 0 &&
+		pipe(c_started) == 0 && pipe(c_acquired) == 0 &&
+		pipe(c_release) == 0, "create synchronization pipes");
+
+	pid_t a = fork();
+	require(a >= 0, "fork first locker");
+	if (a == 0)
+		child_lock(&runtime, a_started[1], a_acquired[1], a_release[0]);
+	require(receive_byte(a_started[0]) == 'S', "first locker starts");
+	require(receive_byte(a_acquired[0]) == 'A', "first locker acquires");
+
+	pid_t b = fork();
+	require(b >= 0, "fork second locker");
+	if (b == 0)
+		child_lock(&runtime, b_started[1], b_acquired[1], b_release[0]);
+	require(receive_byte(b_started[0]) == 'S', "second locker starts");
+	require_blocked(b_acquired[0],
+		"second locker blocks on persistent inode");
+	send_byte(a_release[1], 'R');
+	require(receive_byte(b_acquired[0]) == 'A',
+		"second locker acquires after first releases");
+
+	pid_t c = fork();
+	require(c >= 0, "fork third locker");
+	if (c == 0)
+		child_lock(&runtime, c_started[1], c_acquired[1], c_release[0]);
+	require(receive_byte(c_started[0]) == 'S', "third locker starts");
+	require_blocked(c_acquired[0],
+		"third locker blocks while second owns lock");
+	send_byte(b_release[1], 'R');
+	require(receive_byte(c_acquired[0]) == 'A',
+		"third locker acquires after second releases");
+	send_byte(c_release[1], 'R');
+
+	int status;
+	require(waitpid(a, &status, 0) == a && WIFEXITED(status) &&
+		WEXITSTATUS(status) == 0, "first locker exits cleanly");
+	require(waitpid(b, &status, 0) == b && WIFEXITED(status) &&
+		WEXITSTATUS(status) == 0, "second locker exits cleanly");
+	require(waitpid(c, &status, 0) == c && WIFEXITED(status) &&
+		WEXITSTATUS(status) == 0, "third locker exits cleanly");
+	struct stat final;
+	require(lstat(lock, &final) == 0 &&
+		initial.st_dev == final.st_dev && initial.st_ino == final.st_ino,
+		"all three processes use one persistent lock inode");
+
+	char command[640];
+	require(snprintf(command, sizeof(command), "rm -rf -- '%s'", root) > 0,
+		"construct cleanup command");
+	require(system(command) == 0, "remove lock fixture");
+	printf("EUNION_SIDECAR_LOCK_OK checks=%d processes=3\n", checks);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_prefix_format_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_prefix_format_test.c
new file mode 100644
index 0000000..0f9b629
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_prefix_format_test.c
@@ -0,0 +1,188 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	++checks;
+	if (!condition) {
+		fprintf(stderr,
+			"eunion_sidecar_prefix_format_test: %s (errno=%d)\n",
+			message, errno);
+		exit(1);
+	}
+}
+
+static void join_path(char* output, size_t capacity, const char* root,
+	const char* suffix)
+{
+	int length = snprintf(output, capacity, "%s%s", root, suffix);
+	require(length > 0 && (size_t)length < capacity, "path overflow");
+}
+
+static void write_file(const char* path)
+{
+	int descriptor = open(path,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(descriptor >= 0, "create fixture file");
+	require(write(descriptor, "x", 1) == 1, "write fixture file");
+	require(fsync(descriptor) == 0, "fsync fixture file");
+	require(close(descriptor) == 0, "close fixture file");
+}
+
+static void write_prefix_state(
+	const char* upper, const char* sidecar)
+{
+	struct stat upper_status;
+	struct stat sidecar_status;
+	require(stat(upper, &upper_status) == 0 &&
+		stat(sidecar, &sidecar_status) == 0,
+		"stat prefix state roots");
+	char path[512];
+	join_path(path, sizeof(path), upper,
+		"/.darling-prefix-state-v3");
+	char content[1024];
+	int length = snprintf(content, sizeof(content),
+		"DARLING_PREFIX_STATE_V3\n"
+		"schema_version=3\n"
+		"runtime_mode=rootless-eunion\n"
+		"generation=1\n"
+		"prefix_device=%ju\n"
+		"prefix_inode=%ju\n"
+		"sidecar_device=%ju\n"
+		"sidecar_inode=%ju\n"
+		"owner_uid=%ju\n"
+		"owner_gid=%ju\n"
+		"provenance=darling-runtime-prefix-sidecar-v1\n",
+		(uintmax_t)upper_status.st_dev,
+		(uintmax_t)upper_status.st_ino,
+		(uintmax_t)sidecar_status.st_dev,
+		(uintmax_t)sidecar_status.st_ino,
+		(uintmax_t)upper_status.st_uid,
+		(uintmax_t)upper_status.st_gid);
+	require(length > 0 && (size_t)length < sizeof(content),
+		"format prefix state");
+	int descriptor = open(path,
+		O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	require(descriptor >= 0 &&
+		write(descriptor, content, (size_t)length) == length &&
+		fsync(descriptor) == 0 && close(descriptor) == 0,
+		"publish prefix state fixture");
+}
+
+static void remove_tree(const char* root)
+{
+	char command[640];
+	int length = snprintf(command, sizeof(command), "rm -rf -- '%s'", root);
+	require(length > 0 && (size_t)length < sizeof(command),
+		"cleanup command size");
+	require(system(command) == 0, "cleanup");
+}
+
+int main(void)
+{
+	char root[] = "/tmp/eunion-sidecar-prefix-format.XXXXXX";
+	require(mkdtemp(root) != NULL, "mkdtemp");
+	char upper[512];
+	char lower[512];
+	char sidecar[512];
+	char activation[512];
+	char legacy_work[512];
+	char legacy_payload[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(activation, sizeof(activation), sidecar,
+		"/" EUNION_SIDECAR_ACTIVATION_NAME);
+	join_path(legacy_work, sizeof(legacy_work), upper, "/.union-work");
+	join_path(legacy_payload, sizeof(legacy_payload), upper, "/legacy");
+	require(mkdir(upper, 0700) == 0, "mkdir upper");
+	require(mkdir(lower, 0700) == 0, "mkdir lower");
+	require(mkdir(sidecar, 0700) == 0, "mkdir sidecar");
+
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	struct eunion_prefix_format_inspection inspection;
+	require(eunion_sidecar_inspect_prefix(&runtime, &inspection) == 0 &&
+		inspection.verdict == EUNION_PREFIX_FORMAT_UNINITIALIZED,
+		"empty sidecar is uninitialized before lifecycle validation");
+	require(access(activation, F_OK) == -1 && errno == ENOENT,
+		"inspection does not mutate unversioned prefix");
+
+	require(mkdir(legacy_work, 0700) == 0, "mkdir legacy union work");
+	write_file(legacy_payload);
+	struct stat legacy_before;
+	struct stat work_before;
+	require(lstat(legacy_payload, &legacy_before) == 0 &&
+		lstat(legacy_work, &work_before) == 0,
+		"snapshot legacy prefix");
+	require(eunion_sidecar_inspect_prefix(&runtime, &inspection) == 0 &&
+		inspection.verdict == EUNION_PREFIX_FORMAT_UNINITIALIZED,
+		"inspection does not infer format from guest-visible contents");
+	struct stat legacy_after;
+	struct stat work_after;
+	require(lstat(legacy_payload, &legacy_after) == 0 &&
+		lstat(legacy_work, &work_after) == 0 &&
+		legacy_before.st_dev == legacy_after.st_dev &&
+		legacy_before.st_ino == legacy_after.st_ino &&
+		legacy_before.st_ctim.tv_sec == legacy_after.st_ctim.tv_sec &&
+		legacy_before.st_ctim.tv_nsec == legacy_after.st_ctim.tv_nsec &&
+		work_before.st_dev == work_after.st_dev &&
+		work_before.st_ino == work_after.st_ino &&
+		work_before.st_ctim.tv_sec == work_after.st_ctim.tv_sec &&
+		work_before.st_ctim.tv_nsec == work_after.st_ctim.tv_nsec,
+		"legacy inspection is byte-and-identity non-mutating");
+	require(eunion_sidecar_initialize(&runtime) ==
+			-EUNION_PREFIX_RECREATE_REQUIRED_ERROR,
+		"unversioned prefix requires explicit lifecycle recreation");
+	require(access(activation, F_OK) == -1 && errno == ENOENT,
+		"failed initialize never partially activates sidecar");
+
+	require(unlink(legacy_payload) == 0 && rmdir(legacy_work) == 0,
+		"clear legacy fixture explicitly");
+	write_prefix_state(upper, sidecar);
+	require(eunion_sidecar_initialize(&runtime) == 0,
+		"fresh prefix initializes directly as sidecar v1");
+	require(eunion_sidecar_inspect_prefix(&runtime, &inspection) == 0 &&
+		inspection.verdict == EUNION_PREFIX_FORMAT_VALID &&
+		inspection.format_version == 1,
+		"fresh sidecar prefix validates");
+	struct stat status;
+	require(lstat(activation, &status) == 0 && S_ISREG(status.st_mode) &&
+		!S_ISLNK(status.st_mode) && (status.st_mode & 0777) == 0600,
+		"activation is exact regular mode 0600");
+	require(eunion_sidecar_initialize(&runtime) == -ENOTEMPTY,
+		"activation prevents partial reinitialization");
+
+	int descriptor = open(activation, O_RDWR | O_CLOEXEC);
+	require(descriptor >= 0, "open activation corruption fixture");
+	unsigned char byte;
+	require(pread(descriptor, &byte, 1, 8) == 1,
+		"read activation version byte");
+	byte ^= 0x80;
+	require(pwrite(descriptor, &byte, 1, 8) == 1 &&
+		fsync(descriptor) == 0 && close(descriptor) == 0,
+		"durably corrupt activation");
+	require(eunion_sidecar_inspect_prefix(&runtime, &inspection) == 0 &&
+		inspection.verdict == EUNION_PREFIX_FORMAT_CORRUPT,
+		"malformed activation fails closed as corrupt");
+
+	printf("EUNION_SIDECAR_PREFIX_FORMAT_OK checks=%d\n", checks);
+	remove_tree(root);
+	return 0;
+}
diff --git a/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_recovery_test.c b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_recovery_test.c
new file mode 100644
index 0000000..3c79a82
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/tests/eunion_sidecar_recovery_test.c
@@ -0,0 +1,618 @@
+#define _GNU_SOURCE
+
+#include <linux_premigration/eunion_sidecar.h>
+#include "eunion_sidecar_test_support.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static enum eunion_sidecar_test_checkpoint kill_checkpoint;
+static const char* kill_path = "/victim";
+static int termination_signal = SIGKILL;
+static enum eunion_sidecar_test_checkpoint fault_checkpoint;
+static long fault_syscall;
+static int fault_armed;
+static int checks;
+
+static void require(int condition, const char* message)
+{
+	if (condition) {
+		++checks;
+		return;
+	}
+	fprintf(stderr, "eunion_sidecar_recovery_test: %s (errno=%d)\n",
+		message, errno);
+	exit(1);
+}
+
+static void join_path(char* output, size_t capacity,
+	const char* root, const char* suffix)
+{
+	int length = snprintf(output, capacity, "%s%s", root, suffix);
+	require(length > 0 && (size_t)length < capacity, "construct path");
+}
+
+static void write_file(const char* path)
+{
+	int descriptor = open(path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+	require(descriptor >= 0, "create fixture file");
+	require(write(descriptor, "x", 1) == 1, "write fixture file");
+	require(fsync(descriptor) == 0, "fsync fixture file");
+	require(close(descriptor) == 0, "close fixture file");
+}
+
+static void kill_at_boundary(
+	enum eunion_sidecar_test_checkpoint checkpoint, const char* guest_path)
+{
+	if (checkpoint == kill_checkpoint && strcmp(guest_path, kill_path) == 0)
+		kill(getpid(), termination_signal);
+}
+
+static void fail_at_boundary(
+	enum eunion_sidecar_test_checkpoint checkpoint, const char* guest_path)
+{
+	if (checkpoint != fault_checkpoint ||
+		strcmp(guest_path, "/victim") != 0 ||
+		fault_armed)
+		return;
+	fault_armed = 1;
+	eunion_test_sidecar_fail_syscall = fault_syscall;
+	eunion_test_sidecar_fail_after = 1;
+	eunion_test_sidecar_fail_errno = EINTR;
+}
+
+static void run_remove_fault(
+	enum eunion_sidecar_test_checkpoint checkpoint, long syscall_number,
+	int expect_committed)
+{
+	char root[] = "/tmp/eunion-sidecar-fault.XXXXXX";
+	require(mkdtemp(root) != NULL, "create fault root");
+	char upper[512], lower[512], sidecar[512];
+	char upper_file[512], lower_file[512], journal[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(upper_file, sizeof(upper_file), upper, "/victim");
+	join_path(lower_file, sizeof(lower_file), lower, "/victim");
+	join_path(journal, sizeof(journal), sidecar, "/journal-v1");
+	require(mkdir(upper, 0700) == 0, "create fault upper");
+	require(mkdir(lower, 0700) == 0, "create fault lower");
+	require(mkdir(sidecar, 0700) == 0, "create fault sidecar");
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0,
+		"write sidecar-v1 prefix state");
+	require(eunion_sidecar_initialize(&runtime) == 0,
+		"initialize fault sidecar");
+	write_file(upper_file);
+	write_file(lower_file);
+	fault_checkpoint = checkpoint;
+	fault_syscall = syscall_number;
+	fault_armed = 0;
+	eunion_test_sidecar_fail_syscall = -1;
+	eunion_test_sidecar_fail_after = 0;
+	eunion_test_sidecar_checkpoint_hook = fail_at_boundary;
+	int remove_result = eunion_sidecar_remove_path(
+		&runtime, "/victim", 0);
+	eunion_test_sidecar_checkpoint_hook = NULL;
+	eunion_test_sidecar_fail_syscall = -1;
+	eunion_test_sidecar_fail_after = 0;
+	if (remove_result != -EINTR)
+		fprintf(stderr,
+			"remove fault checkpoint=%d syscall=%ld result=%d\n",
+			checkpoint, syscall_number, remove_result);
+	require(remove_result == -EINTR,
+		"injected syscall failure is preserved");
+
+	eunion_sidecar_view recovery = {{0}};
+	require(eunion_sidecar_view_open(recovery, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"fault recovery opens");
+	require(eunion_sidecar_view_close(recovery) == 0,
+		"fault recovery closes");
+	struct stat status;
+	require(lstat(journal, &status) == -1 && errno == ENOENT,
+		"fault recovery consumes journal");
+	require((lstat(upper_file, &status) == 0) == !expect_committed,
+		"fault recovery backing direction is deterministic");
+	eunion_sidecar_view reader = {{0}};
+	require(eunion_sidecar_view_open(reader, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0,
+		"fault result reader opens");
+	struct eunion_sidecar_lookup lookup;
+	require(eunion_sidecar_lookup_path(
+		reader, "/victim", &lookup) == 0,
+		"fault result lookup");
+	require(lookup.kind == (expect_committed
+			? EUNION_SIDECAR_RECORD_WHITEOUT
+			: EUNION_SIDECAR_RECORD_NONE),
+		"fault result record direction is deterministic");
+	require(eunion_sidecar_view_close(reader) == 0,
+		"fault result reader closes");
+
+	char command[640];
+	int length = snprintf(command, sizeof(command), "rm -rf -- '%s'", root);
+	require(length > 0 && (size_t)length < sizeof(command),
+		"construct fault cleanup command");
+	require(system(command) == 0, "remove fault root");
+}
+
+static void run_boundary(enum eunion_sidecar_test_checkpoint checkpoint,
+	int expect_committed)
+{
+	char root[] = "/tmp/eunion-sidecar-recovery.XXXXXX";
+	require(mkdtemp(root) != NULL, "create recovery root");
+	char upper[512], lower[512], sidecar[512];
+	char upper_file[512], lower_file[512], journal[512], lock[512];
+	join_path(upper, sizeof(upper), root, "/upper");
+	join_path(lower, sizeof(lower), root, "/lower");
+	join_path(sidecar, sizeof(sidecar), root, "/sidecar");
+	join_path(upper_file, sizeof(upper_file), upper, "/victim");
+	join_path(lower_file, sizeof(lower_file), lower, "/victim");
+	join_path(journal, sizeof(journal), sidecar, "/journal-v1");
+	join_path(lock, sizeof(lock), sidecar, "/lock-v1");
+	require(mkdir(upper, 0700) == 0, "create upper root");
+	require(mkdir(lower, 0700) == 0, "create lower root");
+	require(mkdir(sidecar, 0700) == 0, "create sidecar root");
+	write_file(lower_file);
+	struct eunion_sidecar_runtime runtime = {
+		.upper_root = upper,
+		.lower_root = lower,
+		.sidecar_root = sidecar,
+	};
+	require(eunion_sidecar_test_write_prefix_state(&runtime) == 0,
+		"write sidecar-v1 prefix state");
+	require(eunion_sidecar_initialize(&runtime) == 0,
+		"initialize recovery sidecar");
+	write_file(upper_file);
+	struct stat lock_before;
+	require(lstat(lock, &lock_before) == 0, "snapshot persistent lock");
+
+	pid_t child = fork();
+	require(child >= 0, "fork boundary child");
+	if (child == 0) {
+		kill_path = "/victim";
+		kill_checkpoint = checkpoint;
+		eunion_test_sidecar_checkpoint_hook = kill_at_boundary;
+		(void)eunion_sidecar_remove_path(&runtime, "/victim", 0);
+		_exit(90);
+	}
+	int status;
+	require(waitpid(child, &status, 0) == child, "wait boundary child");
+	require(WIFSIGNALED(status) && WTERMSIG(status) == termination_signal,
+		"child is killed at durable boundary");
+	struct stat file_status;
+	require(lstat(journal, &file_status) == 0, "journal survives SIGKILL");
+
+	eunion_sidecar_view recovery = {{0}};
+	int recovery_result = eunion_sidecar_view_open(recovery, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE);
+	if (recovery_result < 0)
+		fprintf(stderr, "recovery checkpoint=%d result=%d\n",
+			(int)checkpoint, recovery_result);
+	require(recovery_result == 0,
+		"exclusive open performs recovery");
+	require(eunion_sidecar_view_close(recovery) == 0,
+		"close recovered view");
+	require(lstat(journal, &file_status) == -1 && errno == ENOENT,
+		"recovery consumes journal");
+	require((lstat(upper_file, &file_status) == 0) == !expect_committed,
+		"backing state matches recovery direction");
+
+	eunion_sidecar_view reader = {{0}};
+	require(eunion_sidecar_view_open(reader, &runtime,
+		EUNION_SIDECAR_ACCESS_SHARED) == 0, "open recovered reader");
+	struct eunion_sidecar_lookup lookup;
+	require(eunion_sidecar_lookup_path(reader, "/victim", &lookup) == 0,
+		"lookup recovered record");
+	require(lookup.kind == (expect_committed
+			? EUNION_SIDECAR_RECORD_WHITEOUT
+			: EUNION_SIDECAR_RECORD_NONE),
+		"record state matches recovery direction");
+	require(eunion_sidecar_view_close(reader) == 0,
+		"close recovered reader");
+
+	eunion_sidecar_view repeated = {{0}};
+	require(eunion_sidecar_view_open(repeated, &runtime,
+		EUNION_SIDECAR_ACCESS_EXCLUSIVE) == 0,
+		"second recovery is idempotent");
+	require(eunion_sidecar_view_close(repeated) == 0,
+		"close idempotent recovery");
+	struct stat lock_after;
+	require(lstat(lock, &lock_after) == 0 &&
+		lock_before.st_dev == lock_after.st_dev &&
+		lock_before.st_ino == lock_after.st_ino,
+		"persistent lock inode is never replaced");
+
+	char command[640];
+	int length = snprintf(command, sizeof(command), "rm -rf -- '%s'", root);
+	require(length > 0 && (size_t)length < sizeof(command),
+		"construct cleanup command");
+	require(system(command) == 0, "remove recovery root");
+}
