From e1c70fc1ab8cf4275d70409c311fd51648f14137 Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 13 Oct 2026 10:20:02 +0000
Subject: [PATCH] emulation: read the process's own procfs for the KERN_PROC
 sysctl queries

sysctl(CTL_KERN, KERN_PROC, KERN_PROC_PID, getpid()) returned ENOENT on a
rootless prefix: _sysctl_proc() and read_string() opened "/proc" through the
emulated (vchroot) path, and darlingserver mounts a procfs only for its
non-rootless PID namespace, so a rootless guest has no /proc at all.

MEASURED (guest probe on prefix-verify14): opendir("/proc") errno=2,
stat("/proc/<getpid>/stat") errno=2, sysctl(KERN_PROC_PID, getpid()) rc=-1
errno=2; getpid() was 475721, a host pid, so there is no pid translation and
the defect is not the guest-pid-vs-container-pid mismatch that was suspected.

DVTFoundation's CurrentProcessIsBeingDebugged() reads exactly that call and,
on a non-zero return, fires a soft assertion whose handler re-enters the
once-guarded -[DVTToolsInfo runtimeInternalState] and trips libdispatch's
deliberate ud2 ("trying to lock recursively") -- the ladder's wall.

Read the procfs of the process's own mount namespace with raw Linux syscalls,
the route sigexc.c and lkm.c already use for /proc/self paths. Its entries
carry the caller's pid in rootless mode (no PID namespace) and the namespace
pid in rootfull mode, so the KERN_PROC_PID comparison keeps working in both.

After the fix the same probe reports rc=0 len=648 p_pid=<getpid> p_flag=0x4
(P_LP64; P_TRACED clear), and a bogus pid still yields no record (rc=0 len=0).
---
 .../xnu_syscall/bsd/helper/misc/sysctl_proc.c | 34 +++++++++++++------
 1 file changed, 24 insertions(+), 10 deletions(-)

diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/misc/sysctl_proc.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/misc/sysctl_proc.c
index 61dcfc9..505007d 100644
--- a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/misc/sysctl_proc.c
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/misc/sysctl_proc.c
@@ -4,15 +4,15 @@
 #include <sys/errno.h>
 #include <stdbool.h>
 
-#include <darling/emulation/xnu_syscall/bsd/impl/dirent/getdirentries.h>
 #include <darling/emulation/xnu_syscall/bsd/impl/unistd/close.h>
-#include <darling/emulation/xnu_syscall/bsd/impl/unistd/read.h>
 #include <darling/emulation/xnu_syscall/bsd/impl/unistd/getuid.h>
 #include <darling/emulation/xnu_syscall/bsd/impl/unistd/getgid.h>
-#include <darling/emulation/xnu_syscall/bsd/impl/fcntl/open.h>
+#include <darling/emulation/common/base.h>
 #include <darling/emulation/common/simple.h>
+#include <darling/emulation/conversion/common_at.h>
 #include <darling/emulation/conversion/dirent/getdirentries.h>
 #include <darling/emulation/conversion/fcntl/open.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
 
 #include <darlingserver/rpc.h>
 #include <darling/emulation/linux_premigration/resources/dserver-ring.h>
@@ -44,8 +44,7 @@ extern char *strncpy(char *dest, const char *src, __SIZE_TYPE__ n);
 int _sysctl_proc(int what, int flag, struct kinfo_proc* out, unsigned long* buflen)
 {
 	int fd, ret = 0;
-	char dents[256];
-	long basep = 0;
+	char dents[512];
 	int nproc = 0;
 	struct kinfo_proc_chain *first = NULL, *last = NULL;
 
@@ -54,17 +53,29 @@ int _sysctl_proc(int what, int flag, struct kinfo_proc* out, unsigned long* bufl
 	if (*buflen > 0 && out == NULL)
 		return -EFAULT;
 
-	fd = sys_open_nocancel("/proc", BSD_O_RDONLY | BSD_O_DIRECTORY, 0);
+	/*
+	 * Parse the procfs this process actually has, not the one a guest path resolves to.
+	 * darlingserver mounts a procfs only for its non-rootless PID namespace
+	 * (darlingserver.cpp: the `if (!rootless)` mount), so on a rootless prefix the
+	 * vchroot-resolved path "/proc" does not exist and every KERN_PROC query failed with
+	 * ENOENT -- MEASURED on a rootless prefix: opendir("/proc") and
+	 * sysctl(KERN_PROC_PID, getpid()) both returned errno=ENOENT. Raw Linux syscalls read
+	 * the process's OWN mount namespace, which is the procfs whose entries carry the
+	 * caller's pid in rootless mode (no PID namespace, so getpid() is the host pid) and the
+	 * namespace pid in rootfull mode. sigexc.c and lkm.c already reach a /proc/self path
+	 * this way; this is the same route for the process table.
+	 */
+	fd = LINUX_SYSCALL4(__NR_openat, LINUX_AT_FDCWD, "/proc", LINUX_O_RDONLY | LINUX_O_DIRECTORY, 0);
 	if (fd < 0)
 		return fd;
 
-	while ((ret = sys_getdirentries(fd, (char*) dents, sizeof(dents), &basep)) > 0)
+	while ((ret = LINUX_SYSCALL3(__NR_getdents64, fd, dents, sizeof(dents))) > 0)
 	{
 		int pos = 0;
 		
 		while (pos < ret)
 		{
-			struct bsd_dirent* dent = (struct bsd_dirent*) &dents[pos];
+			struct linux_dirent64* dent = (struct linux_dirent64*) &dents[pos];
 			struct kinfo_proc_chain* cur;
 			// __simple_printf("Looking at %s\n", dent->d_name);
 
@@ -129,11 +140,14 @@ bool read_string(const char* path, char* dst, int maxlen)
 {
 	int fd, rd;
 
-	fd = sys_open(path, BSD_O_RDONLY, 0);
+	/* Same reason as in _sysctl_proc: read the caller's OWN procfs rather than the guest
+	 * path. Every caller passes a /proc path, and a rootless guest has no procfs at the
+	 * vchroot spelling. */
+	fd = LINUX_SYSCALL4(__NR_openat, LINUX_AT_FDCWD, path, LINUX_O_RDONLY, 0);
 	if (fd < 0)
 		return false;
 
-	rd = sys_read(fd, dst, maxlen-1);
+	rd = LINUX_SYSCALL3(__NR_read, fd, dst, maxlen-1);
 	if (rd >= 0)
 		dst[rd] = '\0';
 
-- 
2.43.0

