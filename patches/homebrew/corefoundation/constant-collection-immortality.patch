From 4d7086d8df2e3b017e0e7284831b424f42e68c36 Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 13 Oct 2026 11:25:28 +0000
Subject: [PATCH] CoreFoundation: the constant collections are immortal, so
 releasing a singleton is a no-op

MEASURED (guest oracle tests/empty_collection_singleton_release_guest.c, RED on
the runtime before this commit): _objc_release(__NSArray0__) -- exactly the call
Xcode3Core's -[Xcode3CommandLineBuildTool _resolvePackageDependenciesAndExit]
block makes (return address Xcode3Core+0x3af97, _objc_release at libobjc+0x6a00)
-- aborted with

  malloc: *** error for object 0x74558da824b8: pointer being freed was not allocated

because NSConstantArray implemented none of retain/release/autorelease/
retainCount: objc4 marks such a class "default RR", so the runtime decremented
the isa's retain count to zero, sent -dealloc and freed the singleton's static
storage with the guest's free().  The same release of an NSConstantArray in a
client image's own static data -- the shape a compiler-emitted literal has --
fails the same way, and the empty dictionary's singleton is worse: its class is
the cluster's __NSCFDictionary, whose -release routes to CFRelease, which
re-dispatches -release for an object that is not a CF object (measured: SIGSEGV).

The empty collections are compile-time constants in static storage and are
immortal on macOS, so a release must not reach -dealloc.  NSConstantArray and
NSConstantDictionary take SINGLETON_RR(), the convention this tree already uses
for objects in static storage (__NSCFConstantString, NSNull, the collection
placeholders), and the empty-dictionary singleton is built with
NSConstantDictionary -- a class of its own, because __NSCFDictionary is shared
with live dictionaries and cannot carry the no-op retain/release.

The guest's own invalid-free report is untouched: the same oracle's control
(free(p) twice) still dies with "pointer being freed was not allocated".
Bead: dar-liaq
---
 CFRuntime.c    | 28 ++++++++++++++++++++++------
 NSArray.m      | 24 +++++++++++++++++++++++-
 NSDictionary.m | 11 +++++++++++
 3 files changed, 56 insertions(+), 7 deletions(-)

diff --git a/CFRuntime.c b/CFRuntime.c
index d5b8d29..333ada2 100644
--- a/CFRuntime.c
+++ b/CFRuntime.c
@@ -1232,21 +1232,32 @@ void __CFInitialize(void) {
 
         __CFProphylacticAutofsAccess = false;
 
-        Class clsDict, clsArray, clsConstantArray, arrayClass;
+        Class clsDict, clsArray, clsConstantArray, clsConstantDict, arrayClass, dictClass;
         SEL selAlloc, selInit;
         id dynDict, dynArray;
         clsDict = objc_lookUpClass("NSDictionary");
         clsArray = objc_lookUpClass("NSArray");
         clsConstantArray = objc_lookUpClass("NSConstantArray");
+        clsConstantDict = objc_lookUpClass("NSConstantDictionary");
         selAlloc = sel_registerName("alloc");
         selInit = sel_registerName("init");
         /* The singletons live in static storage: __NSArray0__struct and
          * __NSDictionary0__struct must BE the objects, because clients
          * reference them by address (see the comment at their definition).
-         * The empty ARRAY is an NSConstantArray, as in Apple's CoreFoundation,
-         * where that constant-collection class owns the singleton; the empty
-         * dictionary keeps the class its cluster hands back.  The dynamic
-         * instance is created only to learn that class. */
+         * Both are CONSTANT-collection instances, as in Apple's CoreFoundation,
+         * where those classes own the empty-collection singletons -- and that
+         * is load-bearing, not cosmetic: the constant classes are the immortal
+         * ones (SINGLETON_RR in NSArray.m/NSDictionary.m), and a release of a
+         * singleton must be a no-op.  MEASURED with the array singleton on the
+         * class its cluster hands back: _objc_release found no custom RR,
+         * reached retain count zero and freed the singleton's static storage
+         * (libmalloc's "pointer being freed was not allocated" abort inside
+         * Xcode3Core's package-resolution block).  The dictionary's cluster
+         * class cannot be made immortal the same way -- __NSCFDictionary is
+         * shared with live dictionaries, and its own retain/release route to
+         * CFRetain/CFRelease -- so the singleton takes the constant class.
+         * The dynamic instances are created only as the fallback for a tree in
+         * which a constant class is missing. */
         dynDict = objc_msgSend(objc_msgSend(clsDict, selAlloc), selInit);
         if (clsConstantArray != Nil) {
             arrayClass = clsConstantArray;
@@ -1254,7 +1265,12 @@ void __CFInitialize(void) {
             dynArray = objc_msgSend(objc_msgSend(clsArray, selAlloc), selInit);
             arrayClass = object_getClass(dynArray);
         }
-        __NSDictionary0__ = __CFSingletonInStaticStorage(object_getClass(dynDict), &__NSDictionary0__struct, sizeof(__NSDictionary0__struct), "__NSDictionary0__struct");
+        if (clsConstantDict != Nil) {
+            dictClass = clsConstantDict;
+        } else {
+            dictClass = object_getClass(dynDict);
+        }
+        __NSDictionary0__ = __CFSingletonInStaticStorage(dictClass, &__NSDictionary0__struct, sizeof(__NSDictionary0__struct), "__NSDictionary0__struct");
         __NSArray0__ = __CFSingletonInStaticStorage(arrayClass, &__NSArray0__struct, sizeof(__NSArray0__struct), "__NSArray0__struct");
 
         __CFInitializing = 0;
diff --git a/NSArray.m b/NSArray.m
index 6195ca2..e70c1fa 100644
--- a/NSArray.m
+++ b/NSArray.m
@@ -2222,7 +2222,29 @@ SINGLETON_RR()
 /* A constant array holds _count ids at _objects; the ids are compile-time
  * constants, so they are neither retained nor released here.  The empty-array
  * singleton (__NSArray0__struct, built in CFRuntime.c) is one of these with
- * _count == 0 and _objects == NULL. */
+ * _count == 0 and _objects == NULL.
+ *
+ * IMMORTAL, because its instances live in STATIC storage: the empty-array
+ * singleton in CoreFoundation's __DATA and every compiler-emitted literal in
+ * its client's __DATA.  MEASURED without the RR methods below: the Xcode ladder
+ * (scripts/xcodebuild-workload-run.sh, both workloads) dies in Xcode3Core's
+ * -[Xcode3CommandLineBuildTool _resolvePackageDependenciesAndExit] block, which
+ * calls _objc_release (libobjc + 0x6a00) on the singleton; a class that
+ * implements none of retain/release/autorelease/retainCount is "default RR" to
+ * objc4, so the runtime decremented the isa's retain count to zero, sent
+ * -dealloc and freed the storage with the guest's free():
+ *
+ *   #3 free + 0x25d   #4 Xcode3Core + 0x3af97 (after `callq *%r15`, r15 = _objc_release)
+ *   xcodebuild(...) malloc: *** error for object 0x7b65ca1d84b8: pointer being freed was not allocated
+ *
+ * where 0x7b65ca1d84b8 is `___NSArray0__struct` itself.  On macOS the empty
+ * collection is an immortal constant collection and the same release is a
+ * no-op, so the release the client is entitled to make must not reach -dealloc
+ * here either.  SINGLETON_RR is the convention this tree already uses for
+ * objects in static storage (__NSCFConstantString, NSNull, the collection
+ * placeholders). */
+
+SINGLETON_RR()
 
 - (NSUInteger)count
 {
diff --git a/NSDictionary.m b/NSDictionary.m
index 9182e60..2f6b1a1 100644
--- a/NSDictionary.m
+++ b/NSDictionary.m
@@ -1549,6 +1549,17 @@ static NSString *_getDescription(id obj, id locale, int level)
 
 @implementation NSConstantDictionary
 
+/* IMMORTAL, for the same measured reason as NSConstantArray: the instances are
+ * compile-time constants in static storage (the empty-dictionary singleton
+ * __NSDictionary0__struct in CoreFoundation's __DATA, and every compiler-emitted
+ * literal in its client's __DATA), so a release must be a no-op and must never
+ * reach -dealloc -- which would free storage the allocator never handed out.
+ * A class that implements none of the retain/release family is "default RR" to
+ * objc4, and its release then frees the object in the runtime.  See the comment
+ * at NSConstantArray for the measured abort. */
+
+SINGLETON_RR()
+
 - (NSUInteger)count
 {
     return _count;
-- 
2.43.0

