From 429d7b282b1e035d1965ac4d2f6909eb22c4e959 Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 13 Oct 2026 11:58:43 +0000
Subject: [PATCH] CoreFoundation: +[NSCharacterSet URLPathAllowedCharacterSet],
 measured from the tree's own URL parser

MEASURED (guest oracle tests/url_path_allowed_character_set_guest.c, RED on the
runtime before this commit, deployed CoreFoundation 4afd5fdb): sending the
accessor aborts the process with

  Uncaught Exception: +[NSCharacterSet URLPathAllowedCharacterSet]: unrecognized selector sent to instance 0x7bd992a20360
  libc++abi: terminating with uncaught exception of type NSException
  [sigexc-fatal sig=4 code=2 ...]        URLPATH_RUN_RC=132

and that is the Xcode ladder's wall: scripts/xcodebuild-workload-run.sh on
prefix-verify14 dies in both workloads with XCB_RC=134 and, before this, the
guest log's last real line was that exception.

WHY THE SELECTOR WAS ABSENT. NSCharacterSet in this tree is CoreFoundation's
class (NSCharacterSet.m, re-exported by Foundation), and it implemented only the
CFCharacterSet predefined sets: the URL component sets were never there, and
they could not be reached through the CF route either, because the deployed
CoreFoundation defines no _CFURLComponentsGetURL*AllowedCharacterSet at all
(CFURLComponents_URIParser.c lives in the swift-corelibs-foundation submodule
and is not part of this CF's build). So this adds the accessor the way the
neighbouring predefined accessors in this file are written: a CFCharacterSet
from the tree, returned as the NSCharacterSet object, cached for the process.

THE MEMBERSHIP IS THE TREE'S OWN. Apple's Foundation declares the set as
NSCharacterSet(NSURLUtilities) URLPathAllowedCharacterSet but does not publish
its contents; this tree does, in the swift-corelibs-foundation submodule's
CoreFoundation/URL.subproj/CFURLComponents_URIParser.c, kURLPathAllowedCharacters:

  "!$&'()*+,-./0123456789:=@ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz~"

(unreserved marks, '/' as the segment separator, ':' and '@' which that parser
special-cases, and ';' deliberately absent for rfc1808 compatibility), built with
CFCharacterSetCreateWithCharactersInString so the object is immutable and cached
with dispatch_once so the accessor is shared.

MEASURED GREEN on the same oracle and prefix after this lands (deployed
CoreFoundation sha256 given in the workspace patch entry):

  URLPATH-SET non-nil=1 shared-identity=1 class=__NSCFCharacterSet ... mutable-control-added-space=1 immutable-after-add-space=0
  URLPATH-MEMBER '/' 0x2f member=1 expected=1 ... URLPATH-MEMBER '#' 0x23 member=0 expected=0
  URLPATH_VERDICT=GREEN

The oracle also reports, as a NOTE and not a failure, that
-[NSString stringByAddingPercentEncodingWithAllowedCharacters:] is still
unimplemented in this runtime; that is a separate API and out of this commit's
scope.
---
 NSCharacterSet.m | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/NSCharacterSet.m b/NSCharacterSet.m
index 4e77084..1c0b9d9 100644
--- a/NSCharacterSet.m
+++ b/NSCharacterSet.m
@@ -95,6 +95,32 @@ CF_PRIVATE
     return (id)CFCharacterSetGetPredefined(kCFCharacterSetNewline);
 }
 
+/*
+ * +[NSCharacterSet URLPathAllowedCharacterSet] -- Apple's NSCharacterSet(NSURLUtilities)
+ * predefined set for a URL's path component (Foundation.framework/Headers/NSURL.h, available
+ * macOS 10.9+). This tree never carried the URL component sets: no sibling accessor exists in
+ * this file and nothing in the deployed CoreFoundation defines _CFURLComponentsGetURL*AllowedCharacterSet
+ * (CFURLComponents_URIParser.c from the swift-corelibs-foundation submodule is not in the CF build).
+ * The membership is therefore taken from that submodule's own
+ * CoreFoundation/URL.subproj/CFURLComponents_URIParser.c, kURLPathAllowedCharacters:
+ * "!$&'()*+,-./0123456789:=@ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz~"
+ * (unreserved marks, "/" as the segment separator, ":" and "@" which the parser special-cases,
+ * and ";" deliberately absent for rfc1808 compatibility), so this is the same set Apple's
+ * CFURLComponents hands out. Apple's accessor answers a shared, immutable set; the CF object is
+ * immutable once created and is cached for the process, so the contract holds.
+ */
++ (id)URLPathAllowedCharacterSet
+{
+    static dispatch_once_t once = 0L;
+    static NSCharacterSet *set = nil;
+    dispatch_once(&once, ^{
+        set = (NSCharacterSet *)CFCharacterSetCreateWithCharactersInString(
+            kCFAllocatorDefault,
+            CFSTR("!$&'()*+,-./0123456789:=@ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz~"));
+    });
+    return set;
+}
+
 + (id)characterSetWithRange:(NSRange)range
 {
     return [(NSCharacterSet *)CFCharacterSetCreateWithCharactersInRange(kCFAllocatorDefault, CFRangeMake(range.location, range.length)) autorelease];
-- 
2.43.0

