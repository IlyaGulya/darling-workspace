From 1422236fb030234ed9ec52216da04087cac9de84 Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Sun, 6 Sep 2026 09:41:52 +0000
Subject: [PATCH] Anchor rootless client socket paths in the server process

---
 src/darlingserver.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/darlingserver.cpp b/src/darlingserver.cpp
index 1f34dc3837722a250a64792ba387dd254396868e..9bf771442a76e21638f9eee33f838a26ec1655f3 100644
--- a/src/darlingserver.cpp
+++ b/src/darlingserver.cpp
@@ -504,7 +504,15 @@ void spawnLaunchd(
 
 	// putenv("KQUEUE_DEBUG=1");
 
-	auto tmp = (std::string(prefix) + "/.darlingserver.sock");
+	char socketAnchor[64];
+	const char* socketPrefix = prefix;
+	if (DarlingServer::runtimeModeIsRootless(runtimeMode)) {
+		// The parent server owns this anchor; guest exec must not need to retain it.
+		snprintf(socketAnchor, sizeof(socketAnchor), "/proc/%d/fd/%d",
+			getppid(), prefixFD);
+		socketPrefix = socketAnchor;
+	}
+	auto tmp = (std::string(socketPrefix) + "/.darlingserver.sock");
 
 	const char* initPath = getenv("DSERVER_INIT");
 
