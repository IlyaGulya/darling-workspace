 		if (dfd >= 0)
@@ -1650,27 +1735,38 @@ int vchroot_readdir_merge(const char* guest, char* out, int cap)
 					char child[4096];
 					int hl = (int)strlen(up), nl = (int)strlen(nm);
 					if (hl + 1 + nl + 1 > (int)sizeof(child))
-						continue;
