 						continue;
-					eunion_emit_name(out, cap, &used, &count, nm);
+					result = eunion_emit_name(visible, nm);
+					if (result < 0)
+						goto lower_done;
 				}
 			}
+			result = len;
+lower_done:
 			LINUX_SYSCALL(__NR_close, dfd);
+			if (result < 0)
