-// Produce the merged directory listing for guest dir `guest` as a NUL-separated
-// list of names in `out`. Upper layer wins on name clash; whiteouts hide the
-// lower namesake; an opaque upper dir is not merged with the lower. Returns the
-// number of names, or a negative Linux errno.
-int vchroot_readdir_merge(const char* guest, char* out, int cap)
+// Append without truncation: bounded buffers fail explicitly, owned buffers
+// grow geometrically. A failed allocation leaves the previous buffer intact.
+static int eunion_emit_name(struct eunion_name_buffer* buffer, const char* name)
+{
+	if (name_in_set(buffer, name))
+		return 0;
+	size_t nlen = strlen(name) + 1;
+	if (buffer->count == __INT_MAX__ || buffer->used > (size_t)-1 - nlen)
+		return -LINUX_EOVERFLOW;
+	size_t required = buffer->used + nlen;
+	if (required > buffer->capacity)
+	{
+		int result = eunion_name_buffer_grow(buffer, required);
+		if (result < 0)
+			return result;
+	}
+	memcpy(buffer->data + buffer->used, name, nlen);
+	buffer->used = required;
+	buffer->count++;
+	return 1;
+}
+
+// Upper wins on name clash; physical whiteouts hide the lower namesake;
+// an opaque upper directory is not merged with the lower.
