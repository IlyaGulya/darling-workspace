-// helper: append `name` to a NUL-separated out buffer if it fits and is not a
-// duplicate of an already-appended name. Returns 1 if appended, 0 if dup, <0 on
-// overflow.
-static int eunion_emit_name(char* out, int cap, int* used, int* count, const char* name)
+// Growable name storage uses private mappings, not a guest allocator: fork
+// inherits valid COW storage without depending on allocator or atfork locks.
+// Keep the mapping length with the allocation, immutable after publication.
+struct eunion_name_storage
+{
+	size_t length;
+	char data[];
+};
+
+struct eunion_name_buffer
+{
+	char* data;
+	size_t capacity;
+	size_t used;
+	int count;
+	int growable;
+};
+
+static void eunion_name_storage_release(char* data)
 {
-	// dedup against already-emitted names
-	const char* p = out;
-	for (int i = 0; i < *count; i++)
+	if (!data)
+		return;
+	struct eunion_name_storage* storage = (struct eunion_name_storage*)
+		(data - __builtin_offsetof(struct eunion_name_storage, data));
+	LINUX_SYSCALL(__NR_munmap, storage, storage->length);
+}
+
+static void eunion_name_buffer_release(struct eunion_name_buffer* buffer)
+{
+	char* data = buffer->growable ? buffer->data : 0;
+	// Detach before unmapping so fork cannot inherit an unmapped owner.
+	buffer->data = 0;
+	buffer->capacity = buffer->used = 0;
+	buffer->count = 0;
+	eunion_name_storage_release(data);
+}
+
+static int eunion_name_buffer_grow(struct eunion_name_buffer* buffer, size_t required)
+{
+	if (!buffer->growable)
+		return -LINUX_EOVERFLOW;
+	size_t maximum = (size_t)-1 - sizeof(struct eunion_name_storage);
+	if (required > maximum)
+		return -LINUX_EOVERFLOW;
+	size_t capacity = buffer->capacity ? buffer->capacity : 4096;
+	while (capacity < required)
 	{
-		if (strcmp(p, name) == 0)
-			return 0;
-		p += strlen(p) + 1;
+		if (capacity > maximum / 2)
+		{
+			capacity = required;
+			break;
+		}
+		capacity *= 2;
 	}
-	int nlen = (int)strlen(name) + 1;
-	if (*used + nlen > cap)
-		return -LINUX_ENAMETOOLONG;
-	memcpy(out + *used, name, nlen);
-	*used += nlen;
-	(*count)++;
-	return 1;
+	size_t length = sizeof(struct eunion_name_storage) + capacity;
+	struct eunion_name_storage* storage;
+#ifdef TEST
+	// The TEST LINUX_SYSCALL wrapper returns int, which cannot hold a pointer.
+	storage = mmap(0, length, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (storage == MAP_FAILED)
+		return -errno;
+#else
+#ifdef __NR_mmap2
+	const int mmap_call = __NR_mmap2;
+#else
+	const int mmap_call = __NR_mmap;
+#endif
+	storage = (void*)LINUX_SYSCALL(mmap_call, 0, length,
+		LINUX_PROT_READ | LINUX_PROT_WRITE,
+		LINUX_MAP_PRIVATE | LINUX_MAP_ANONYMOUS, -1, 0);
+	if ((unsigned long)storage > (unsigned long)-4096)
+		return (int)(long)storage;
+#endif
+	storage->length = length;
+	if (buffer->used)
+		memcpy(storage->data, buffer->data, buffer->used);
+	char* previous = buffer->data;
+	buffer->data = storage->data;
+	buffer->capacity = capacity;
+	eunion_name_storage_release(previous);
+	return 0;
 }
 
