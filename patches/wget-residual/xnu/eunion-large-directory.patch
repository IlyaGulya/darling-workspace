+}
+
+// Bounded API: no successful partial listing on capacity exhaustion.
+int vchroot_readdir_merge(const char* guest, char* out, int cap)
+{
+	if (!out || cap <= 0)
+		return -LINUX_EINVAL;
+	struct eunion_name_buffer visible = { .data = out, .capacity = (size_t)cap };
+	struct eunion_name_buffer hidden = { .growable = 1 };
+	int result = eunion_readdir_merge(guest, &visible, &hidden);
+	eunion_name_buffer_release(&hidden);
+	return result;
 }
 
 // -------- E-UNION paged getdents merge (per-fd state) --------------------
@@ -1705,26 +1821,26 @@ int vchroot_readdir_merge(const char* guest, char* out, int cap)
 // tracks the offset for the UPPER fd only. To present a MERGED view (upper wins,
 // lower merged in, whiteouts subtracted, opaque honoured) across an arbitrary
 // number of pages WITHOUT the getdents64 rewind hazards, we materialize the full
-// merged name list ONCE per open dir fd (reusing the proven vchroot_readdir_merge
-// enumeration) into a small per-fd buffer, then hand it back page by page. The
+// merged name list ONCE per open dir fd into a growable owned snapshot, then
+// hand it back page by page. The
 // emulation site calls:
 //   vchroot_getdents_merge(fd, out, cap)  instead of raw getdents64(fd, ...)
 //   vchroot_dir_closed(fd)                from close()/closedir() teardown
 // rewinddir (lseek(fd,0)) is detected by the emulation, which calls
 // vchroot_dir_closed(fd) so the next getdents re-materializes from the start.
+// This remains an unsynchronized per-fd cache, not an OFD cursor:
+// dup/fork copy the current position rather than sharing it. Concurrent
+// enumeration/close/rewind/dup remain separate architecture limitations.
 
 #define EUNION_MAXDIRS  256
-#define EUNION_NAMEBUF  65536  // per-dir merged name list (NUL-separated)
 
 struct eunion_dir_state
 {
 	int  fd;                    // upper fd this state tracks (-1 = free slot)
-	int  ready;                 // names[] materialized?
-	int  count;                 // number of names
-	int  cursor;                // byte offset of the next name to emit
-	int  used;                  // bytes used in names[]
+	int  ready;                 // snapshot materialized?
+	size_t cursor;              // byte offset of the next name to emit
 	char guest[4096];           // guest dir path (for per-entry d_type/d_ino lstat)
-	char names[EUNION_NAMEBUF]; // NUL-separated merged listing
+	struct eunion_name_buffer names; // uniquely owned NUL-separated snapshot
 };
 
 static struct eunion_dir_state eunion_dirs[EUNION_MAXDIRS];
@@ -1755,8 +1871,10 @@ void vchroot_dir_closed(int fd)
 	struct eunion_dir_state* s = eunion_dir_find(fd);
 	if (!s)
 		return;
-	s->fd = -1;
 	s->ready = 0;
+	eunion_name_buffer_release(&s->names);
+	s->cursor = 0;
+	s->fd = -1;
 }
 
 void vchroot_dir_rewind(int fd)
@@ -1774,26 +1892,50 @@ static struct eunion_dir_state* eunion_dir_alloc(int fd)
 	}
 	if (!s)
 		return 0; // caller reports explicit capacity exhaustion
-	s->fd = fd;
 	s->ready = 0;
-	s->count = s->cursor = s->used = 0;
+	eunion_name_buffer_release(&s->names);
+	s->names.growable = 1;
+	s->cursor = 0;
+	s->fd = fd;
 	return s;
 }
 
 int vchroot_dir_dup(int oldfd, int newfd)
 {
+	if (oldfd == newfd)
+		return 0;
 	struct eunion_dir_state* source = eunion_dir_find(oldfd);
-	struct eunion_dir_state* target;
-
 	if (!source)
+	{
+		vchroot_dir_closed(newfd);
 		return 0;
-	target = eunion_dir_find(newfd);
-	if (!target)
-		target = eunion_dir_alloc(newfd);
+	}
+
+	// Clone before changing the target: allocation failure leaves both
+	// existing states intact and never publishes a shared owning pointer.
+	struct eunion_name_buffer names = { .growable = 1 };
+	if (source->ready && source->names.used)
+	{
+		int result = eunion_name_buffer_grow(&names, source->names.used);
+		if (result < 0)
+			return result;
+		memcpy(names.data, source->names.data, source->names.used);
+		names.used = source->names.used;
+		names.count = source->names.count;
+	}
+	struct eunion_dir_state* target = eunion_dir_alloc(newfd);
 	if (!target)
+	{
+		eunion_name_buffer_release(&names);
 		return -LINUX_EMFILE;
-	memcpy(target, source, sizeof(*target));
-	target->fd = newfd;
+	}
+	if (source->ready)
+	{
+		memcpy(target->guest, source->guest, strlen(source->guest) + 1);
+		target->cursor = source->cursor;
+		target->names = names; // move: the local buffer is no longer released
+		target->ready = 1;
+	}
 	return 0;
 }
 
