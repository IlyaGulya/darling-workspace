From b0c7888e903fb44266baffa92ec9cb5391fe9019 Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 8 Sep 2026 18:07:34 +0000
Subject: [PATCH] Preserve interrupted masks and BSD flags in signal handlers

---
 .../emulation/src/linux_premigration/signal/sigexc.c      | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/darling/src/libsystem_kernel/emulation/src/linux_premigration/signal/sigexc.c b/darling/src/libsystem_kernel/emulation/src/linux_premigration/signal/sigexc.c
index 206e92e4623b15ec9b156a15ba73618d0d669e66..e73232149b7c8218560b1486c3a97427e9222bb8 100644
--- a/darling/src/libsystem_kernel/emulation/src/linux_premigration/signal/sigexc.c
+++ b/darling/src/libsystem_kernel/emulation/src/linux_premigration/signal/sigexc.c
@@ -325,11 +325,13 @@ void sigexc_handler(int linux_signum, struct linux_siginfo* info, struct linux_u
 		{
 			kern_printf("sigexc: will forward signal to app handler (%p)\n", sig_handlers[linux_signum]);
 
-			// Update the signal mask to what the application actually wanted
-			linux_sigset_t set = sig_masks[linux_signum];
+			// Preserve the interrupted mask and add the translated application mask.
+			linux_sigset_t set;
+			sigset_bsd_to_linux(&sig_masks[linux_signum], &set);
+			set |= ctxt->uc_sigmask;
 
 			// Keep the current signal blocked, which is the default behavior
-			if (!(sig_flags[linux_signum] & LINUX_SA_NODEFER))
+			if (!(sig_flags[linux_signum] & BSD_SA_NODEFER))
 				set |= (1ull << (linux_signum-1));
 
 			LINUX_SYSCALL(__NR_rt_sigprocmask, 2 /* LINUX_SIG_SETMASK */,
