From 8a2b2f11325cd647495a03fa309d0851fc48fd2f Mon Sep 17 00:00:00 2001
From: Ilya Gulya <ilya@gulya.me>
Date: Tue, 8 Sep 2026 17:06:14 +0000
Subject: [PATCH] Discard pending signals when installing SIG_IGN

---
 .../xnu_syscall/bsd/impl/signal/sigaction.c   | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/signal/sigaction.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/signal/sigaction.c
index 4b6d175a9e285f1bd2f28c5931b3d20b61834b28..bdc75b30355e5633e7f179cfc88d9e7ba0d6a03b 100644
--- a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/signal/sigaction.c
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/signal/sigaction.c
@@ -91,6 +91,26 @@ long sys_sigaction(int signum, const struct bsd___sigaction* nsa, struct bsd_sig
 			osa->sa_flags = sig_flags[linux_signum];
 			osa->sa_mask = sig_masks[linux_signum];
 		}
+
+		if (nsa != NULL && linux_signum != LINUX_SIGKILL && linux_signum != LINUX_SIGSTOP
+				&& (nsa->sa_sigaction == XNU_SIG_IGN || sig_handlers[linux_signum] == XNU_SIG_IGN))
+		{
+			// Ignoring only in sigexc_handler leaves blocked signals pending.
+			// Let Linux discard them, retaining the internal mask, flags and restorer.
+			ret = LINUX_SYSCALL(__NR_rt_sigaction, linux_signum, NULL, &sa,
+				sizeof(sa.sa_mask));
+			if (ret < 0)
+				return errno_linux_to_bsd(ret);
+
+			// Both a user handler and SIG_DFL must return through sigexc when
+			// leaving ignore, rather than keeping Linux's SIG_IGN disposition.
+			sa.sa_sigaction = nsa->sa_sigaction == XNU_SIG_IGN
+				? (linux_sig_handler*) XNU_SIG_IGN : (linux_sig_handler*) sigexc_handler;
+			ret = LINUX_SYSCALL(__NR_rt_sigaction, linux_signum, &sa, NULL,
+				sizeof(sa.sa_mask));
+			if (ret < 0)
+				return errno_linux_to_bsd(ret);
+		}
 	}
 	
 	if (nsa != NULL && ret >= 0)
