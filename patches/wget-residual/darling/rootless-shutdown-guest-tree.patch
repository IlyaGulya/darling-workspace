--- a/src/startup/rootless_shutdown.c
+++ b/src/startup/rootless_shutdown.c
@@ -2,83 +2,227 @@
 
 #include <dirent.h>
 #include <errno.h>
+#include <limits.h>
+#include <poll.h>
