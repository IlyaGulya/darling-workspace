+			page->urgent_payload[u][1] = p1;
+			page->urgent_payload[u][2] = p2;
+			page->urgent_payload[u][3] = p3;
+			__atomic_store_n(&page->urgent_state[u], DSERVER_PROCESS_CONTROL_URGENT_PENDING, __ATOMIC_RELEASE);
