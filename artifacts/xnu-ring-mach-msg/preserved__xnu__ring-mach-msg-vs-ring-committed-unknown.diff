+			int db = __dserver_ring_doorbell(-1);
+			if (db >= 0) {
+				uint64_t one = 1;
+				(void)LINUX_SYSCALL3(__NR_write, db, &one, sizeof(one));
+			}
+			return 0;
+		}
+	}
+	return -1;   // pool full: the caller falls back
